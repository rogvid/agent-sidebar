#!/usr/bin/env -S uv run --script
# vim: set ft=python:
# -*- mode: python -*-
# language: python
# /// script
# requires-python = ">=3.13"
# dependencies = [
#   "psutil==7.2.2",
# ]
# ///
"""agent-scan - report agentic coding sessions running in tmux.

One row per pane that has an agent in its process tree, so a session with
several agents in several panes lists all of them.

State comes from what the pane is currently rendering. Reading the screen
means the state can never go stale the way an event-driven cache does:
whatever the pane shows is what the row says. The states are named for what
it costs you to ignore the row, not for the widget that is on screen:

  blocked      stopped mid-task on a dialog; the task stays frozen
  interrupted  you stopped it and it is asking what to do instead
  done         turn finished and waiting on you; nothing is frozen
  running      working; needs nothing
  delegated    parked until the agents it spawned report back; needs nothing

Rows sort in that order, and inside a state the freshest clock first: the
pane that handed its turn back a minute ago sits above the one that
finished an hour ago, and a pane whose clock the screen does not record
sinks to the bottom of its state. Read top-down, the list is a queue.

Usage: agent-scan [scan] [--no-color | --json | --tmux]

Output columns: project, branch, session:window.pane, a warning flag,
state, agent, context, how long the pane has been in its current state,
the 5h usage block, session age, and the last thing the pane said.

The project is the repository the pane is working in, so every worktree of
a project reads as that project. The branch is what it has checked out:
`@<sha>` for a detached HEAD, `no git` outside a repository. Long project
and branch names are cut short. The target never is, because the
television channel finds the pane by pulling the first
`session:window.pane` out of the row, so session names containing spaces
are not supported there.

The warning flag marks a pane sharing a working directory with another
agent pane: two agents editing one tree overwrite each other silently.

--json prints the same rows, in the same order, as a JSON list of objects
for tools that lay them out themselves (agent-sidebar). Nothing is cut
short there, and each row also carries the pane's tmux id, its working
directory, and how far into context rot it is (`context_level`: ok, warn,
rot, or unknown).

--tmux prints one coloured count per state in tmux's own style syntax, for
the status bar, and nothing at all when no agent is running.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from collections import Counter
from dataclasses import asdict, dataclass, replace
from pathlib import Path

import psutil

AGENT_NAMES = frozenset({"claude", "codex", "opencode", "pi"})

RESET = "\033[0m"
BLUE, YELLOW, GREEN, RED, MAGENTA, CYAN = (
    "\033[34m", "\033[33m", "\033[32m", "\033[31m", "\033[35m", "\033[36m",
)
# Secondary text is a concrete grey rather than the dim attribute. Dim
# multiplies against whatever background it lands on, and television paints
# the selected row on colour 8, which left the dimmed columns unreadable at
# exactly the moment you were looking at them.
MUTED = "\033[38;5;250m"
STATE_COLOR = {
    "blocked": YELLOW,
    "interrupted": MAGENTA,
    "running": BLUE,
    "delegated": CYAN,
    "done": GREEN,
}
# Most-needed first, which is what puts `done` above the two states that
# are still moving: a finished turn is idle until you read it and say
# something, while a running or delegated pane is asking for nothing.
STATE_ORDER = {
    "blocked": 0, "interrupted": 1, "done": 2, "running": 3, "delegated": 4,
}

# Context rot: the further past these a session is, the less its earlier
# turns are really informing the current one. Thresholds are absolute
# tokens, not a fraction of the model's window, because rot is a property
# of how much has been said, not of how much room is left.
CTX_WARN, CTX_ROT = 100_000, 400_000

# How much of the pane bottom counts as live UI. Claude's footer block is
# roughly 8 lines (input box borders, statusline, hints), and the spinner
# sits just above it, so 16 covers the whole live region while keeping
# transcript text - which can quote any of these patterns - out of scope.
TAIL_LINES = 16
# The statusline is inside the footer block itself.
FOOTER_LINES = 8
# Approval dialogs are bottom-anchored: claude's option list sits within
# ~5 lines of the bottom, opencode's button row within 2. A tight window
# keeps quoted dialogs further up the transcript out of scope.
DIALOG_LINES = 8

# claude's bare spinner line - `✶ Topsy-turvying…`, a glyph and one gerund -
# is on screen ~0.2s after a turn starts, while its parenthetical (`… (13s ·
# ↓ 129 tokens)`) takes another ~1.5s. It is drawn at column 0; a transcript
# quoting one is always indented, which is what the leading-space limit
# rules out. The verb has to be matched as a unicode word - claude's
# vocabulary includes `Sautéing…` and `Flambéing…`, which an ASCII-only
# class silently reads as idle.
WORD = r"[^\W\d_]"
# The frames the spinner cycles through, both terminal variants of the set:
# `· ✢ ✳ ✶ ✻ ✽` and the `*` the non-ghostty set substitutes. Anchoring on
# the real frames rather than on "some glyph" is what makes it safe to
# accept a message longer than one word, because the shape that would
# otherwise be swallowed is the transcript's own bullet - `● Running 1
# shell command…` - which stays on screen long after the turn ends.
SPINNER_GLYPH = r"[·✢✳✶✻✽*]"
# One gerund is the usual message, but claude also drives this line itself
# while it compacts (`Compacting conversation…`) or runs a compaction hook
# (`Running PostCompact hooks…`), and a pane doing that is not idle.
SPINNER_RE = re.compile(
    rf"^ ?{SPINNER_GLYPH}\s+{WORD}(?:{WORD}|['-])*(?:\s[\w'-]+){{0,3}}…"
)
# opencode's running footer: `   ■■■⬝⬝⬝⬝⬝  esc interrupt   12.1K (9%) …` -
# note `esc interrupt`, no `to`, and the line continues past the hint. Also
# matches a footer that opens with the hint on its own.
INTERRUPT_RE = re.compile(
    r"^\s{0,6}(?:[■⬝▪▫]{2,}\s+)?(?:esc|ctrl\+c)\s+(?:to\s+)?interrupt\b",
    re.IGNORECASE,
)
# claude's approval menu: the selected line `❯ 1. Yes`, boxed or not, plus a
# sibling option line `  2. No` or the dialog's own prose as corroboration -
# a lone `❯ 1. …` is also what a user typing "1. do this" looks like.
CHOICE_RE = re.compile(r"^\s*[│┃|]?\s*❯\s*\d+\.\s")
OPTION_RE = re.compile(r"^\s*[│┃|]?\s*\d+\.\s")
ASK_RE = re.compile(
    r"Do you want|Would you like|Enter to confirm|Esc to cancel",
    re.IGNORECASE,
)
# The key-hint row claude closes every dialog with: `Esc to cancel · Tab to
# amend`, `Enter to select · ↑/↓ to navigate · … · Esc to cancel`. It is
# the one marker that stays at the bottom however tall the dialog grows -
# a question's preview pane pushes its option list out of DIALOG_LINES.
HINT_RE = re.compile(r"^\s{0,2}(?:[^·\s][^·]*·\s+)*Esc to cancel\b")
# opencode's approval dialog: a `△ Permission required` header and a button
# row `┃   Allow once   Allow always   Reject`.
BUTTONS_RE = re.compile(r"Allow once\s{2,}Allow always\s{2,}Reject")
PERMISSION_RE = re.compile(r"^\s*[│┃|]?\s*[^\w\s]\s*Permission required")
# Plain shell-style confirmations, for agents that do not draw a menu.
YESNO_RE = re.compile(r"\[y/n\]|\(y/n\)\s*[?:]?\s*$", re.IGNORECASE | re.MULTILINE)
# The input bar under the prompt box: claude's permission-mode hint and
# statusline, opencode's hint bar. Present while idle or running, hidden
# while a dialog owns the bottom of the screen.
INPUT_BAR_RE = re.compile(r"⏵|⏸|Ctx:|ctrl\+p commands|tab agents")
# From the statusline: claude's `Ctx: 488.7k` or `58% ctx`, opencode's
# `12.0K (9%)`.
CTX_RE = re.compile(
    r"Ctx:\s*([\d.]+[kKmM]?)|(\d+)%\s*ctx|([\d.]+[KkMm])\s*\(\d+%\)"
)
# From the statusline: `Session: 24hr 13m`, `Session: 4m`, `Session: <1m`.
AGE_RE = re.compile(r"Session:\s*(<?\d+\s*(?:hr|h|m|s))(?:\s*(\d+m))?")
# Also from the statusline: `Block: 4hr 22m`. This is the 5h usage window,
# which is an account-wide clock - every session on the same account shows
# the same value - so it says how much runway is left, not anything about
# this pane.
BLOCK_RE = re.compile(r"Block:\s*(<?\d+\s*(?:hr|h|m|s))(?:\s*(\d+m))?")
# claude closes a finished turn with `✻ Cooked for 2m 7s · done 11:16 PM`.
# Same shape as the spinner - glyph at column 0, one gerund - so a quoted
# transcript line, which is always indented, does not match. Sessions on
# claude < 2.1.246 do not render the `· done` suffix at all; there the
# duration is simply unknown.
DONE_RE = re.compile(
    rf"^ ?[^\w\s]\s+{WORD}(?:{WORD}|['-])*\s+for\b[^·]*·\s*done\s+"
    r"(\d{1,2}):(\d{2})(?:\s*([AaPp])\.?[Mm]\.?)?"
)
# The spinner's elapsed parenthetical: `… (2m 55s · ↓ 15.1k tokens)`.
ELAPSED_RE = re.compile(r"…\s*\((?:(\d+)m\s*)?(\d+)s\b")
# What claude leaves behind when you press esc mid-turn. It stays as the
# last transcript line until you answer, which is what makes it a state
# rather than a scrap of history.
INTERRUPTED_RE = re.compile(
    r"^\s*(?:⎿\s*)?Interrupted\b.*(?:What should|do instead)", re.IGNORECASE
)
# What claude prints in place of the turn summary when the turn ends with
# work still out with someone else: `✻ Waiting for 1 background agent to
# finish`, or `✻ Waiting for 2 background agents and 1 dynamic workflow to
# finish`. The session is parked until they report, then picks the task up
# again on its own. Same column-0 glyph shape as the spinner and the
# summary line, so an indented quote of one does not match.
DELEGATED_RE = re.compile(
    r"^ ?[^\w\s]\s+Waiting for\b[^·]*\b(?:agents?|workflows?)\s+to finish\b"
)
# The tray claude draws under its statusline while delegates are in flight:
# `● main` for the session itself, then one row per delegate - `◯
# general-purpose  Re-seeding demo.db  5m 6s · ↓ 141.7k tokens`, its columns
# separated by runs of padding. It is the only place the pane records how
# long the wait has been going.
TRAY_RE = re.compile(r"^\s*[●◯○◌]\s+(\S.*)")
TRAY_ELAPSED_RE = re.compile(r"(?:(\d+)h)?\s*(?:(\d+)m)?\s*(?:(\d+)s)?")
# The input box's own rules. Long enough not to catch `─ Worked for 17m ──`,
# which claude draws as a transcript separator.
BORDER_RE = re.compile(r"^\s*[─═]{10,}")
# opencode names the action it wants approved on its own line: `→ Edit x`.
ARROW_RE = re.compile(r"^\s*[│┃|]?\s*→\s*(\S.*)")
# The line closing a finished turn, with or without the `· done` stamp that
# only claude >= 2.1.246 appends: `✻ Cooked for 2m 7s`. DONE_RE cannot
# stand in for this, because the sessions that lack the stamp are exactly
# the ones whose summary line would otherwise be read as their message.
SUMMARY_RE = re.compile(
    rf"^ ?[^\w\s]\s+{WORD}(?:{WORD}|['-])*\s+for\s+\d"
)
# Lines that are furniture rather than something the agent said. Anything
# matching is skipped when walking back for the pane's last message. The
# second row is opencode's: its status bar, its splash, and its block-art
# wordmark, none of which sit inside a box we could cut away.
CHROME_RE = re.compile(
    r"new task\?|⎿\s+Tip:|Update installed|tmux detected|"
    r"^\s*[❯>]\s*$|^\s*/rc\s*$|^\s*⧉|Total:|Session:|Model:|"
    r"⊙|/status\b|Ask anything|^\s*[│┃|]?\s*[█▀▄]{3,}|"
    r"^\s*[│┃|]\s*Build\s+·|You've used \d+%|Approaching your"
)
# claude's transient limit notices, drawn right-aligned just above the input
# box. Both are account-wide, like the block clock.
WEEKLY_RE = re.compile(r"used\s+(\d+)%\s+of your weekly limit", re.IGNORECASE)
# Weekly headroom. Past the second one you are budgeting, not working.
WEEKLY_WARN, WEEKLY_HIGH = 60, 85

# How much of a message to carry into the row. Long enough to be a sentence,
# short enough that a runaway line cannot bloat the output.
MESSAGE_MAX = 160


# --- tmux ---

@dataclass(frozen=True)
class Pane:
    pane_id: str
    session: str
    window: str
    index: str
    pid: int
    cwd: str

    @property
    def target(self) -> str:
        return f"{self.session}:{self.window}.{self.index}"


def tmux(*args: str) -> str | None:
    try:
        r = subprocess.run(
            ["tmux", *args], capture_output=True, text=True, timeout=2,
            check=False,
        )
    except (subprocess.SubprocessError, OSError):
        return None
    return r.stdout if r.returncode == 0 else None


def list_panes() -> list[Pane]:
    out = tmux(
        "list-panes", "-a", "-F",
        "#{pane_id}\t#{session_name}\t#{window_index}\t#{pane_index}"
        "\t#{pane_pid}\t#{pane_current_path}",
    )
    if not out:
        return []
    panes: list[Pane] = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) != 6:
            continue
        pane_id, session, window, index, pid, cwd = parts
        try:
            panes.append(Pane(pane_id, session, window, index, int(pid), cwd))
        except ValueError:
            continue
    return panes


def capture_pane(pane_id: str) -> str:
    return tmux("capture-pane", "-t", pane_id, "-p") or ""


# --- git ---

# The branch column's word for a pane outside any repository. A detached
# HEAD reads `@<sha>` instead: commits made there belong to no branch.
NO_GIT = "no git"
# Project and branch are for reading, not addressing - the target is what
# television attaches by - so a long one is cut rather than allowed to push
# the state column off the popup. The cut happens when a row is rendered,
# so --json consumers group and cut by the real names.
IDENTITY_MAX = 24


def git(cwd: str, *args: str) -> str | None:
    try:
        r = subprocess.run(
            ["git", "-C", cwd, *args], capture_output=True, text=True,
            timeout=2, check=False,
        )
    except (subprocess.SubprocessError, OSError):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def project_name(common_dir: str) -> str:
    """The repository a git common dir belongs to.

    Every worktree shares its main checkout's common dir, which is what
    makes them all read as one project. `.git`, and the `.bare` of a
    bare-repo-with-worktrees layout, are storage inside the project; a bare
    `koyr.git` is the project itself.
    """
    path = Path(common_dir)
    if path.name.startswith("."):
        return path.parent.name
    return path.name.removesuffix(".git")


def git_identity(cwd: str) -> tuple[str, str]:
    """(project, branch) for a working directory."""
    common = git(
        cwd, "rev-parse", "--path-format=absolute", "--git-common-dir",
    )
    if common is None:
        return Path(cwd).name or cwd, NO_GIT
    project = project_name(common)
    # symbolic-ref rather than rev-parse: it still names the branch of a
    # repository with no commits yet, where HEAD resolves to nothing.
    branch = git(cwd, "symbolic-ref", "--short", "-q", "HEAD")
    if branch:
        return project, branch
    sha = git(cwd, "rev-parse", "--short", "HEAD")
    return project, f"@{sha}" if sha else "@?"


def fit(text: str, limit: int) -> str:
    """text, cut to limit characters with an ellipsis if it is longer."""
    return text if len(text) <= limit else text[:limit - 1] + "…"


def branch_color(branch: str) -> str:
    """Grey for a branch, yellow when there is no branch to name."""
    return YELLOW if branch == NO_GIT or branch.startswith("@") else MUTED


# --- process tree ---

@dataclass(frozen=True)
class Agent:
    name: str
    pid: int
    started_at: float


def process_snapshot() -> tuple[dict[int, tuple[str, float]], dict[int, list[int]]]:
    """One pass over the process table: pid -> (name, start), pid -> children."""
    info: dict[int, tuple[str, float]] = {}
    children: dict[int, list[int]] = {}
    for proc in psutil.process_iter(["pid", "ppid", "name", "create_time"]):
        try:
            d = proc.info
            info[d["pid"]] = (d["name"] or "", d["create_time"] or 0.0)
            children.setdefault(d["ppid"], []).append(d["pid"])
        except psutil.Error:
            continue
    return info, children


def find_agent(
    root_pid: int,
    info: dict[int, tuple[str, float]],
    children: dict[int, list[int]],
) -> Agent | None:
    """Shallowest agent process at or below root_pid, or None."""
    queue = [root_pid]
    seen: set[int] = set()
    while queue:
        pid = queue.pop(0)
        if pid in seen:
            continue
        seen.add(pid)
        entry = info.get(pid)
        if entry is None:
            continue
        name, started_at = entry
        if name in AGENT_NAMES:
            return Agent(name, pid, started_at)
        queue.extend(children.get(pid, ()))
    return None


# --- pane content ---

def visible_lines(content: str) -> list[str]:
    """Pane lines with the trailing blank padding removed."""
    lines = content.splitlines()
    while lines and not lines[-1].strip():
        lines.pop()
    return lines


def split_tray(lines: list[str]) -> tuple[list[str], list[str]]:
    """The pane without its agent tray, and the tray's rows.

    The tray hangs *below* the statusline, which puts it between the footer
    parsers and the lines they count up from: two delegates are enough to
    push `Ctx:` out of the window. Everything under the last input-bar line
    that has a tray row's shape comes off here. Anything unexpected down
    there leaves the pane alone, because a wrong guess costs the statusline.
    """
    bar = -1
    for i, line in enumerate(lines):
        if INPUT_BAR_RE.search(line):
            bar = i
    if bar < 0:
        return lines, []
    tray: list[str] = []
    for line in lines[bar + 1:]:
        if not line.strip() or CHROME_RE.search(line):
            continue
        m = TRAY_RE.match(line)
        if m is None:
            return lines, []
        tray.append(m.group(1))
    return (lines[:bar + 1], tray) if tray else (lines, [])


def tray_delegates(tray: list[str]) -> list[tuple[str, str]]:
    """(what each delegate is doing, its stats) for every row that says.

    The session's own row - `● main` - says neither, so it drops out
    without having to be recognised by name.
    """
    rows: list[tuple[str, str]] = []
    for line in tray:
        parts = re.split(r"\s{2,}", line.strip())
        if len(parts) >= 2:
            rows.append((parts[1], parts[2] if len(parts) > 2 else ""))
    return rows


def waiting_dialog(dialog: list[str]) -> bool:
    """True if an approval dialog owns the bottom of the pane.

    Dialogs are bottom-anchored and hide the agent's input bar, so a marker
    with no input bar below it is a live dialog, while one with the prompt
    box and statusline underneath is a transcript quoting a dialog - which
    the agent sessions in this repo do all the time.
    """
    blob = "\n".join(dialog)
    corroborated = bool(ASK_RE.search(blob)) or any(
        OPTION_RE.match(line) for line in dialog
    )
    last_marker = -1
    for i, line in enumerate(dialog):
        if ((CHOICE_RE.match(line) and corroborated)
                or HINT_RE.match(line)
                or BUTTONS_RE.search(line)
                or PERMISSION_RE.match(line)
                or YESNO_RE.search(line)):
            last_marker = i
    if last_marker < 0:
        return False
    return not any(INPUT_BAR_RE.search(line)
                   for line in dialog[last_marker + 1:])


def transcript_region(lines: list[str]) -> list[str]:
    """Everything above the agent's input box.

    claude draws the box as two full-width rules; the transcript ends at the
    first of them. Agents that draw no box (opencode) fall through to the
    whole pane, and the chrome filter below sorts out their footer.
    """
    borders = [i for i, line in enumerate(lines) if BORDER_RE.match(line)]
    if len(borders) >= 2:
        return lines[:borders[-2]]
    if borders:
        return lines[:borders[-1]]
    return lines


def is_chrome(line: str) -> bool:
    """True for furniture: borders, hints, statuslines, turn summaries."""
    if not line.strip():
        return True
    return bool(
        BORDER_RE.match(line)
        or CHROME_RE.search(line)
        or INPUT_BAR_RE.search(line)
        or SUMMARY_RE.match(line)
        or DELEGATED_RE.match(line)
        or SPINNER_RE.match(line)
        or re.match(r"^\s*[╹┃│]?\s*[▀▄─═]{4,}", line)
    )


def clean(line: str) -> str:
    """Strip an agent's line markers and squeeze the whitespace out."""
    text = re.sub(r"^\s*(?:[●○◉]|⎿|❯|>|│|┃|┃?\s*→)\s*", "", line)
    text = " ".join(text.split())
    return text[:MESSAGE_MAX]


def last_paragraph(region: list[str]) -> str:
    """The opening line of the last thing the agent actually said.

    Walking back to the *start* of the block rather than taking the final
    line matters: a wrapped answer's last line is a sentence fragment, and
    a fragment in a status row is worse than nothing.
    """
    end = len(region)
    while end > 0 and (is_chrome(region[end - 1])
                       or INTERRUPTED_RE.match(region[end - 1])):
        end -= 1
    if end == 0:
        return "-"
    start = end - 1
    while start > 0 and not is_chrome(region[start - 1]):
        start -= 1
    return clean(region[start]) or "-"


def is_delegated(region: list[str]) -> bool:
    """True when the last turn ended parked on delegates, not finished.

    The waiting line stays on the transcript after they report, so a later
    turn boundary - a summary line of the session's own - means the wait is
    over and the row is plain `done`.
    """
    for line in reversed(region):
        if DELEGATED_RE.match(line):
            return True
        if SUMMARY_RE.match(line):
            return False
    return False


def is_interrupted(region: list[str]) -> bool:
    """True when the interruption is the last thing on the transcript."""
    for line in reversed(region):
        if is_chrome(line):
            continue
        return bool(INTERRUPTED_RE.match(line))
    return False


def spinner_message(region: list[str]) -> str | None:
    """The spinner's own text, without its glyph or elapsed parenthetical."""
    for line in reversed(region):
        m = SPINNER_RE.match(line)
        if m:
            verb = re.sub(rf"^\s*{SPINNER_GLYPH}\s+", "", m.group(0))
            return clean(re.sub(r"\s*\(.*", "", verb))
    return None


def running_message(region: list[str]) -> str:
    """What the agent is doing: its current step, else the spinner's text.

    A spinner message of more than one word is not a verb out of claude's
    vocabulary but claude naming a phase of its own - `Compacting
    conversation…` - and that outranks the step bullet above it, because
    whatever that step was, it is over.
    """
    spinner = spinner_message(region)
    if spinner and " " in spinner:
        return spinner
    for line in reversed(region):
        if re.match(r"^\s{0,2}[●○◉]\s+\S", line):
            return clean(line)
    return spinner or "-"


def claude_question(lines: list[str]) -> str | None:
    """The question above a live claude option list, if it asks one.

    Only read when claude's key-hint row closes the pane, so a dialog quoted
    further up the transcript cannot answer for an opencode dialog below.
    The walk stops at a rule: above it is the transcript, not the dialog.
    """
    if not lines or not HINT_RE.match(lines[-1]):
        return None
    choices = [i for i, line in enumerate(lines) if CHOICE_RE.match(line)]
    if not choices:
        return None
    for line in reversed(lines[:choices[-1]]):
        if BORDER_RE.match(line):
            break
        if line.rstrip().endswith("?"):
            return clean(line)
    return None


def dialog_message(lines: list[str]) -> str:
    """What the dialog is asking for."""
    question = claude_question(lines)
    if question:
        return question
    dialog = lines[-DIALOG_LINES:]
    # The hint row matches ASK_RE too, but it is the last resort: it says
    # which keys to press, not what the keys decide.
    for line in dialog:
        if ASK_RE.search(line) and not HINT_RE.match(line):
            return clean(line)
    for line in dialog:
        m = ARROW_RE.match(line)
        if m:
            return clean(m.group(1))
    for line in dialog:
        if PERMISSION_RE.match(line) or YESNO_RE.search(line):
            return clean(line)
    for line in dialog:
        if HINT_RE.match(line):
            return clean(line)
    return "-"


def delegated_message(tray: list[str], region: list[str]) -> str:
    """What the delegates are doing, else the session's parting words."""
    doing = [activity for activity, _ in tray_delegates(tray) if activity]
    if doing:
        return clean(" · ".join(doing))
    return last_paragraph(region)


def input_draft(lines: list[str]) -> str:
    """Unsent text sitting in the input box, if any."""
    borders = [i for i, line in enumerate(lines) if BORDER_RE.match(line)]
    if len(borders) < 2:
        return ""
    box = lines[borders[-2] + 1:borders[-1]]
    return clean(" ".join(line.strip() for line in box)).strip()


def pick_message(state: str, lines: list[str]) -> str:
    body, tray = split_tray(lines)
    if state == "blocked":
        return dialog_message(body)
    region = transcript_region(body)
    if state == "running":
        return running_message(region)
    if state == "delegated":
        return delegated_message(tray, region)
    if state == "interrupted":
        # An interrupted turn was cut off mid-word, so its last line is
        # usually a fragment. claude puts the prompt back in the input box
        # when it stops, and that prompt is the thing you have to decide
        # about, so prefer it.
        draft = input_draft(body)
        if draft:
            return f"❯ {draft}"
    return last_paragraph(region)


def classify(lines: list[str]) -> str:
    body, _ = split_tray(lines)
    # Blocking on the user wins over everything else: it is the state that
    # needs a human, and a dialog hides the spinner anyway.
    if waiting_dialog(body[-DIALOG_LINES:]):
        return "blocked"

    tail = body[-TAIL_LINES:]
    if any(SPINNER_RE.match(line) for line in tail):
        return "running"
    if any(INTERRUPT_RE.match(line) for line in tail):
        return "running"
    region = transcript_region(body)
    # Both of these are checked after the spinner: their markers stay on
    # the transcript, so a pane that was parked or interrupted and has
    # since been sent on its way is running again.
    if is_delegated(region):
        return "delegated"
    if is_interrupted(region):
        return "interrupted"
    return "done"


SUFFIX_SCALE = {"k": 1_000, "m": 1_000_000}


def context_tokens(text: str) -> int | None:
    """`145.3k` -> 145300. None when the pane only reports a percentage."""
    m = re.fullmatch(r"([\d.]+)([kKmM]?)", text)
    if not m:
        return None
    try:
        value = float(m.group(1))
    except ValueError:
        return None
    return int(value * SUFFIX_SCALE.get(m.group(2).lower(), 1))


def context_level(text: str) -> str:
    tokens = context_tokens(text)
    if tokens is None:
        return "unknown"
    if tokens >= CTX_ROT:
        return "rot"
    return "warn" if tokens >= CTX_WARN else "ok"


def context_color(text: str) -> str:
    return {
        "unknown": MUTED, "rot": RED, "warn": YELLOW, "ok": GREEN,
    }[context_level(text)]


def parse_context(lines: list[str]) -> str:
    body, _ = split_tray(lines)
    for line in reversed(body[-FOOTER_LINES:]):
        m = CTX_RE.search(line)
        if m:
            if m.group(1):
                return m.group(1)
            if m.group(2):
                return f"{m.group(2)}%"
            return m.group(3)
    return "-"


def _statusline_duration(lines: list[str], pattern: re.Pattern[str]) -> str | None:
    """`Session: 24hr 13m` / `Block: 4hr 22m` -> `24h13m` / `4h22m`."""
    body, _ = split_tray(lines)
    for line in reversed(body[-FOOTER_LINES:]):
        m = pattern.search(line)
        if m:
            head = m.group(1).replace(" ", "").replace("hr", "h")
            return f"{head}{m.group(2)}" if m.group(2) else head
    return None


def parse_age(lines: list[str]) -> str | None:
    return _statusline_duration(lines, AGE_RE)


def parse_block(lines: list[str]) -> str | None:
    return _statusline_duration(lines, BLOCK_RE)


def parse_weekly(lines: list[str]) -> str | None:
    body, _ = split_tray(lines)
    for line in reversed(body[-TAIL_LINES:]):
        m = WEEKLY_RE.search(line)
        if m:
            return f"{m.group(1)}%"
    return None


def weekly_color(text: str) -> str:
    m = re.fullmatch(r"(\d+)%", text)
    if not m:
        return MUTED
    percent = int(m.group(1))
    if percent >= WEEKLY_HIGH:
        return RED
    return YELLOW if percent >= WEEKLY_WARN else GREEN


def parse_done(lines: list[str], now: float) -> float | None:
    """Seconds since the last finished turn, from its `· done H:MM` stamp.

    The stamp is wall-clock with no date, so it is read as the most recent
    past occurrence of that time. A 12h clock plus AM/PM and a 24h clock are
    both unambiguous within a day; anything older than that is reported as
    None rather than as a number that would be off by a multiple of 24h.
    """
    # Not limited to the tail: a short transcript is padded with blank lines
    # above the input box, which pushes the stamp well clear of it. The
    # anchored shape above is the guard instead of the position.
    stamp = None
    for line in lines:
        m = DONE_RE.match(line)
        if m:
            stamp = m
    if stamp is None:
        return None

    hour, minute = int(stamp.group(1)), int(stamp.group(2))
    half = stamp.group(3)
    if half:
        hour = hour % 12 + (12 if half.lower() == "p" else 0)
    if hour > 23 or minute > 59:
        return None

    local = time.localtime(now)
    done = time.mktime((
        local.tm_year, local.tm_mon, local.tm_mday, hour, minute, 0,
        0, 0, -1,
    ))
    # A stamp later than the current clock happened yesterday. The 90s of
    # slack absorbs the stamp's own minute-level truncation.
    if done > now + 90:
        done -= 24 * 3600
    elapsed = now - done
    return elapsed if 0 <= elapsed < 24 * 3600 else None


def parse_elapsed(lines: list[str]) -> float | None:
    """How long the running turn has been going, from the spinner."""
    for line in reversed(lines[-TAIL_LINES:]):
        if not SPINNER_RE.match(line):
            continue
        m = ELAPSED_RE.search(line)
        if m:
            return int(m.group(1) or 0) * 60 + int(m.group(2))
        # A spinner with no parenthetical yet: the turn is ~a second old.
        return None
    return None


def tray_elapsed(tray: list[str]) -> float | None:
    """How long the wait has run: the oldest delegate still out there."""
    longest = None
    for _, stats in tray_delegates(tray):
        m = TRAY_ELAPSED_RE.match(stats)
        if m is None or not any(m.groups()):
            continue
        hours, minutes, secs = (int(g or 0) for g in m.groups())
        seconds = hours * 3600 + minutes * 60 + secs
        if longest is None or seconds > longest:
            longest = seconds
    return longest


def state_seconds(state: str, lines: list[str], now: float) -> float | None:
    """How long this pane has been in the state the row reports.

    Deliberately not a single clock: for a running pane the honest number is
    the turn's own elapsed time, for an idle one it is the time since the
    last turn finished, for a delegated one it is the oldest delegate's, and
    for a pane blocked on a dialog nothing on screen records when the dialog
    appeared. None means the screen does not say, which is not the same as
    zero and must not be sorted as though it were.
    """
    body, tray = split_tray(lines)
    if state == "running":
        return parse_elapsed(body)
    if state == "delegated":
        return tray_elapsed(tray)
    if state == "done":
        return parse_done(body, now)
    return None


def state_duration(state: str, seconds: float | None) -> str:
    if seconds is None:
        return "-"
    if state == "running":
        # A turn is worth watching second by second; the states measured in
        # wall-clock time since something happened are not.
        minutes, secs = divmod(int(seconds), 60)
        return f"{minutes}m{secs}s" if minutes else f"{secs}s"
    if state == "done":
        return format_elapsed(seconds, floor="<1m")
    return format_elapsed(seconds)


def format_elapsed(seconds: float, floor: str | None = None) -> str:
    total = max(int(seconds), 0)
    hours, rem = divmod(total, 3600)
    minutes, secs = divmod(rem, 60)
    if hours:
        return f"{hours}h{minutes}m"
    if minutes:
        return f"{minutes}m"
    # `done` stamps carry whole minutes only, so seconds there are noise.
    return floor if floor else f"{secs}s"


# --- scan ---

SHARED_TREE = "▲"


@dataclass(frozen=True)
class Row:
    state: str
    project: str
    branch: str
    target: str
    # tmux's own id for the pane (`%12`). Unlike the target it survives
    # windows being renumbered, so it is what a tool acts on.
    pane_id: str
    # The pane's working directory: where an action on the agent should run.
    cwd: str
    agent: str
    context: str
    duration: str
    # The duration as a number, or None when the screen does not record it.
    # The column is what you read; this is what the list sorts on.
    since: float | None
    block: str
    weekly: str
    age: str
    message: str
    flag: str


def sort_key(row: Row) -> tuple[int, int, float, str]:
    """State first, then the freshest row in that state.

    Sorting the newest transition to the top is what makes the list a queue
    rather than a directory: the session that just finished, or just put a
    dialog up, is the one still holding a thought you were having. A row
    whose clock the screen does not record cannot claim to be fresh, so it
    sits below the ones that can, ahead of nothing but its own name.
    """
    return (
        STATE_ORDER.get(row.state, 9),
        row.since is None,
        row.since if row.since is not None else 0.0,
        row.target,
    )


def collect_rows() -> list[Row]:
    panes = list_panes()
    if not panes:
        return []
    info, children = process_snapshot()
    now = time.time()

    agent_panes = [
        (pane, agent)
        for pane in panes
        if (agent := find_agent(pane.pid, info, children)) is not None
    ]
    # Two agents in one working tree overwrite each other's edits with no
    # conflict and no warning, so it is worth saying out loud.
    trees = Counter(pane.cwd for pane, _ in agent_panes)
    # One lookup per tree rather than per pane, for the same reason.
    identities = {cwd: git_identity(cwd) for cwd in trees}

    rows: list[Row] = []
    for pane, agent in agent_panes:
        lines = visible_lines(capture_pane(pane.pane_id))
        state = classify(lines)
        since = state_seconds(state, lines, now)
        project, branch = identities[pane.cwd]
        rows.append(Row(
            state=state,
            project=project,
            branch=branch,
            target=pane.target,
            pane_id=pane.pane_id,
            cwd=pane.cwd,
            agent=agent.name,
            context=parse_context(lines),
            duration=state_duration(state, since),
            since=since,
            block=parse_block(lines) or "-",
            weekly=parse_weekly(lines) or "-",
            age=parse_age(lines) or format_elapsed(now - agent.started_at),
            message=pick_message(state, lines),
            flag=SHARED_TREE if trees[pane.cwd] > 1 else " ",
        ))

    rows.sort(key=sort_key)
    return rows


def render(rows: list[Row], color: bool) -> list[str]:
    def paint(text: str, code: str) -> str:
        return f"{code}{text}{RESET}" if color else text

    rows = [
        replace(
            r,
            project=fit(r.project, IDENTITY_MAX),
            branch=fit(r.branch, IDENTITY_MAX),
        )
        for r in rows
    ]

    def width(field: str) -> int:
        return max(len(getattr(r, field)) for r in rows)

    w_state = width("state")
    w_project = width("project")
    w_branch = width("branch")
    w_target = width("target")
    w_agent = width("agent")
    w_ctx = width("context")
    w_dur = width("duration")
    w_block = width("block")
    w_weekly = width("weekly")
    w_age = width("age")

    # A column nobody can fill is a column nobody should read. The weekly
    # notice in particular is only on screen once you are close to the
    # limit, so most of the time it costs nothing.
    def informative(field: str) -> bool:
        return any(getattr(r, field) != "-" for r in rows)

    show_weekly = informative("weekly")

    out: list[str] = []
    for r in rows:
        state_color = STATE_COLOR.get(r.state, MUTED)
        # The television channel attaches to the first `session:window.pane`
        # on the row, so nothing left of the target may take that shape. git
        # forbids `:` in a branch name; a project named after a folder with
        # a colon in it is the one way to break it.
        columns = [
            paint("●", state_color) + " " + r.project.ljust(w_project),
            paint(r.branch.ljust(w_branch), branch_color(r.branch)),
            paint(r.target.ljust(w_target), MUTED),
            paint(r.flag, RED),
            paint(r.state.ljust(w_state), state_color),
            paint(r.agent.ljust(w_agent), CYAN),
            (paint(r.context.rjust(w_ctx), context_color(r.context))
             + paint(" ctx", MUTED)),
            # Left at full brightness: how long this pane has been in this
            # state is the number you actually triage on.
            r.duration.rjust(w_dur),
            paint(f"blk {r.block.ljust(w_block)}", MUTED),
        ]
        if show_weekly:
            columns.append(
                paint("wk ", MUTED)
                + paint(r.weekly.rjust(w_weekly), weekly_color(r.weekly))
            )
        columns.append(paint(f"up {r.age.rjust(w_age)}", MUTED))
        out.append("  ".join(columns) + "   " + paint(r.message, MUTED))
    return out


def render_json(rows: list[Row]) -> str:
    return json.dumps(
        [asdict(r) | {"context_level": context_level(r.context)} for r in rows],
        ensure_ascii=False,
    )


# tmux's names for the palette colours STATE_COLOR uses.
TMUX_STATE_COLOR = {
    "blocked": "yellow",
    "interrupted": "magenta",
    "done": "green",
    "running": "blue",
    "delegated": "cyan",
}


def render_tmux(rows: list[Row]) -> str:
    """`● 1 ● 2 ` in tmux style syntax, most urgent state first.

    The trailing space is part of the output, so the status bar only makes
    room when there is something to show.
    """
    counts = Counter(r.state for r in rows)
    parts = [
        f"#[fg={TMUX_STATE_COLOR[state]}]● {counts[state]}"
        for state in sorted(counts, key=lambda s: STATE_ORDER.get(s, 9))
        if state in TMUX_STATE_COLOR
    ]
    return " ".join(parts) + "#[default] " if parts else ""


def cmd_scan(
    color: bool, as_json: bool = False, as_tmux: bool = False,
) -> int:
    rows = collect_rows()
    if as_tmux:
        # An empty line, not a message: the status bar shows whatever this
        # prints.
        print(render_tmux(rows))
        return 0
    if as_json:
        # Always a list, even an empty one: a consumer polling this wants
        # "no agents" as data, not as a message on stderr.
        print(render_json(rows))
        return 0
    if not rows:
        # stderr so consumers parsing stdout see an empty list, not a row.
        print("no agents running in tmux", file=sys.stderr)
        return 0
    for line in render(rows, color):
        print(line)
    return 0


# --- dispatch ---

def main() -> int:
    args = [a for a in sys.argv[1:] if a != "scan"]
    color = "--no-color" not in args and not os.environ.get("NO_COLOR")
    as_json = "--json" in args
    as_tmux = "--tmux" in args
    args = [a for a in args if a not in ("--no-color", "--json", "--tmux")]

    if args and args[0] in ("-h", "--help", "help"):
        assert __doc__
        print(__doc__.strip())
        return 0
    if args:
        print(f"Unknown argument: {args[0]}", file=sys.stderr)
        print("Usage: agent-scan [scan] [--no-color | --json | --tmux]",
              file=sys.stderr)
        return 2
    return cmd_scan(color, as_json, as_tmux)


if __name__ == "__main__":
    sys.exit(main())
