#!/usr/bin/env -S uv run --script
# vim: set ft=python:
# -*- mode: python -*-
# language: python
# /// script
# requires-python = ">=3.13"
# dependencies = [
#   "psutil==7.2.2",
# ]
# ///
"""agent-scan - report agentic coding sessions running in tmux.

One row per pane that has an agent in its process tree, so a session with
several agents in several panes lists all of them.

State comes from what the pane is currently rendering (running spinner,
approval dialog, or neither). Reading the screen means the state can never
go stale the way an event-driven cache does: whatever the pane shows is
what the row says.

Usage: agent-scan [scan] [--no-color]

Output columns: state, session:window.pane, agent, context, session age,
pane id. The pane id is always the last field so consumers can pick it up
with a split on the last whitespace-separated token.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass

import psutil

AGENT_NAMES = frozenset({"claude", "codex", "pi"})

RESET = "\033[0m"
BLUE, YELLOW, GREEN, CYAN, DIM = (
    "\033[34m", "\033[33m", "\033[32m", "\033[36m", "\033[2m",
)
STATE_COLOR = {"running": BLUE, "waiting": YELLOW, "idle": GREEN}
STATE_ORDER = {"waiting": 0, "running": 1, "idle": 2}

# How much of the pane bottom counts as live UI. Claude's footer block is
# roughly 8 lines (input box borders, statusline, hints), and the spinner
# sits just above it, so 16 covers the whole live region while keeping
# transcript text - which can quote any of these patterns - out of scope.
TAIL_LINES = 16
# The statusline is inside the footer block itself.
FOOTER_LINES = 8

# The bare spinner line - `✶ Topsy-turvying…`, a glyph and one gerund - is
# on screen ~0.2s after a turn starts. Its parenthetical (`… (13s · ↓ 129
# tokens)`) takes another ~1.5s and the `esc to interrupt` hint longer
# still, so keying on the parenthetical alone made `running` show up late.
# Requiring a single word ending in the ellipsis keeps transcript lines that
# claude truncated with `…` from matching.
SPINNER_RE = re.compile(r"^[^\w\s]\s+[A-Za-z][A-Za-z'-]*…")
# `(12s · esc to interrupt)` on that same line, or an agent whose footer is
# just `Esc to interrupt`. Anchored to a line start or a `(`/`·` separator so
# transcript prose or code quoting the phrase cannot trigger it.
INTERRUPT_RE = re.compile(
    r"(?:^\s*|[(·]\s*)(?:esc|ctrl\+c) to interrupt",
    re.IGNORECASE | re.MULTILINE,
)
# The selected line of an approval menu: `❯ 1. Yes`, boxed or not.
CHOICE_RE = re.compile(r"^\s*[│┃|]?\s*❯\s*\d+\.\s")
# Any other option line of that menu: `  2. No`.
OPTION_RE = re.compile(r"^\s*[│┃|]?\s*\d+\.\s")
# Prose and footers that only appear while an agent blocks on the user.
ASK_RE = re.compile(
    r"Do you want|Would you like|Enter to confirm|Esc to cancel",
    re.IGNORECASE,
)
# Plain shell-style confirmations, for agents that do not draw a menu.
YESNO_RE = re.compile(r"\[y/n\]|\(y/n\)\s*[?:]?\s*$", re.IGNORECASE | re.MULTILINE)
# From the statusline: `Model: Opus 5 | Ctx: 488.7k` or `58% ctx`.
CTX_RE = re.compile(r"Ctx:\s*([\d.]+[kKmM]?)|(\d+)%\s*ctx")
# From the statusline: `Session: 24hr 13m`, `Session: 4m`, `Session: <1m`.
AGE_RE = re.compile(r"Session:\s*(<?\d+\s*(?:hr|h|m|s))(?:\s*(\d+m))?")


# --- tmux ---

@dataclass(frozen=True)
class Pane:
    pane_id: str
    session: str
    window: str
    index: str
    pid: int

    @property
    def target(self) -> str:
        return f"{self.session}:{self.window}.{self.index}"


def tmux(*args: str) -> str | None:
    try:
        r = subprocess.run(
            ["tmux", *args], capture_output=True, text=True, timeout=2,
            check=False,
        )
    except (subprocess.SubprocessError, OSError):
        return None
    return r.stdout if r.returncode == 0 else None


def list_panes() -> list[Pane]:
    out = tmux(
        "list-panes", "-a", "-F",
        "#{pane_id}\t#{session_name}\t#{window_index}\t#{pane_index}"
        "\t#{pane_pid}",
    )
    if not out:
        return []
    panes: list[Pane] = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) != 5:
            continue
        pane_id, session, window, index, pid = parts
        try:
            panes.append(Pane(pane_id, session, window, index, int(pid)))
        except ValueError:
            continue
    return panes


def capture_pane(pane_id: str) -> str:
    return tmux("capture-pane", "-t", pane_id, "-p") or ""


# --- process tree ---

@dataclass(frozen=True)
class Agent:
    name: str
    pid: int
    started_at: float


def process_snapshot() -> tuple[dict[int, tuple[str, float]], dict[int, list[int]]]:
    """One pass over the process table: pid -> (name, start), pid -> children."""
    info: dict[int, tuple[str, float]] = {}
    children: dict[int, list[int]] = {}
    for proc in psutil.process_iter(["pid", "ppid", "name", "create_time"]):
        try:
            d = proc.info
            info[d["pid"]] = (d["name"] or "", d["create_time"] or 0.0)
            children.setdefault(d["ppid"], []).append(d["pid"])
        except psutil.Error:
            continue
    return info, children


def find_agent(
    root_pid: int,
    info: dict[int, tuple[str, float]],
    children: dict[int, list[int]],
) -> Agent | None:
    """Shallowest agent process at or below root_pid, or None."""
    queue = [root_pid]
    seen: set[int] = set()
    while queue:
        pid = queue.pop(0)
        if pid in seen:
            continue
        seen.add(pid)
        entry = info.get(pid)
        if entry is None:
            continue
        name, started_at = entry
        if name in AGENT_NAMES:
            return Agent(name, pid, started_at)
        queue.extend(children.get(pid, ()))
    return None


# --- pane content ---

def visible_lines(content: str) -> list[str]:
    """Pane lines with the trailing blank padding removed."""
    lines = content.splitlines()
    while lines and not lines[-1].strip():
        lines.pop()
    return lines


def classify(lines: list[str]) -> str:
    tail = lines[-TAIL_LINES:]
    blob = "\n".join(tail)

    # Blocking on the user wins over everything else: it is the state that
    # needs a human, and an approval dialog hides the spinner anyway.
    # A bare `❯ 1. ...` is not enough: that is also what a user typing
    # "1. do this" into the input box looks like. Require a sibling option
    # line or the dialog's own prose/footer alongside it.
    selected = any(CHOICE_RE.match(line) for line in tail)
    siblings = any(OPTION_RE.match(line) for line in tail)
    if selected and (siblings or ASK_RE.search(blob)):
        return "waiting"
    if YESNO_RE.search(blob):
        return "waiting"

    if any(SPINNER_RE.match(line.strip()) for line in tail):
        return "running"
    if INTERRUPT_RE.search(blob):
        return "running"
    return "idle"


def parse_context(lines: list[str]) -> str:
    for line in reversed(lines[-FOOTER_LINES:]):
        m = CTX_RE.search(line)
        if m:
            return f"{m.group(1)}" if m.group(1) else f"{m.group(2)}%"
    return "-"


def parse_age(lines: list[str]) -> str | None:
    for line in reversed(lines[-FOOTER_LINES:]):
        m = AGE_RE.search(line)
        if m:
            head = m.group(1).replace(" ", "").replace("hr", "h")
            return f"{head}{m.group(2)}" if m.group(2) else head
    return None


def format_elapsed(seconds: float) -> str:
    total = max(int(seconds), 0)
    hours, rem = divmod(total, 3600)
    minutes, secs = divmod(rem, 60)
    if hours:
        return f"{hours}h{minutes}m"
    if minutes:
        return f"{minutes}m"
    return f"{secs}s"


# --- scan ---

@dataclass(frozen=True)
class Row:
    state: str
    target: str
    agent: str
    context: str
    age: str
    pane_id: str


def collect_rows() -> list[Row]:
    panes = list_panes()
    if not panes:
        return []
    info, children = process_snapshot()
    now = time.time()

    rows: list[Row] = []
    for pane in panes:
        agent = find_agent(pane.pid, info, children)
        if agent is None:
            continue
        lines = visible_lines(capture_pane(pane.pane_id))
        rows.append(Row(
            state=classify(lines),
            target=pane.target,
            agent=agent.name,
            context=parse_context(lines),
            age=parse_age(lines) or format_elapsed(now - agent.started_at),
            pane_id=pane.pane_id,
        ))

    rows.sort(key=lambda r: (STATE_ORDER.get(r.state, 9), r.target))
    return rows


def render(rows: list[Row], color: bool) -> list[str]:
    def paint(text: str, code: str) -> str:
        return f"{code}{text}{RESET}" if color else text

    w_state = max(len(r.state) for r in rows)
    w_target = max(len(r.target) for r in rows)
    w_agent = max(len(r.agent) for r in rows)
    w_ctx = max(len(r.context) for r in rows)
    w_age = max(len(r.age) for r in rows)

    out: list[str] = []
    for r in rows:
        state_color = STATE_COLOR.get(r.state, DIM)
        out.append(" ".join((
            paint("●", state_color),
            paint(r.state.ljust(w_state), state_color),
            r.target.ljust(w_target),
            paint(r.agent.ljust(w_agent), CYAN),
            paint(f"{r.context.rjust(w_ctx)} ctx", DIM),
            paint(r.age.rjust(w_age), DIM),
            paint(r.pane_id, DIM),
        )))
    return out


def cmd_scan(color: bool) -> int:
    rows = collect_rows()
    if not rows:
        # stderr so consumers parsing stdout see an empty list, not a row.
        print("no agents running in tmux", file=sys.stderr)
        return 0
    for line in render(rows, color):
        print(line)
    return 0


# --- dispatch ---

def main() -> int:
    args = [a for a in sys.argv[1:] if a != "scan"]
    color = "--no-color" not in args and not os.environ.get("NO_COLOR")
    args = [a for a in args if a != "--no-color"]

    if args and args[0] in ("-h", "--help", "help"):
        assert __doc__
        print(__doc__.strip())
        return 0
    if args:
        print(f"Unknown argument: {args[0]}", file=sys.stderr)
        print("Usage: agent-scan [scan] [--no-color]", file=sys.stderr)
        return 2
    return cmd_scan(color)


if __name__ == "__main__":
    sys.exit(main())
