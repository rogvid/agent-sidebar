#!/usr/bin/env -S uv run --script
# vim: set ft=python:
# -*- mode: python -*-
# language: python
# /// script
# requires-python = ">=3.13"
# dependencies = [
#   "textual==8.2.8",
# ]
# ///
"""agent-sidebar - agent-scan as a sidebar, one group per project.

Runs in the pane agent-sidebar-tmux keeps down the left of the window you
are looking at (M-2). Every second it reads `agent-scan --json` and lists
the agents under the project they are working in.

Projects keep agent-scan's queue order: the project holding the agent that
most needs you comes first, and inside a project the agents keep their
order too. Read top-down, it is still a queue.

A bar in the gutter marks the agents in the window you are looking at. On
an agent's second line, `#12` is its branch's pull request, coloured by
state, and a context size appears once the session is far enough along
that its early turns are fading.

Actions work on the highlighted agent, mostly in a tmux popup over the
current window: `?` lists them and ctrl+p searches them. When an agent in
another window stops and needs you, tmux says so on the status line.
"""

from __future__ import annotations

import asyncio
import json
import os
import subprocess
import time
from collections import Counter
from collections.abc import Awaitable, Callable, Iterable
from dataclasses import dataclass
from typing import Any

from rich.console import Group
from rich.table import Table
from rich.text import Text
from textual.app import App, ComposeResult, SystemCommand
from textual.binding import Binding
from textual.containers import Vertical
from textual.screen import ModalScreen, Screen
from textual.widgets import Checkbox, Input, OptionList, Static
from textual.widgets.option_list import Option

Row = dict[str, Any]
# Branch name -> {"number", "state", "draft"} for one repository.
PullRequests = dict[str, dict[str, Any]]

SCAN_INTERVAL = 1.0
# Pull requests change over minutes, and each look is a round trip to
# GitHub per project.
PR_INTERVAL = 120.0

# agent-scan's colours, as terminal palette names so the sidebar reads in
# the same theme as the panes beside it.
STATE_COLOR = {
    "blocked": "yellow",
    "interrupted": "magenta",
    "done": "green",
    "running": "blue",
    "delegated": "cyan",
}
STATE_ORDER = ("blocked", "interrupted", "done", "running", "delegated")
# A pane moving from working to one of these has stopped and is waiting on
# you, which is the moment worth interrupting you for.
BUSY = frozenset({"running", "delegated"})
ATTENTION = frozenset({"blocked", "interrupted", "done"})
PR_COLOR = {"OPEN": "green", "MERGED": "magenta", "CLOSED": "red"}
CONTEXT_COLOR = {"warn": "yellow", "rot": "red"}
MUTED = "color(245)"
HERE = "▌"

# Harness colours/icons are fixed; roles are picked up from the agent
# at runtime (chief/architect/any future name) and get a stable colour
# via hashing so no hardcoded role list is needed.
HARNESS_COLOR = {
    "claude": "cyan",
    "codex": "green",
    "opencode": "blue",
    "pi": "magenta",
}
HARNESS_ICON = {
    "claude": "◆",
    "codex": "◇",
    "opencode": "⬢",
    "pi": "○",
}
ROLE_PALETTE = ["yellow", "bright_magenta", "bright_cyan", "bright_yellow", "red"]
ROLE_ICON = "★"
class _DynamicDict(dict):
    """dict that returns a stable colour/icon for any role without hardcoding."""
    def __getitem__(self, key: str) -> str:
        if key in self:
            return super().__getitem__(key)
        # fall through to dynamic lookup
        if self is AGENT_COLOR:
            return agent_color(key)
        return agent_icon(key)
    def get(self, key: str, default=None):
        if key in self:
            return super().get(key, default)
        try:
            return self[key]
        except KeyError:
            return default

# Keep old names for backwards compat — callers importing AGENT_COLOR still work.
AGENT_COLOR: dict[str, str] = _DynamicDict(HARNESS_COLOR)
AGENT_ICON: dict[str, str] = _DynamicDict(HARNESS_ICON)


def agent_color(agent: str) -> str:
    name = agent.lower()
    if name in HARNESS_COLOR:
        return HARNESS_COLOR[name]
    # Roles — stable hash so "chief" always looks the same without hardcoding
    h = sum(ord(c) for c in name)  # simple stable hash, no random
    return ROLE_PALETTE[h % len(ROLE_PALETTE)] if name else MUTED


def agent_icon(agent: str) -> str:
    name = agent.lower()
    if name in HARNESS_ICON:
        return HARNESS_ICON[name]
    return ROLE_ICON if name else "●"

PROJECT_PREFIX = "project:"
GLUE = "agent-sidebar-tmux"

# Harnesses that can be started in a new worktree's session.
# Overridable with AGENT_SIDEBAR_HARNESSES (space or comma separated).
_DEFAULT_HARNESSES = ("claude", "codex", "opencode", "pi")
# YOLO flag per harness when the checkbox is on (on by default).
_HARNESS_YOLO: dict[str, str] = {
    "claude": "--dangerously-skip-permissions",
    "codex": "--yolo",
    "opencode": "--yolo",
    "pi": "--yolo",
}


def harnesses() -> list[str]:
    raw = os.environ.get("AGENT_SIDEBAR_HARNESSES")
    if raw is not None:
        parts = [p.strip() for p in raw.replace(",", " ").split() if p.strip()]
        return parts if parts else list(_DEFAULT_HARNESSES)
    agent = os.environ.get("AGENT_SIDEBAR_AGENT")
    base = list(_DEFAULT_HARNESSES)
    if agent and agent not in base:
        base.append(agent)
    return base


def default_harness() -> str:
    agent = os.environ.get("AGENT_SIDEBAR_AGENT", "claude")
    # AGENT_SIDEBAR_AGENT may be a full command; the harness list holds
    # the same string so the default can be highlighted.
    return agent


def _git_config_get(cwd: str | None, key: str) -> str | None:
    if not cwd:
        return None
    try:
        proc = subprocess.run(
            ["git", "config", "--get", key],
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=2,
        )
        if proc.returncode == 0:
            val = proc.stdout.strip()
            return val if val else None
    except Exception:
        return None
    return None


def harnesses_for_project(cwd: str | None) -> list[str]:
    base = harnesses()
    # Per-project env var via git config takes precedence over global env.
    # Supported keys: agent-sidebar.harness, worktree.harness
    for key in ("agent-sidebar.harness", "worktree.harness"):
        val = _git_config_get(cwd, key)
        if val:
            # allow single harness or list? treat as single default, not replacement
            # but if it contains spaces/commas, treat as list override
            if "," in val or " " in val:
                parts = [p.strip() for p in val.replace(",", " ").split() if p.strip()]
                if parts:
                    return parts
            else:
                # ensure the per-project default is present in list
                if val not in base:
                    tail = [h for h in base if h == "none"]
                    head = [h for h in base if h != "none"]
                    if val not in head:
                        head.append(val)
                    return head + tail
            break
    return base


def default_harness_for_project(cwd: str | None) -> str:
    for key in ("agent-sidebar.harness", "worktree.harness"):
        val = _git_config_get(cwd, key)
        if val and "," not in val and " " not in val:
            return val
    return default_harness()


def yolo_default_for_project(cwd: str | None) -> bool:
    for key in ("agent-sidebar.yolo", "worktree.yolo"):
        val = _git_config_get(cwd, key)
        if val is not None:
            return val.lower() not in ("0", "false", "no", "off")
    # Global env var AGENT_SIDEBAR_YOLO or default on
    env = os.environ.get("AGENT_SIDEBAR_YOLO")
    if env is not None:
        return env.lower() not in ("0", "false", "no", "off")
    return True


def build_harness_command(harness: str, yolo: bool) -> str:
    """Final command typed into the new session."""
    if harness == "none":
        return "none"
    flag = _HARNESS_YOLO.get(harness, "")
    if yolo and flag:
        # harness may already be a full command (e.g. "touch agent-started")
        # only append flag for known single-word harnesses
        if harness in _HARNESS_YOLO:
            return f"{harness} {flag}"
    return harness


def harness_prompt(harness: str) -> Text:
    if harness == "none":
        label = "no harness"
        icon = "·"
        style = MUTED
    else:
        label = harness
        icon = agent_icon(harness)
        style = agent_color(harness)
    return Text.assemble((f"{icon} ", style), (label, style))


@dataclass(frozen=True)
class Action:
    """One thing the sidebar does: its key, help line and palette entry."""

    name: str
    key: str
    label: str
    title: str
    help: str


ACTIONS = (
    Action("jump", "enter", "⏎", "Jump", "Go to the agent's pane"),
    Action("new_worktree", "n", "n", "New worktree",
           "Branch the project into a worktree with its own session and agent"),
    Action("open", "o", "o", "Open project",
           "Pick a git repository to open in its own session"),
    Action("review", "d", "d", "Review changes",
           "Review uncommitted changes in tuicr; y pastes comments to the agent"),
    Action("git", "g", "g", "Git", "lazygit in the agent's directory"),
    Action("pr", "p", "p", "Pull request",
           "Show the branch's pull request, or create one"),
    Action("kill", "x", "x", "Kill agent", "Kill the agent's pane"),
    Action("remove_worktree", "X", "X", "Remove worktree",
           "Remove the agent's worktree, then its pane"),
    Action("rescan", "r", "r", "Rescan", "Scan again now"),
    Action("back", "escape", "esc", "Back", "Return to the pane you came from"),
    Action("close", "q", "q", "Close sidebar", "Close the sidebar until M-2"),
    Action("help", "question_mark", "?", "Help", "Show the keys"),
)


def group_by_project(rows: list[Row]) -> list[tuple[str, list[Row]]]:
    """Rows grouped by project, groups in order of their first row."""
    groups: dict[str, list[Row]] = {}
    for row in rows:
        groups.setdefault(row["project"], []).append(row)
    return list(groups.items())


def grid() -> Table:
    table = Table.grid(expand=True)
    table.add_column(width=1, no_wrap=True)
    table.add_column(width=2, no_wrap=True)
    table.add_column(ratio=1, no_wrap=True, overflow="ellipsis")
    table.add_column(justify="right", no_wrap=True)
    return table


def badges(row: Row, pr: dict[str, Any] | None) -> Text:
    """The pull request and, once it matters, the context size."""
    text = Text()
    if pr is not None:
        draft = pr.get("draft") and pr["state"] == "OPEN"
        color = MUTED if draft else PR_COLOR.get(pr["state"], MUTED)
        text.append(f"#{pr['number']}", style=color)
    level = row.get("context_level")
    if level in CONTEXT_COLOR:
        if text:
            text.append(" ")
        text.append(row["context"], style=CONTEXT_COLOR[level])
    return text


def _harness_and_role(row: Row) -> tuple[str, str]:
    """Return (harness, role) with backwards compat for old rows."""
    harness = row.get("harness") or row.get("agent") or ""
    role = row.get("role") or ""
    # Old rows where agent is already the role but harness missing handled above.
    # If role equals harness (e.g. no role, or role-as-harness fallback), hide role.
    if role and role.lower() == harness.lower():
        role = ""
    return harness, role


def _agent_display(row: Row) -> Text:
    harness, role = _harness_and_role(row)
    if not harness:
        return Text("")
    h_color = agent_color(harness)
    h_icon = agent_icon(harness)
    if role:
        r_color = agent_color(role)
        r_icon = agent_icon(role)
        return Text.assemble(
            (f"{h_icon} {harness}", h_color),
            (" · ", MUTED),
            (f"{r_icon} {role}", r_color),
        )
    return Text(f"{h_icon} {harness}", style=h_color)


def _changes_display(changes: str) -> Text:
    """`+5 -2` with colours, `∅` muted when clean, empty when unknown."""
    if not changes or changes == "-":
        return Text("")
    if changes == "∅":
        return Text("∅", style=MUTED)
    # `+5 -2` or `+3 untracked`
    text = Text()
    parts = changes.split()
    for i, part in enumerate(parts):
        if i:
            text.append(" ")
        if part.startswith("+"):
            text.append(part, style="green")
        elif part.startswith("-"):
            text.append(part, style="red")
        else:
            text.append(part, style=MUTED)
    return text


def agent_prompt(
    row: Row, here: bool, pr: dict[str, Any] | None = None,
) -> Group:
    """Three lines: branch/changes, agent/harness with duration/context, state/message."""
    color = STATE_COLOR.get(row["state"], "default")
    gutter = Text(HERE if here else " ", style="bold")

    # Row 1: state dot + branch on the left, +- changes on the right
    top = grid()
    branch = Text(row["branch"])
    # Two agents in one working tree overwrite each other's edits.
    if row.get("flag", " ").strip():
        branch = Text.assemble(("! ", "bold red"), branch)
    changes = _changes_display(row.get("changes", "-"))
    top.add_row(
        gutter,
        Text("●", style=color),
        branch,
        changes,
    )

    # Row 2: agent + harness on the left, duration + context on the right
    middle = grid()
    agent = _agent_display(row)
    duration = "" if row.get("duration") == "-" else row.get("duration", "")
    extra = badges(row, pr)
    right = Text()
    if duration:
        right.append(duration)
    if extra.plain:
        if right.plain:
            right.append(" ")
        right.append(extra)
    middle.add_row(
        gutter,
        Text(""),
        agent,
        right,
    )

    # Row 3: state on the left, message on the right (message takes most)
    bottom = Table.grid(expand=True)
    bottom.add_column(width=1, no_wrap=True)
    bottom.add_column(width=2, no_wrap=True)
    bottom.add_column(no_wrap=True)
    bottom.add_column(ratio=1, no_wrap=True, overflow="ellipsis")
    message = "" if row.get("message") == "-" else row.get("message", "")
    message_text = Text(" " + message, style=MUTED) if message else Text("")
    bottom.add_row(
        gutter,
        Text(""),
        Text(row.get("state", ""), style=color),
        message_text,
    )
    return Group(top, middle, bottom)


def project_prompt(project: str, count: int) -> Table:
    """The project's name, lined up with the state dots under it."""
    table = Table.grid(expand=True)
    table.add_column(width=1, no_wrap=True)
    table.add_column(ratio=1, no_wrap=True, overflow="ellipsis")
    table.add_column(justify="right", no_wrap=True)
    table.add_row(
        Text(""),
        Text(project, style="bold"),
        Text(f" {count}", style=MUTED),
    )
    return table


def summary(rows: list[Row]) -> Text:
    """One coloured count per state that has agents in it."""
    counts = Counter(row["state"] for row in rows)
    parts: list[tuple[str, str] | str] = []
    for state in STATE_ORDER:
        if counts[state]:
            if parts:
                parts.append(" ")
            parts.append((f"● {counts[state]}", STATE_COLOR[state]))
    return Text.assemble(*parts)


def announcement(row: Row) -> str:
    """The status line message for an agent that stopped and needs you."""
    message = "" if row["message"] == "-" else f": {row['message']}"
    # display-message expands formats, and a message quoting `#12` or `#{`
    # would otherwise be read as one.
    return f"{row['project']}/{row['branch']} {row['state']}{message}".replace(
        "#", "##"
    )


async def tmux(*args: str) -> str | None:
    proc = await asyncio.create_subprocess_exec(
        "tmux", *args,
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    out, _ = await proc.communicate()
    return out.decode() if proc.returncode == 0 else None


async def scan() -> list[Row] | None:
    """agent-scan's rows, or None when the scan failed."""
    try:
        proc = await asyncio.create_subprocess_exec(
            "agent-scan", "--json",
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        )
    except OSError:
        return None
    out, _ = await proc.communicate()
    if proc.returncode != 0:
        return None
    try:
        rows = json.loads(out)
    except json.JSONDecodeError:
        return None
    return rows if isinstance(rows, list) else None


async def panes_here() -> set[str]:
    """The panes sharing a window with this one."""
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return set()
    out = await tmux("list-panes", "-t", pane, "-F", "#{pane_id}")
    return set(out.split()) if out else set()


async def pull_requests(cwd: str) -> PullRequests | None:
    """The newest pull request per branch of cwd's repository, or None
    when gh cannot say (not on GitHub, offline, not logged in)."""
    try:
        proc = await asyncio.create_subprocess_exec(
            "gh", "pr", "list", "--state", "all", "--limit", "100",
            "--json", "headRefName,number,state,isDraft",
            cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        )
    except OSError:
        return None
    out, _ = await proc.communicate()
    if proc.returncode != 0:
        return None
    try:
        listed = json.loads(out)
    except json.JSONDecodeError:
        return None
    prs: PullRequests = {}
    # gh lists the newest first, and a branch reused for a second PR should
    # show that one.
    for pr in listed:
        prs.setdefault(pr["headRefName"], {
            "number": pr["number"],
            "state": pr["state"],
            "draft": pr.get("isDraft", False),
        })
    return prs


async def run(*command: str) -> None:
    proc = await asyncio.create_subprocess_exec(
        *command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    await proc.wait()


class BranchPrompt(ModalScreen[str | None]):
    BINDINGS = [Binding("escape", "cancel", "cancel")]

    def __init__(self, project: str) -> None:
        super().__init__()
        self.project = project

    def compose(self) -> ComposeResult:
        with Vertical(classes="dialog"):
            yield Static(Text.assemble(
                "New worktree of ", (self.project, "bold"),
            ))
            yield Input(placeholder="feat/branch-name")
            yield Static("⏎ create  esc cancel", classes="hint")

    def on_input_submitted(self, event: Input.Submitted) -> None:
        self.dismiss(event.value.strip() or None)

    def action_cancel(self) -> None:
        self.dismiss(None)


class HarnessPrompt(ModalScreen[str | None]):
    BINDINGS = [
        Binding("escape", "cancel", "cancel"),
        Binding("j", "cursor_down", "down", show=False),
        Binding("k", "cursor_up", "up", show=False),
    ]

    def __init__(self, branch: str, options: list[str] | None = None) -> None:
        super().__init__()
        self.branch = branch
        self.options = options if options is not None else harnesses()

    def compose(self) -> ComposeResult:
        with Vertical(classes="dialog"):
            yield Static(Text.assemble(
                "Harness for ", (self.branch, "bold"),
            ))
            yield OptionList(*(
                Option(h, id=h) for h in self.options
            ), id="harness-options")
            yield Static("⏎ start  esc cancel", classes="hint")

    def on_mount(self) -> None:
        opts = self.query_one("#harness-options", OptionList)
        default = default_harness()
        if default in self.options:
            try:
                opts.highlighted = self.options.index(default)
            except ValueError:
                pass

    def on_option_list_option_selected(
        self, event: OptionList.OptionSelected,
    ) -> None:
        option_id = event.option.id
        self.dismiss(option_id)

    def action_cancel(self) -> None:
        self.dismiss(None)

    def action_cursor_down(self) -> None:
        self.query_one("#harness-options", OptionList).action_cursor_down()

    def action_cursor_up(self) -> None:
        self.query_one("#harness-options", OptionList).action_cursor_up()


class NewWorktreePrompt(ModalScreen[dict | None]):
    """Single modal: branch + harness + yolo.

    Tab moves focus (Input → harness → yolo).  ⏎ creates,
    esc cancels.  YOLO is on by default; per-project default harness
    comes from `git config agent-sidebar.harness` (or worktree.harness).
    """

    BINDINGS = [
        Binding("escape", "cancel", "cancel"),
        Binding("enter", "create", "create"),
        Binding("j", "cursor_down", "down", show=False),
        Binding("k", "cursor_up", "up", show=False),
        Binding("space", "toggle_yolo", "toggle yolo", show=False),
    ]

    def __init__(
        self, project: str, project_cwd: str | None = None,
    ) -> None:
        super().__init__()
        self.project = project
        self.project_cwd = project_cwd
        self._harnesses = harnesses_for_project(project_cwd)
        self._default_harness = default_harness_for_project(project_cwd)
        self._yolo_default = yolo_default_for_project(project_cwd)

    def compose(self) -> ComposeResult:
        with Vertical(classes="dialog"):
            yield Static(Text.assemble(
                "New worktree  ", (self.project, "bold"),
            ), classes="dialog-title")
            yield Input(placeholder="feat/branch-name", id="branch-input")
            yield Static("", id="harness-meta", classes="field-meta")
            yield OptionList(
                *(Option(harness_prompt(h), id=h) for h in self._harnesses),
                id="harness-list",
            )
            yield Checkbox("yolo", value=self._yolo_default, id="yolo-check")
            yield Static("j/k move  tab next  ⏎ create  esc cancel", classes="hint")

    def on_mount(self) -> None:
        hlist = self.query_one("#harness-list", OptionList)
        if self._default_harness in self._harnesses:
            try:
                hlist.highlighted = self._harnesses.index(self._default_harness)
            except ValueError:
                pass
        self._sync_harness_meta()
        self._sync_yolo()
        self.query_one("#branch-input", Input).focus()

    def _selected_harness(self) -> str:
        hlist = self.query_one("#harness-list", OptionList)
        opt = hlist.highlighted_option
        if opt and opt.id:
            return opt.id
        return self._default_harness

    def _sync_harness_meta(self) -> None:
        hlist = self.query_one("#harness-list", OptionList)
        selected = hlist.highlighted or 0
        self.query_one("#harness-meta", Static).update(
            f"harness  {selected + 1}/{len(self._harnesses)}"
        )

    def _sync_yolo(self) -> None:
        harness = self._selected_harness()
        yolo = self.query_one("#yolo-check", Checkbox)
        yolo.disabled = _HARNESS_YOLO.get(harness) is None

    def on_option_list_option_highlighted(
        self, event: OptionList.OptionHighlighted,
    ) -> None:
        if getattr(event.control, "id", None) == "harness-list":
            self._sync_harness_meta()
            self._sync_yolo()

    def on_option_list_option_selected(
        self, event: OptionList.OptionSelected,
    ) -> None:
        if getattr(event.control, "id", None) == "harness-list":
            self._sync_harness_meta()
            self._sync_yolo()
            return

    def on_input_submitted(self, event: Input.Submitted) -> None:
        if event.control.id == "branch-input":
            self.action_create()

    def action_cancel(self) -> None:
        self.dismiss(None)

    def action_cursor_down(self) -> None:
        if self.query_one("#harness-list", OptionList).has_focus:
            self.query_one("#harness-list", OptionList).action_cursor_down()

    def action_cursor_up(self) -> None:
        if self.query_one("#harness-list", OptionList).has_focus:
            self.query_one("#harness-list", OptionList).action_cursor_up()

    def action_toggle_yolo(self) -> None:
        yolo = self.query_one("#yolo-check", Checkbox)
        if yolo.has_focus and not yolo.disabled:
            yolo.toggle()

    def action_create(self) -> None:
        branch = self.query_one("#branch-input", Input).value.strip()
        if not branch:
            self.query_one("#branch-input", Input).focus()
            self.bell()
            return
        harness = self._selected_harness()
        yolo = self.query_one("#yolo-check", Checkbox).value
        final = build_harness_command(harness, yolo)
        self.dismiss({
            "branch": branch,
            "harness": final,
            "yolo": yolo,
        })


class Confirm(ModalScreen[bool]):
    BINDINGS = [
        Binding("y", "answer(True)", "yes"),
        Binding("n,escape", "answer(False)", "no"),
    ]

    def __init__(self, question: Text) -> None:
        super().__init__()
        self.question = question

    def compose(self) -> ComposeResult:
        with Vertical(classes="dialog"):
            yield Static(self.question)
            yield Static("y yes  n no", classes="hint")

    def action_answer(self, yes: bool) -> None:
        self.dismiss(yes)


class Help(ModalScreen[None]):
    BINDINGS = [Binding("escape,question_mark,q", "dismiss", "close")]

    def compose(self) -> ComposeResult:
        keys = Table.grid(padding=(0, 2))
        keys.add_column(no_wrap=True, style="bold")
        keys.add_column(no_wrap=True)
        keys.add_row("j/k", "Move")
        for action in ACTIONS:
            keys.add_row(action.label, action.title)
        keys.add_row("^p", "Search commands")

        legend = Text.assemble(
            ("#12", "bold"), "  pull request\n     ",
            ("open", PR_COLOR["OPEN"]), " ", ("draft", MUTED), " ",
            ("merged", PR_COLOR["MERGED"]), " ",
            ("closed", PR_COLOR["CLOSED"]), "\n",
            ("240k", "bold"), " context past\n     ",
            ("100k", CONTEXT_COLOR["warn"]), " ",
            ("400k", CONTEXT_COLOR["rot"]), " tokens\n",
            ("▌", "bold"), "    in this window\n",
            ("!", "bold red"), "    shares a working tree\n",
            ("◆ claude", agent_color("claude")), " ",
            ("◇ codex", agent_color("codex")), " ",
            ("⬢ opencode", agent_color("opencode")), " ",
            ("○ pi", agent_color("pi")), "  harness\n",
            ("★ chief", agent_color("chief")), " ",
            ("⬣ architect", agent_color("architect")), "  role · ",
            ("◆ claude · ★ chief", "default"), " both",
        )
        with Vertical(classes="dialog"):
            yield Static(Text("Keys", style="bold"))
            yield Static(keys)
            yield Static(legend, classes="legend")
            yield Static("esc close", classes="hint")

    async def action_dismiss(self, result: None = None) -> None:
        self.dismiss(result)


class AgentSidebar(App[None]):
    CSS = """
    Screen {
        layout: vertical;
    }
    #header {
        height: 1;
        padding: 0 1;
    }
    #header-rule {
        height: 1;
        color: ansi_bright_black;
    }
    OptionList {
        height: 1fr;
        max-height: 100%;
        border: none;
        padding: 0;
        background: ansi_default;
        scrollbar-size-vertical: 0;
        &:focus {
            border: none;
            background-tint: transparent;
        }
        & > .option-list--option {
            padding: 0 1 0 0;
        }
        & > .option-list--option-highlighted,
        &:focus > .option-list--option-highlighted {
            color: ansi_default;
            background: $cursor;
            text-style: none;
        }
        & > .option-list--option-disabled {
            color: ansi_default;
        }
        & > .option-list--separator {
            color: ansi_bright_black;
        }
    }
    #empty {
        height: 1fr;
        padding: 1 1;
        color: ansi_bright_black;
    }
    #footer {
        height: 1;
        padding: 0 1;
        color: ansi_bright_black;
    }
    ModalScreen {
        background: #181825;
        align: center middle;
    }
    .dialog {
        width: 100%;
        height: auto;
        padding: 1 2;
        background: #181825;
        border: round #45475a;
    }
    .dialog > Static {
        margin-bottom: 0;
    }
    .dialog-title {
        color: #cdd6f4;
        margin-bottom: 1;
    }
    .dialog > .hint {
        color: #a6adc8;
        margin-top: 1;
    }
    .field-label,
    .field-meta {
        height: 1;
        color: #a6adc8;
        text-style: bold;
    }
    .field-label {
        margin-top: 1;
    }
    .field-meta {
        color: #89b4fa;
        text-align: right;
    }
    #harness-list {
        height: 6;
        max-height: 6;
        margin-bottom: 1;
    }
    #harness-list:focus {
        border-left: thick #89b4fa;
        padding-left: 1;
        background: #313244;
    }
    #harness-list > .option-list--option-highlighted {
        color: #cdd6f4;
        background: #585b70;
        text-style: bold;
    }
    Checkbox {
        height: 3;
        margin-top: 1;
        margin-bottom: 1;
        background: #181825;
        border: round #45475a;
        color: #f9e2af;
        padding: 0 1;
        &:focus {
            border: round #89b4fa;
            background: #313244;
        }
        &:disabled {
            color: #6c7086;
        }
    }
    Input {
        height: 3;
        margin-bottom: 0;
        background: #181825;
        border: round #45475a;
        color: #cdd6f4;
        &:focus {
            border: round #89b4fa;
            background: #181825;
        }
    }
    """

    BINDINGS = [
        Binding("j", "cursor('down')", "down", show=False),
        Binding("k", "cursor('up')", "up", show=False),
        *(Binding(a.key, a.name, a.title, show=False) for a in ACTIONS),
    ]

    def __init__(
        self,
        scan: Callable[[], Awaitable[list[Row] | None]] = scan,
        panes_here: Callable[[], Awaitable[set[str]]] = panes_here,
        run: Callable[..., Awaitable[None]] = run,
        pull_requests: Callable[[str], Awaitable[PullRequests | None]] = (
            pull_requests
        ),
    ) -> None:
        super().__init__(ansi_color=True)
        self._scan = scan
        self._panes_here = panes_here
        self._run = run
        self._pull_requests = pull_requests
        self._wake = asyncio.Event()
        self._shown: str | None = None
        self._rows: list[Row] = []
        self._here: set[str] = set()
        self._by_pane: dict[str, Row] = {}
        self._states: dict[str, str] | None = None
        self._prs: dict[str, PullRequests] = {}
        self._prs_checked: dict[str, float] = {}

    def get_css_variables(self) -> dict[str, str]:
        # catppuccin mocha's surface0, the theme the terminal and tmux use.
        # No palette colour is that quiet: bright black under a muted
        # message leaves it unreadable.
        return super().get_css_variables() | {"cursor": "#313244"}

    def get_system_commands(self, screen: Screen) -> Iterable[SystemCommand]:
        for action in ACTIONS:
            if action.name != "help":
                yield SystemCommand(
                    f"{action.title} ({action.label})", action.help,
                    getattr(self, f"action_{action.name}"),
                )

    def compose(self) -> ComposeResult:
        yield Static(id="header")
        yield Static("─" * 200, id="header-rule")
        yield OptionList(id="agents")
        yield Static("No agents running", id="empty")
        yield Static(id="footer")

    def on_mount(self) -> None:
        self.query_one("#agents").display = False
        self.query_one("#empty").display = False
        self.show_header([], ok=True)
        self.run_worker(self.poll(), exclusive=True)

    async def poll(self) -> None:
        while True:
            await self.rescan()
            self._wake.clear()
            try:
                await asyncio.wait_for(self._wake.wait(), SCAN_INTERVAL)
            except TimeoutError:
                pass

    async def rescan(self) -> None:
        rows, here = await asyncio.gather(self._scan(), self._panes_here())
        if rows is None:
            # Keep what is on screen; a list that blinks empty on one bad
            # scan is worse than one that is a second old.
            self.show_header(self._rows, ok=False)
            return
        self._rows, self._here = rows, here
        self.show_header(rows, ok=True)
        self.announce(rows, here)
        self.refresh_pull_requests(rows)
        self.show_rows()

    def announce(self, rows: list[Row], here: set[str]) -> None:
        """Say on the status line when an agent elsewhere stops for you."""
        states = {row["pane_id"]: row["state"] for row in rows}
        previous, self._states = self._states, states
        # The first scan has no before; everything in it would announce.
        if previous is None:
            return
        for row in rows:
            if (previous.get(row["pane_id"]) in BUSY
                    and row["state"] in ATTENTION
                    and row["pane_id"] not in here):
                self.run_worker(self._run(
                    "tmux", "display-message", "-d", "5000", announcement(row),
                ))

    def refresh_pull_requests(self, rows: list[Row]) -> None:
        now = time.monotonic()
        for project, group in group_by_project(rows):
            if now - self._prs_checked.get(project, -PR_INTERVAL) < PR_INTERVAL:
                continue
            self._prs_checked[project] = now
            self.run_worker(self.fetch_pull_requests(project, group[0]["cwd"]))

    async def fetch_pull_requests(self, project: str, cwd: str) -> None:
        # A project gh cannot see simply shows no pull requests.
        self._prs[project] = await self._pull_requests(cwd) or {}
        self.show_rows()

    def show_header(self, rows: list[Row], ok: bool) -> None:
        title = Table.grid(expand=True)
        title.add_column(ratio=1, no_wrap=True)
        title.add_column(justify="right", no_wrap=True)
        title.add_row(Text("Agents", style="bold"), summary(rows))
        self.query_one("#header", Static).update(title)
        hints = "⏎ jump  ? help  q close"
        self.query_one("#footer", Static).update(
            hints if ok else Text("scan failed, retrying", style="yellow")
        )

    def pull_request(self, row: Row) -> dict[str, Any] | None:
        return self._prs.get(row["project"], {}).get(row["branch"])

    def show_rows(self) -> None:
        rows, here = self._rows, self._here
        key = json.dumps([rows, sorted(here), self._prs], sort_keys=True)
        if key == self._shown:
            return
        first = self._shown is None
        self._shown = key
        self._by_pane = {row["pane_id"]: row for row in rows}

        agents = self.query_one("#agents", OptionList)
        agents.display = bool(rows)
        self.query_one("#empty").display = not rows

        previous = agents.highlighted_option
        options: list[Option | None] = []
        for index, (project, group) in enumerate(group_by_project(rows)):
            if index:
                options.append(None)
            options.append(Option(
                project_prompt(project, len(group)),
                id=PROJECT_PREFIX + project,
                disabled=True,
            ))
            options.extend(
                Option(agent_prompt(row, row["pane_id"] in here,
                                    self.pull_request(row)),
                       id=row["pane_id"])
                for row in group
            )
        agents.set_options(options)

        ids = [row["pane_id"] for row in rows]
        # The same agent stays under the cursor as rows reorder. On the first
        # scan there is nothing to keep, so start on where you already are.
        target = previous.id if previous is not None and not first else None
        if target not in ids:
            target = next((i for i in ids if i in here), ids[0] if ids else None)
        if target is not None:
            agents.highlighted = agents.get_option_index(target)

    def selected(self) -> Row | None:
        option = self.query_one("#agents", OptionList).highlighted_option
        if option is None or option.id is None:
            return None
        return self._by_pane.get(option.id)

    def on_agent(self, act: Callable[[Row], None]) -> None:
        row = self.selected()
        if row is None:
            self.bell()
            return
        act(row)

    def glue(self, *args: str) -> None:
        # In a worker: most actions hold a popup open for as long as you use
        # it, and the list keeps scanning meanwhile.
        self.run_worker(self._run(GLUE, *args))

    def on_option_list_option_selected(
        self, event: OptionList.OptionSelected,
    ) -> None:
        # Only jumps from the main agents list; modal prompts (e.g. harness
        # selection) handle their own OptionSelected.
        try:
            control_id = event.control.id  # type: ignore[attr-defined]
        except AttributeError:
            control_id = None
        if control_id is not None and control_id != "agents":
            return
        self.action_jump()

    def action_jump(self) -> None:
        # switch-client to a pane lands on its session, window and the pane
        # itself; the sidebar follows through tmux's hooks.
        self.on_agent(lambda row: self.run_worker(
            self._run("tmux", "switch-client", "-t", row["pane_id"])
        ))

    def action_new_worktree(self) -> None:
        def ask(row: Row) -> None:
            def create(result: dict | None) -> None:
                if not result:
                    return
                branch = result["branch"]
                harness = result["harness"]
                self.glue("new-worktree", row["pane_id"], branch, harness)
            self.push_screen(
                NewWorktreePrompt(row["project"], row.get("cwd")),
                create,
            )
        self.on_agent(ask)

    def action_open(self) -> None:
        self.glue("open")

    def action_review(self) -> None:
        self.on_agent(lambda row: self.glue("review", row["pane_id"]))

    def action_git(self) -> None:
        self.on_agent(lambda row: self.glue("git", row["pane_id"]))

    def action_pr(self) -> None:
        self.on_agent(lambda row: self.glue("pr", row["pane_id"]))

    def action_kill(self) -> None:
        def ask(row: Row) -> None:
            def kill(yes: bool | None) -> None:
                if yes:
                    self.glue("kill", row["pane_id"])
            harness, role = _harness_and_role(row)
            who = f"{harness} · {role}" if role else harness
            question = Text.assemble(
                "Kill ", (who or row["agent"], "bold"), " in ",
                (f"{row['project']}/{row['branch']}", "bold"), "?",
            )
            self.push_screen(Confirm(question), kill)
        self.on_agent(ask)

    def action_remove_worktree(self) -> None:
        self.on_agent(lambda row: self.glue("remove-worktree", row["pane_id"]))

    def action_help(self) -> None:
        self.push_screen(Help())

    def action_cursor(self, direction: str) -> None:
        agents = self.query_one("#agents", OptionList)
        if direction == "down":
            agents.action_cursor_down()
        else:
            agents.action_cursor_up()

    def action_rescan(self) -> None:
        self._wake.set()

    async def action_back(self) -> None:
        pane = os.environ.get("TMUX_PANE", "")
        await self._run(
            "sh", "-c",
            'tmux last-pane 2>/dev/null || tmux select-pane -R -t "$1"',
            "sh", pane,
        )

    async def action_close(self) -> None:
        await self._run(GLUE, "close")


if __name__ == "__main__":
    AgentSidebar().run()
