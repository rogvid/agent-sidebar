    ]

    def __init__(
        self,
        scan: Callable[[], Awaitable[list[Row] | None]] = scan,
        panes_here: Callable[[], Awaitable[set[str]]] = panes_here,
        run: Callable[..., Awaitable[None]] = run,
        pull_requests: Callable[[str], Awaitable[PullRequests | None]] = (
            pull_requests
        ),
        accounts: Callable[[], list[tuple[str, str]]] = accounts,
        usage: Callable[[], Awaitable[dict[str, dict[str, Any]]]] = usage,
