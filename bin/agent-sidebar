#!/usr/bin/env -S uv run --script
# vim: set ft=python:
# -*- mode: python -*-
# language: python
# /// script
# requires-python = ">=3.13"
# dependencies = [
#   "textual==8.2.8",
# ]
# ///
"""agent-sidebar - agent-scan as a sidebar, one group per project.

Runs in the pane agent-sidebar-tmux keeps down the left of the window you
are looking at (M-2). Every second it reads `agent-scan --json` and lists
the agents under the project they are working in.

Projects keep agent-scan's queue order: the project holding the agent that
most needs you comes first, and inside a project the agents keep their
order too. Read top-down, it is still a queue.

A bar in the gutter marks the agents in the window you are looking at. On
an agent's second line, `#12` is its branch's pull request, coloured by
state, and a context size appears once the session is far enough along
that its early turns are fading.

Actions work on the highlighted agent, mostly in a tmux popup over the
current window: `?` lists them and ctrl+p searches them. When an agent in
another window stops and needs you, tmux says so on the status line.

`m` switches to the messages agent-msg carries between agents, newest
first, and back. The highlighted message shows in place, up to ten lines;
`t` pages through all of it and the rest of its thread in a popup, and `⏎`
jumps to the pane it went to. `✉2` on an agent says two messages to it are
unread. The sidebar only reads agent-msg's log: a message is marked read
when its receiver verifies it or reads its inbox with --mark-read.

With many agents open, `h` folds a project into one line that counts its
agents by state, and `c` puts an agent on one line. Both are remembered in
$XDG_STATE_HOME/agent-sidebar/state.json for the next sidebar.

Settings, and a `hide` list of tmux sessions whose agents it leaves out,
are in ${XDG_CONFIG_HOME:-~/.config}/agent-sidebar/config.toml (see
agent-sidebar-config). When that file is broken it says so in red and runs
as if there were none.

At the bottom, each Claude account a running agent is on shows how much of
its 5 hour and weekly limits is used, and when each resets. Claude Code
hands those only to its statusline, so agent-usage-tap has to sit in front
of the statusline command to keep them; without it every account says it
has seen no usage yet.
"""

from __future__ import annotations

import asyncio
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import time
from collections import Counter, deque
from collections.abc import Awaitable, Callable, Iterable
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Any

from rich.console import Group
from rich.table import Table
from rich.text import Text
from textual.app import App, ComposeResult, SystemCommand
from textual.binding import Binding
from textual.containers import Vertical
from textual.screen import ModalScreen, Screen
from textual.widgets import (
    Checkbox,
    ContentSwitcher,
    Input,
    OptionList,
    Static,
)
from textual.widgets.option_list import Option

Row = dict[str, Any]
# Branch name -> {"number", "state", "draft"} for one repository.
PullRequests = dict[str, dict[str, Any]]

SCAN_INTERVAL = 1.0
# Pull requests change over minutes, and each look is a round trip to
# GitHub per project.
PR_INTERVAL = 120.0
# agent-usage-tap rewrites an account's limits at most every few seconds,
# and a percent a few seconds late costs nothing.
USAGE_INTERVAL = 10.0

# agent-scan's colours, as terminal palette names so the sidebar reads in
# the same theme as the panes beside it.
STATE_COLOR = {
    "blocked": "yellow",
    "interrupted": "magenta",
    "done": "green",
    "running": "blue",
    "delegated": "cyan",
}
STATE_ORDER = ("blocked", "interrupted", "done", "running", "delegated")
# A pane moving from working to one of these has stopped and is waiting on
# you, which is the moment worth interrupting you for.
BUSY = frozenset({"running", "delegated"})
ATTENTION = frozenset({"blocked", "interrupted", "done"})
PR_COLOR = {"OPEN": "green", "MERGED": "magenta", "CLOSED": "red"}
CONTEXT_COLOR = {"warn": "yellow", "rot": "red"}
MUTED = "color(245)"
HERE = "▌"
# The empty part of a usage meter: as quiet as the rules.
TRACK = "bright_black"
# The windows of an account's limits, and their labels.
WINDOWS = (("five_hour", "5h"), ("seven_day", "wk"))
# Where agent-scan starts warning about the weekly limit.
USAGE_WARN, USAGE_HIGH = 60, 85
# Unread messages, on an agent and in the messages view.
UNREAD = "✉"
# How many of the newest messages the messages view lists.
LATEST = 100
# How many lines of the highlighted message show in place; t shows the rest.
EXPANDED = 10

# Harness colours/icons are fixed; roles are the harness's --agent
# (opencode's build/plan or any custom one) and get a stable colour
# via hashing so no hardcoded role list is needed.
HARNESS_COLOR = {
    "claude": "cyan",
    "codex": "green",
    "opencode": "blue",
    "pi": "magenta",
}
HARNESS_ICON = {
    "claude": "◆",
    "codex": "◇",
    "opencode": "⬢",
    "pi": "○",
}
ROLE_PALETTE = ["yellow", "bright_magenta", "bright_cyan", "bright_yellow", "red"]
ROLE_ICON = "★"


def agent_color(agent: str) -> str:
    name = agent.lower()
    if name in HARNESS_COLOR:
        return HARNESS_COLOR[name]
    # Roles - stable hash so "build" always looks the same without hardcoding
    h = sum(ord(c) for c in name)  # simple stable hash, no random
    return ROLE_PALETTE[h % len(ROLE_PALETTE)] if name else MUTED


def agent_icon(agent: str) -> str:
    name = agent.lower()
    if name in HARNESS_ICON:
        return HARNESS_ICON[name]
    return ROLE_ICON if name else "●"

PROJECT_PREFIX = "project:"
GLUE = "agent-sidebar-tmux"


def load_config():
    """agent-sidebar-config, the one reader of the config file, from beside
    this script's real path: it is linked into ~/.local/bin on its own."""
    source = Path(__file__).resolve().with_name("agent-sidebar-config")
    loader = importlib.machinery.SourceFileLoader(
        "agent_sidebar_config", str(source))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


config = load_config()

# YOLO flag per harness when the checkbox is on (on by default).
# pi has no permission gate, so no flag and the checkbox is disabled.
_HARNESS_YOLO: dict[str, str] = {
    "claude": "--dangerously-skip-permissions",
    "codex": "--yolo",
    "opencode": "--auto",
}


def harnesses_for_project(cwd: str | None) -> list[str]:
    """The harnesses offered, the project's default among them and
    "none" (a worktree with no harness started) last. The default may be a
    full command; the list holds that same string so it can be
    highlighted."""
    options = list(config.get("harnesses"))
    for harness in (default_harness_for_project(cwd), config.get("agent"),
                    "none"):
        if harness not in options:
            options.append(harness)
    return options


def default_harness_for_project(cwd: str | None) -> str:
    return config.get("agent", cwd)


def yolo_default_for_project(cwd: str | None) -> bool:
    return config.get("yolo", cwd)


def account_listing() -> list[tuple[str, str, str]]:
    """Each harness's accounts besides its default, as (harness, name,
    folder): agent-sidebar-tmux finds them, for the sidebar and spawn alike."""
    try:
        listing = subprocess.run(
            [GLUE, "accounts"], capture_output=True, text=True, timeout=5,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    return [
        (fields[0], fields[1], fields[2])
        for fields in (line.split("\t") for line in listing.splitlines())
        if len(fields) >= 3
    ]


def accounts() -> list[tuple[str, str]]:
    """Each harness's accounts besides its default, as (harness, name)."""
    return [(harness, name) for harness, name, _ in account_listing()]


def account_folder(account: str, home: Path | None = None) -> str:
    """The folder of a Claude account, as agent-scan reports it ("" for the
    default) and agent-usage-tap keys it."""
    home = home or Path.home()
    return os.path.realpath(os.path.expanduser(account) if account
                            else home / ".claude")


def plan(config: Path) -> str:
    """The account's plan ("max", "pro") from its .claude.json, "" when it
    does not say."""
    try:
        data = json.loads(config.read_text())
        kind = data["oauthAccount"]["organizationType"]
    except (OSError, ValueError, KeyError, TypeError):
        return ""
    return kind.removeprefix("claude_") if isinstance(kind, str) else ""


def _window(value: Any) -> dict[str, float] | None:
    if not isinstance(value, dict):
        return None
    used, resets = value.get("used_percentage"), value.get("resets_at")
    if not all(isinstance(v, (int, float)) for v in (used, resets)):
        return None
    return {"used_percentage": used, "resets_at": resets}


def read_usage(
    home: Path, state: Path, listing: list[tuple[str, str, str]],
) -> dict[str, dict[str, Any]]:
    """Each Claude account by folder: its name, its plan, and whether
    agent-usage-tap has kept its limits, with them when it has."""
    default = account_folder("", home)
    names = {default: "claude"} | {
        account_folder(folder, home): f"claude ({name})"
        for harness, name, folder in listing if harness == "claude"
    }
    found: dict[str, dict[str, Any]] = {}
    for file in sorted(state.glob("claude-*.json")):
        try:
            data = json.loads(file.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(data, dict) and isinstance(data.get("folder"), str):
            found[data["folder"]] = data
    usage: dict[str, dict[str, Any]] = {}
    for folder in names.keys() | found.keys():
        # Claude keeps the default account's .claude.json beside its folder.
        config = (home / ".claude.json" if folder == default
                  else Path(folder) / ".claude.json")
        record: dict[str, Any] = {
            "name": names.get(folder, f"claude ({Path(folder).name})"),
            "plan": plan(config),
            "seen": folder in found,
        }
        if folder in found:
            record |= {key: _window(found[folder].get(key))
                       for key, _ in WINDOWS}
        usage[folder] = record
    return usage


def usage_path() -> Path:
    return state_path().parent / "usage"


async def usage() -> dict[str, dict[str, Any]]:
    """read_usage for this user, off the event loop: it asks
    agent-sidebar-tmux for the accounts' names."""
    return await asyncio.to_thread(
        lambda: read_usage(Path.home(), usage_path(), account_listing())
    )


def build_harness_command(harness: str, yolo: bool) -> str:
    """Final command typed into the new session. "none" and full commands
    (e.g. "touch agent-started") have no yolo flag and pass through."""
    flag = _HARNESS_YOLO.get(harness)
    return f"{harness} {flag}" if yolo and flag else harness


def harness_prompt(harness: str, account: str | None = None) -> Text:
    if harness == "none":
        label = "no harness"
        icon = "·"
        style = MUTED
    else:
        label = harness if account is None else f"{harness} ({account})"
        icon = agent_icon(harness)
        style = agent_color(harness)
    return Text.assemble((f"{icon} ", style), (label, style))


@dataclass(frozen=True)
class Action:
    """One thing the sidebar does: its key, help line and palette entry."""

    name: str
    key: str
    label: str
    title: str
    help: str


ACTIONS = (
