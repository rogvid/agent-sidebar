# What still makes sense in the messages view; the rest act on the agent
# under a cursor that is not on screen.
MESSAGE_ACTIONS = frozenset(
    {"jump", "messages", "thread", "open", "config", "rescan", "back",
     "close", "help"})
AGENT_ACTIONS = frozenset(a.name for a in ACTIONS) - MESSAGE_ACTIONS
# And what makes sense only there.
MESSAGE_ONLY = frozenset({"thread"})


# Opposites share a line in the help, so it still fits a short pane.
HELP_PAIRS = {
    "collapse": ("expand", "Collapse/expand project"),
    "collapse_all": ("expand_all", "Collapse/expand all"),
    "compact": ("compact_all", "One line: agent/all"),
}


def group_by_project(rows: list[Row]) -> list[tuple[str, list[Row]]]:
    """Rows grouped by project, groups in order of their first row."""
    groups: dict[str, list[Row]] = {}
    for row in rows:
        groups.setdefault(row["project"], []).append(row)
    return list(groups.items())


def grid() -> Table:
    table = Table.grid(expand=True)
    table.add_column(width=1, no_wrap=True)
    table.add_column(width=2, no_wrap=True)
    table.add_column(ratio=1, no_wrap=True, overflow="ellipsis")
    table.add_column(justify="right", no_wrap=True)
    return table


def badges(row: Row, pr: dict[str, Any] | None) -> Text:
    """The pull request and, once it matters, the context size."""
    text = Text()
    if pr is not None:
        draft = pr.get("draft") and pr["state"] == "OPEN"
        color = MUTED if draft else PR_COLOR.get(pr["state"], MUTED)
        text.append(f"#{pr['number']}", style=color)
    level = row.get("context_level")
    if level in CONTEXT_COLOR:
        if text:
            text.append(" ")
        text.append(row["context"], style=CONTEXT_COLOR[level])
    return text


def _harness_and_role(row: Row) -> tuple[str, str]:
    """Return (harness, role) with backwards compat for old rows."""
    harness = row.get("harness") or row.get("agent") or ""
    role = row.get("role") or ""
    # Old rows where agent is already the role but harness missing handled above.
    # If role equals harness (e.g. no role, or role-as-harness fallback), hide role.
    if role and role.lower() == harness.lower():
        role = ""
    return harness, role


def _agent_display(row: Row) -> Text:
    harness, role = _harness_and_role(row)
    if not harness:
        return Text("")
    h_color = agent_color(harness)
    h_icon = agent_icon(harness)
    if role:
        r_color = agent_color(role)
        r_icon = agent_icon(role)
        return Text.assemble(
            (f"{h_icon} {harness}", h_color),
            (" · ", MUTED),
            (f"{r_icon} {role}", r_color),
        )
    return Text(f"{h_icon} {harness}", style=h_color)


def _changes_display(changes: str) -> Text:
    """`+5 -2` with colours, `∅` muted when clean, empty when unknown."""
    if not changes or changes == "-":
        return Text("")
    if changes == "∅":
        return Text("∅", style=MUTED)
    # `+5 -2` or `+3 untracked`
    text = Text()
    parts = changes.split()
    for i, part in enumerate(parts):
        if i:
            text.append(" ")
        if part.startswith("+"):
            text.append(part, style="green")
        elif part.startswith("-"):
            text.append(part, style="red")
        else:
            text.append(part, style=MUTED)
    return text


def mail(unread: int) -> Text:
    """`✉2` for unread messages, with a space before it; none, nothing."""
    return Text(f" {UNREAD}{unread}", style="bold") if unread else Text("")


def agent_prompt(
    row: Row, here: bool, pr: dict[str, Any] | None = None, unread: int = 0,
) -> Group:
    """Three lines: branch/unread/changes, agent/harness with
    duration/context, state/message."""
    color = STATE_COLOR.get(row["state"], "default")
    gutter = Text(HERE if here else " ", style="bold")

    # Row 1: state dot + branch on the left, +- changes on the right
    top = grid()
    branch = Text(row["branch"])
    # Two agents in one working tree overwrite each other's edits.
    if row.get("flag", " ").strip():
        branch = Text.assemble(("! ", "bold red"), branch)
    changes = _changes_display(row.get("changes", "-"))
    # A branch cut short would otherwise run into its changes.
    if changes.plain:
        changes = Text.assemble(" ", changes)
    changes = Text.assemble(mail(unread), changes)
    top.add_row(
        gutter,
        Text("●", style=color),
        branch,
        changes,
    )

    # Row 2: agent + harness on the left, duration + context on the right
    middle = grid()
    agent = _agent_display(row)
    duration = "" if row.get("duration") == "-" else row.get("duration", "")
    extra = badges(row, pr)
    right = Text()
    if duration:
        right.append(duration)
    if extra.plain:
        if right.plain:
            right.append(" ")
        right.append(extra)
    middle.add_row(
        gutter,
        Text(""),
        agent,
        right,
    )

    # Row 3: state on the left, message on the right (message takes most)
    bottom = Table.grid(expand=True)
    bottom.add_column(width=1, no_wrap=True)
    bottom.add_column(width=2, no_wrap=True)
    bottom.add_column(no_wrap=True)
    bottom.add_column(ratio=1, no_wrap=True, overflow="ellipsis")
    message = "" if row.get("message") == "-" else row.get("message", "")
    message_text = Text(" " + message, style=MUTED) if message else Text("")
    bottom.add_row(
        gutter,
        Text(""),
        Text(row.get("state", ""), style=color),
        message_text,
    )
    return Group(top, middle, bottom)


def project_prompt(project: str, count: int) -> Table:
    """The project's name, lined up with the state dots under it."""
    table = Table.grid(expand=True)
    table.add_column(width=1, no_wrap=True)
    table.add_column(ratio=1, no_wrap=True, overflow="ellipsis")
    table.add_column(justify="right", no_wrap=True)
    table.add_row(
        Text(""),
        Text(project, style="bold"),
        Text(f" {count}", style=MUTED),
    )
    return table


def compact_prompt(row: Row, here: bool, unread: int = 0) -> Table:
    """One line: the branch, its unread messages and its state."""
    color = STATE_COLOR.get(row["state"], "default")
    branch = Text(row["branch"])
    if row.get("flag", " ").strip():
        branch = Text.assemble(("! ", "bold red"), branch)
    table = grid()
    table.add_row(
        Text(HERE if here else " ", style="bold"),
        Text("●", style=color),
        branch,
        Text.assemble(mail(unread), (" " + row.get("state", ""), color)),
    )
    return table


def collapsed_prompt(
    project: str, group: list[Row], here: bool, unread: int = 0,
) -> Table:
    """A folded project: its name, its agents' unread messages, and its
    agents counted by state."""
    table = Table.grid(expand=True)
    table.add_column(width=1, no_wrap=True)
    table.add_column(ratio=1, no_wrap=True, overflow="ellipsis")
    table.add_column(justify="right", no_wrap=True)
    table.add_row(
        Text(HERE if here else "", style="bold"),
        Text(project, style="bold"),
        Text.assemble(mail(unread), " ", summary(group)),
    )
    return table


def countdown(seconds: float) -> str | None:
    """`42m`, `3h40m`, `2d22h` until a reset, None once it has passed."""
    if seconds <= 0:
        return None
    minutes = max(1, int(seconds // 60))
    days, minutes = divmod(minutes, 24 * 60)
    hours, minutes = divmod(minutes, 60)
    if days:
        return f"{days}d{hours}h"
    return f"{hours}h{minutes}m" if hours else f"{minutes}m"


def usage_color(used: float) -> str:
    if used >= USAGE_HIGH:
        return "red"
    return "yellow" if used >= USAGE_WARN else "green"


def meter(used: float, width: int, color: str | None = None) -> Text:
    """A bar width cells wide, filled to the nearest cell."""
    filled = min(width, max(0, round(width * used / 100)))
    return Text.assemble(("━" * filled, color or usage_color(used)),
                         ("━" * (width - filled), TRACK))


class Meter:
    """A meter as wide as the column it lands in; None is all track."""

    def __init__(self, used: float | None) -> None:
        self.used = used

    def __rich_console__(self, console: Any, options: Any) -> Iterable[Text]:
        yield meter(self.used or 0, options.max_width)


def usage_prompt(
    accounts: list[dict[str, Any]], now: float,
) -> Group:
    """Per account: its name and plan, then each window's meter, percent
    used and time to reset, or that no usage has been seen yet."""
    lines: list[Table | Text] = []
    for account in accounts:
        head = Table.grid(expand=True)
        head.add_column(ratio=1, no_wrap=True, overflow="ellipsis")
        head.add_column(justify="right", no_wrap=True)
        head.add_row(
            Text.assemble((f"{agent_icon('claude')} ", agent_color("claude")),
                          (account["name"], agent_color("claude"))),
            Text(f" {account['plan']}" if account["plan"] else "",
                 style=MUTED),
        )
        lines.append(head)
        if not account["seen"]:
            lines.append(Text("  no usage seen yet", style=MUTED))
            continue
        for key, label in WINDOWS:
            window = account.get(key)
            left = window and countdown(window["resets_at"] - now)
            # A window past its reset has started over at a number nobody
            # has seen yet.
            used = window["used_percentage"] if left else None
            row = Table.grid(expand=True)
            row.add_column(width=5, no_wrap=True)
            row.add_column(ratio=1, no_wrap=True)
            row.add_column(width=5, no_wrap=True)
            row.add_column(width=9, justify="right", no_wrap=True)
            row.add_row(
                Text(f"  {label} ", style=MUTED),
                Meter(used),
                # The dash under the digits, where a number would be.
                Text(f"{used:.0f}%".rjust(5) if used is not None
                     else "   - ",
                     style=usage_color(used) if used is not None else MUTED),
                Text(f"↻ {left or 'reset':>5}" if window else "",
                     style=MUTED),
            )
            lines.append(row)
    return Group(*lines)


def state_path() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser(
        "~/.local/state"
    )
    return Path(base) / "agent-sidebar" / "state.json"


def load_state(path: Path) -> tuple[set[str], set[str]]:
    """The folded projects, and the panes of agents on one line."""
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return set(), set()
    if not isinstance(data, dict):
        return set(), set()

    def names(key: str) -> set[str]:
        value = data.get(key)
        if isinstance(value, list) and all(isinstance(v, str) for v in value):
            return set(value)
        return set()

    return names("collapsed"), names("compact")


def save_state(path: Path, collapsed: set[str], compact: set[str]) -> None:
    state = {"collapsed": sorted(collapsed), "compact": sorted(compact)}
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        # Replaced whole, so a sidebar starting meanwhile never reads half.
        partial = path.with_suffix(".partial")
        partial.write_text(json.dumps(state) + "\n")
        partial.replace(path)
    except OSError:
        # Forgetting the folds next time beats a sidebar that falls over.
        pass


class Tail:
    """A file only ever appended to, read a whole line at a time: each call
    hands the lines added since the last, and a line still being written
    waits for the next call."""

    def __init__(self, path: Path) -> None:
        self.path = path
        self.rewind()

    def rewind(self) -> None:
        self._file: tuple[int, int] | None = None
        self._offset = 0

    def lines(self) -> list[bytes] | None:
        """The new lines, or None when the file was replaced or cut short
        since the last call: it has to be read again from the start."""
        try:
            with self.path.open("rb") as file:
                stat = os.fstat(file.fileno())
                identity = (stat.st_dev, stat.st_ino)
                if self._file is not None and (
                        identity != self._file or stat.st_size < self._offset):
                    return None
                self._file = identity
                if stat.st_size == self._offset:
                    return []
                file.seek(self._offset)
                chunk = file.read(stat.st_size - self._offset)
        except FileNotFoundError:
            return None if self._file is not None else []
        whole = chunk.rfind(b"\n") + 1
        self._offset += whole
        return chunk[:whole].splitlines()


def json_objects(lines: Iterable[bytes]) -> Iterable[dict[str, Any]]:
    """The lines that are a JSON object with an id, as agent-msg reads them."""
    for line in lines:
        try:
            value = json.loads(line)
        except ValueError:
            continue
        if isinstance(value, dict) and isinstance(value.get("id"), int):
            yield value


def address(end: Any) -> tuple[str, str]:
    """A message's from or to as (session, pane)."""
    if not isinstance(end, dict):
        return "", ""
    return str(end.get("session") or ""), str(end.get("pane") or "")


class MessageLog:
    """agent-msg's log, as the sidebar needs it: the newest messages, and
    where the unread ones went. Read, never written: messages-read.jsonl is
    agent-msg inbox's to keep. Each refresh reads only the lines added
    since the last, so a long log costs once, when the sidebar starts."""

    def __init__(self, folder: Path) -> None:
        self._sent = Tail(folder / "messages.jsonl")
        self._read = Tail(folder / "messages-read.jsonl")
        self.clear()

    def clear(self) -> None:
        self.latest: deque[Row] = deque(maxlen=LATEST)
        self.read: set[int] = set()
        # Each unread message's recipient, by id.
        self.unread: dict[int, tuple[str, str]] = {}

    def refresh(self) -> bool:
        """Take in what was added; whether anything was."""
        sent, read = self._sent.lines(), self._read.lines()
        if sent is None or read is None:
            self._sent.rewind()
            self._read.rewind()
            self.clear()
            sent, read = self._sent.lines() or [], self._read.lines() or []
            changed = True
        else:
            changed = bool(sent or read)
        for message in json_objects(sent):
            self.latest.append(message)
            if message["id"] not in self.read:
                self.unread[message["id"]] = address(message.get("to"))
        for mark in json_objects(read):
            self.read.add(mark["id"])
            self.unread.pop(mark["id"], None)
        return changed

    def inbox(self, panes: dict[str, str]) -> dict[str, set[int]]:
        """The unread messages in each live pane's inbox, given every
        pane's session: by agent-msg's own rule (its `mine`), what was sent
        to the pane in its session, and what was sent to a pane of its
        session that is gone. test-agent-sidebar checks the two agree."""
        live: dict[str, set[str]] = {}
        for pane, session in panes.items():
            live.setdefault(session, set()).add(pane)
        inbox: dict[str, set[int]] = {}
        for message, (session, pane) in self.unread.items():
            if panes.get(pane) == session:
                inbox.setdefault(pane, set()).add(message)
            else:
                for heir in live.get(session, ()):
                    inbox.setdefault(heir, set()).add(message)
        return inbox


def age(seconds: float) -> str:
    """`<1m`, `5m`, `3h`, `2d` since a message was sent."""
    minutes = int(seconds // 60)
    if minutes < 1:
        return "<1m"
    if minutes < 60:
        return f"{minutes}m"
    return f"{minutes // 60}h" if minutes < 24 * 60 else f"{minutes // 1440}d"


def sent_at(message: Row) -> float | None:
    try:
        return datetime.fromisoformat(message["time"]).timestamp()
    except (KeyError, TypeError, ValueError):
        return None


class Address:
    """`session %pane`, the session cut short so the pane always shows."""

    def __init__(self, end: Any, style: str = "") -> None:
        self.session, self.pane = address(end)
        self.style = style

    def __rich_console__(self, console: Any, options: Any) -> Iterable[Text]:
        pane = f" {self.pane}" if self.pane else ""
        session = Text(self.session or "?", style=self.style)
        session.truncate(max(1, options.max_width - len(pane)),
                         overflow="ellipsis")
        yield Text.assemble(session, (pane, MUTED))


class Clipped:
    """Text wrapped to the column it lands in, at most so many lines of it:
    a long message would push every other one off the list."""

    def __init__(self, text: Text, lines: int) -> None:
        self.text = text
        self.lines = lines

    def __rich_console__(self, console: Any, options: Any) -> Iterable[Text]:
        lines = self.text.wrap(console, options.max_width, overflow="fold")
        yield from lines[:self.lines]
        if len(lines) > self.lines:
            yield Text(f"… {len(lines) - self.lines} more lines, t shows all",
                       style=MUTED, no_wrap=True, overflow="ellipsis")


def message_prompt(
    message: Row, unread: bool, now: float, full: bool = False,
) -> Group:
    """Who sent it, to whom, and its first line, or when full as much of
    it as fits in place."""
    sent = sent_at(message)
    top = grid()
    top.add_row(
        Text(""),
        Text(UNREAD, style="bold") if unread else Text(""),
        Address(message.get("from"), style="bold" if unread else ""),
        Text(f" #{message['id']}" + (f" {age(now - sent)}" if sent else ""),
             style=MUTED),
    )
    middle = grid()
    reply_to = message.get("reply_to")
    middle.add_row(
        Text(""),
        Text("→", style=MUTED),
        Address(message.get("to")),
        Text(f" re #{reply_to}" if reply_to else "", style=MUTED),
    )
    text = str(message.get("text") or "").strip()
    body = Table.grid(expand=True)
    body.add_column(width=3, no_wrap=True)
    if full:
        body.add_column(ratio=1)
        body.add_row(Text(""), Clipped(Text(text), EXPANDED))
    else:
        body.add_column(ratio=1, no_wrap=True, overflow="ellipsis")
        body.add_row(Text(""), Text(text.split("\n")[0], style=MUTED))
    return Group(top, middle, body)


def summary(rows: list[Row]) -> Text:
    """One coloured count per state that has agents in it."""
    counts = Counter(row["state"] for row in rows)
    parts: list[tuple[str, str] | str] = []
    for state in STATE_ORDER:
        if counts[state]:
            if parts:
                parts.append(" ")
            parts.append((f"● {counts[state]}", STATE_COLOR[state]))
    return Text.assemble(*parts)


def announcement(row: Row) -> str:
    """The status line message for an agent that stopped and needs you."""
    message = "" if row["message"] == "-" else f": {row['message']}"
    # display-message expands formats, and a message quoting `#12` or `#{`
    # would otherwise be read as one.
    return f"{row['project']}/{row['branch']} {row['state']}{message}".replace(
        "#", "##"
    )


async def tmux(*args: str) -> str | None:
    proc = await asyncio.create_subprocess_exec(
        "tmux", *args,
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    out, _ = await proc.communicate()
    return out.decode() if proc.returncode == 0 else None


async def scan() -> list[Row] | None:
    """agent-scan's rows, or None when the scan failed."""
    try:
        proc = await asyncio.create_subprocess_exec(
            "agent-scan", "--json",
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        )
    except OSError:
        return None
    out, _ = await proc.communicate()
    if proc.returncode != 0:
        return None
    try:
        rows = json.loads(out)
    except json.JSONDecodeError:
        return None
    return rows if isinstance(rows, list) else None


def config_error() -> str | None:
    """What is wrong with the config file, None when nothing is. Without
    the file's path: that would fill the sidebar, and
    `agent-sidebar-config check` has it."""
    error = config.load()[1]
    return error and error.removeprefix(f"{config.path()}: ")


async def panes_here() -> set[str]:
    """The panes sharing a window with this one."""
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return set()
    out = await tmux("list-panes", "-t", pane, "-F", "#{pane_id}")
    return set(out.split()) if out else set()


async def all_panes() -> dict[str, str]:
    """Every pane's session, by pane id."""
    out = await tmux("list-panes", "-a", "-F", "#{pane_id}\t#{session_name}")
    return dict(
        line.split("\t", 1) for line in (out or "").splitlines() if "\t" in line
    )


async def pull_requests(cwd: str) -> PullRequests | None:
    """The newest pull request per branch of cwd's repository, or None
    when gh cannot say (not on GitHub, offline, not logged in)."""
    try:
        proc = await asyncio.create_subprocess_exec(
            "gh", "pr", "list", "--state", "all", "--limit", "100",
            "--json", "headRefName,number,state,isDraft",
            cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        )
    except OSError:
        return None
    out, _ = await proc.communicate()
    if proc.returncode != 0:
        return None
    try:
        listed = json.loads(out)
    except json.JSONDecodeError:
        return None
    prs: PullRequests = {}
    # gh lists the newest first, and a branch reused for a second PR should
    # show that one.
    for pr in listed:
        prs.setdefault(pr["headRefName"], {
            "number": pr["number"],
            "state": pr["state"],
            "draft": pr.get("isDraft", False),
        })
    return prs


async def run(*command: str) -> None:
    proc = await asyncio.create_subprocess_exec(
        *command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    await proc.wait()


class NewWorktreePrompt(ModalScreen[dict | None]):
    """Single modal: branch + harness + yolo.

    Tab moves focus (Input → harness → yolo).  ⏎ creates from any
    field, esc cancels.  YOLO is on by default; per-project default harness
    comes from `git config agent-sidebar.harness`. A harness with accounts
    besides its default has them listed just before it, and its plain
    entry is its default account.
    """

    BINDINGS = [
        Binding("escape", "cancel", "cancel"),
        # priority, so the list's select and the checkbox's toggle
        # don't take it first
        Binding("enter", "create", "create", priority=True),
        Binding("j", "cursor_down", "down", show=False),
        Binding("k", "cursor_up", "up", show=False),
    ]

    def __init__(
        self, project: str, project_cwd: str | None = None,
        accounts: Iterable[tuple[str, str]] = (),
    ) -> None:
        super().__init__()
        self.project = project
        self.project_cwd = project_cwd
        self._default_harness = default_harness_for_project(project_cwd)
        self._yolo_default = yolo_default_for_project(project_cwd)
        # Each entry's harness and account, None for the default one.
        self._choices: dict[str, tuple[str, str | None]] = {}
        accounts = sorted(accounts)
        for harness in harnesses_for_project(project_cwd):
            for owner, name in accounts:
                if owner == harness:
                    self._choices[f"{harness} ({name})"] = (harness, name)
            self._choices[harness] = (harness, None)

    def compose(self) -> ComposeResult:
        with Vertical(classes="dialog"):
            yield Static(Text.assemble(
                "New worktree  ", (self.project, "bold"),
            ), classes="dialog-title")
            yield Input(placeholder="feat/branch-name", id="branch-input")
            yield OptionList(
                *(Option(harness_prompt(*choice), id=key)
                  for key, choice in self._choices.items()),
                id="harness-list",
            )
            yield Checkbox("yolo", value=self._yolo_default, id="yolo-check")
            # Two lines on purpose: one would wrap mid-hint in the sidebar.
            yield Static("j/k move  tab next\n⏎ create  esc cancel",
                         classes="hint")

    def on_mount(self) -> None:
        hlist = self.query_one("#harness-list", OptionList)
        hlist.highlighted = list(self._choices).index(self._default_harness)
        self._sync_yolo()
        self.query_one("#branch-input", Input).focus()

    def _selected(self) -> tuple[str, str | None]:
        hlist = self.query_one("#harness-list", OptionList)
        opt = hlist.highlighted_option
        if opt and opt.id:
            return self._choices[opt.id]
        return self._default_harness, None

    def _sync_yolo(self) -> None:
        harness, _ = self._selected()
        yolo = self.query_one("#yolo-check", Checkbox)
        yolo.disabled = _HARNESS_YOLO.get(harness) is None

    def on_option_list_option_highlighted(
        self, event: OptionList.OptionHighlighted,
    ) -> None:
        if getattr(event.control, "id", None) == "harness-list":
            self._sync_yolo()

    def on_option_list_option_selected(
        self, event: OptionList.OptionSelected,
    ) -> None:
        if getattr(event.control, "id", None) == "harness-list":
            self._sync_yolo()
            return

    def action_cancel(self) -> None:
        self.dismiss(None)

    def action_cursor_down(self) -> None:
        if self.query_one("#harness-list", OptionList).has_focus:
            self.query_one("#harness-list", OptionList).action_cursor_down()

    def action_cursor_up(self) -> None:
        if self.query_one("#harness-list", OptionList).has_focus:
            self.query_one("#harness-list", OptionList).action_cursor_up()

    def action_create(self) -> None:
        branch = self.query_one("#branch-input", Input).value.strip()
        if not branch:
            self.query_one("#branch-input", Input).focus()
            self.app.bell()
            return
        harness, account = self._selected()
        yolo = self.query_one("#yolo-check", Checkbox).value
        final = build_harness_command(harness, yolo)
        self.dismiss({
            "branch": branch,
            "harness": final,
            "account": account,
            "yolo": yolo,
        })


class Confirm(ModalScreen[bool]):
    BINDINGS = [
        Binding("y", "answer(True)", "yes"),
        Binding("n,escape", "answer(False)", "no"),
    ]

    def __init__(self, question: Text) -> None:
        super().__init__()
        self.question = question

    def compose(self) -> ComposeResult:
        with Vertical(classes="dialog"):
            yield Static(self.question)
            yield Static("y yes  n no", classes="hint")

    def action_answer(self, yes: bool) -> None:
        self.dismiss(yes)


class Help(ModalScreen[None]):
    """The keys of the view on screen, and what the symbols mean. In a
    short pane it scrolls, with j/k too."""

    BINDINGS = [
        Binding("escape,question_mark,q", "dismiss", "close"),
        Binding("j,down", "scroll_down", "down", show=False),
        Binding("k,up", "scroll_up", "up", show=False),
    ]

    def compose(self) -> ComposeResult:
        keys = Table.grid(padding=(0, 2))
        keys.add_column(no_wrap=True, style="bold")
        keys.add_column(no_wrap=True)
        keys.add_row("j/k", "Move")
        by_name = {action.name: action for action in ACTIONS}
        seconds = {second for second, _ in HELP_PAIRS.values()}
        for action in ACTIONS:
            if not self.app.check_action(action.name, ()):
                continue
            if action.name in HELP_PAIRS:
                second, title = HELP_PAIRS[action.name]
                keys.add_row(f"{action.label}/{by_name[second].label}", title)
            elif action.name not in seconds:
                keys.add_row(action.label, action.title)
        keys.add_row("^p", "Search commands")

        legend = Text.assemble(
            ("#12", "bold"), "  pull request\n     ",
            ("open", PR_COLOR["OPEN"]), " ", ("draft", MUTED), " ",
            ("merged", PR_COLOR["MERGED"]), " ",
            ("closed", PR_COLOR["CLOSED"]), "\n",
            ("240k", "bold"), " context past\n     ",
            ("100k", CONTEXT_COLOR["warn"]), " ",
            ("400k", CONTEXT_COLOR["rot"]), " tokens\n",
            ("▌", "bold"), "    in this window\n",
            ("!", "bold red"), "    shares a working tree\n",
            (f"{UNREAD}2", "bold"), "   unread messages\n",
        )
        # Drawn the way rows draw them so the legend cannot drift.
        first, *others = HARNESS_ICON
        legend.append_text(_agent_display({"harness": first}))
        legend.append("  harness\n    ")
        for harness in others:
            legend.append(" ")
            legend.append_text(_agent_display({"harness": harness}))
        legend.append("\n")
        legend.append_text(_agent_display({"harness": "opencode", "role": "build"}))
        legend.append("  agent")
        with Vertical(classes="dialog"):
            yield Static(Text("Keys", style="bold"))
            yield Static(keys)
            yield Static(Text("Symbols", style="bold"), classes="legend-title")
            yield Static(legend, classes="legend")
            yield Static("esc close", classes="hint")

    async def action_dismiss(self, result: None = None) -> None:
        self.dismiss(result)


