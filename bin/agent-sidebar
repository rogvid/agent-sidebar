        self._run = run
        self._pull_requests = pull_requests
        self._accounts = accounts
        self._usage = usage
        self._config_error = config_error
        # Each Claude account's usage by folder, None until first read.
        self._usage_by_folder: dict[str, dict[str, Any]] | None = None
        self._usage_checked = -USAGE_INTERVAL
        self._usage_shown: str | None = None
        self._wake = asyncio.Event()
        self._shown: str | None = None
        self._rows: list[Row] = []
        self._here: set[str] = set()
        self._by_pane: dict[str, Row] = {}
        self._states: dict[str, str] | None = None
        self._prs: dict[str, PullRequests] = {}
        self._prs_checked: dict[str, float] = {}
        self._state = state or state_path()
        self._collapsed, self._compact = load_state(self._state)
        self._panes = panes
        self._log = MessageLog(messages or self._state.parent)
        # The unread messages in each agent's inbox.
        self._inbox: dict[str, set[int]] = {}
        self._view = "agents"
        self._messages_shown: str | None = None
        # The messages listed, by option id, and which of them are unread.
        self._by_message: dict[str, Row] = {}
        self._unread_listed: set[str] = set()
        self._expanded: str | None = None

    def get_css_variables(self) -> dict[str, str]:
        # catppuccin mocha's surface0, the theme the terminal and tmux use.
        # No palette colour is that quiet: bright black under a muted
        # message leaves it unreadable.
        return super().get_css_variables() | {"cursor": "#313244"}

    def get_system_commands(self, screen: Screen) -> Iterable[SystemCommand]:
        for action in ACTIONS:
            if action.name != "help" and self.check_action(action.name, ()):
                yield SystemCommand(
                    f"{action.title} ({action.label})", action.help,
                    getattr(self, f"action_{action.name}"),
                )

    def check_action(self, action: str, parameters: tuple[object, ...]) -> bool:
        """Only the actions of the view on screen: its keys, the help and
        the command palette all ask."""
        if self._view == "messages":
            return action not in AGENT_ACTIONS
        return action not in MESSAGE_ONLY

    def compose(self) -> ComposeResult:
        yield Static(id="header")
        yield Static("─" * 200, id="header-rule")
        yield Static(id="config-error")
        with ContentSwitcher(initial="agents-view"):
            with Vertical(id="agents-view"):
                yield OptionList(id="agents")
                yield Static("No agents running", id="empty")
            with Vertical(id="messages-view"):
                yield OptionList(id="messages")
                yield Static("No messages yet", id="no-messages")
        yield Static("─" * 200, id="usage-rule")
        yield Static(id="usage")
        yield Static(id="footer")

    def on_mount(self) -> None:
        self.query_one("#agents").display = False
        self.query_one("#config-error").display = False
        self.query_one("#empty").display = False
        self.query_one("#messages").display = False
        self.query_one("#no-messages").display = False
        self.query_one("#usage-rule").display = False
        self.query_one("#usage").display = False
        self.show_header([], ok=True)
        self.run_worker(self.poll(), exclusive=True)

    async def poll(self) -> None:
        while True:
            await self.rescan()
            self._wake.clear()
            try:
                await asyncio.wait_for(self._wake.wait(), SCAN_INTERVAL)
            except TimeoutError:
                pass

    async def rescan(self) -> None:
        rows, here, _ = await asyncio.gather(
            self._scan(), self._panes_here(),
            asyncio.to_thread(self._log.refresh),
        )
        # Whose inbox a message is in takes every pane's session, which is
        # worth asking tmux for only while something is unread.
        self._inbox = (self._log.inbox(await self._panes())
                       if self._log.unread else {})
        self.show_messages()
        self.show_config_error(self._config_error())
        if rows is None:
            # Keep what is on screen; a list that blinks empty on one bad
            # scan is worse than one that is a second old.
            self.show_header(self._rows, ok=False)
            return
        # Hidden agents are left out before anything else looks: the
        # header's counts, the announcements, the usage overview.
        rows = [row for row in rows if not row.get("hidden")]
        self._rows, self._here = rows, here
        self.show_header(rows, ok=True)
        self.announce(rows, here)
        self.refresh_pull_requests(rows)
        self.show_rows()
        self.refresh_usage()
        self.show_usage()

    def announce(self, rows: list[Row], here: set[str]) -> None:
        """Say on the status line when an agent elsewhere stops for you."""
        states = {row["pane_id"]: row["state"] for row in rows}
        previous, self._states = self._states, states
        # The first scan has no before; everything in it would announce.
        if previous is None:
            return
        for row in rows:
            if (previous.get(row["pane_id"]) in BUSY
                    and row["state"] in ATTENTION
                    and row["pane_id"] not in here):
                self.run_worker(self._run(
                    "tmux", "display-message", "-d", "5000", announcement(row),
                ))

    def refresh_pull_requests(self, rows: list[Row]) -> None:
        now = time.monotonic()
        for project, group in group_by_project(rows):
            if now - self._prs_checked.get(project, -PR_INTERVAL) < PR_INTERVAL:
                continue
            self._prs_checked[project] = now
            self.run_worker(self.fetch_pull_requests(project, group[0]["cwd"]))

    async def fetch_pull_requests(self, project: str, cwd: str) -> None:
        # A project gh cannot see simply shows no pull requests.
        self._prs[project] = await self._pull_requests(cwd) or {}
        self.show_rows()

    def refresh_usage(self) -> None:
        now = time.monotonic()
        if now - self._usage_checked < USAGE_INTERVAL:
            return
        self._usage_checked = now
        self.run_worker(self.fetch_usage())

    async def fetch_usage(self) -> None:
        self._usage_by_folder = await self._usage()
        self.show_usage()

    def show_usage(self) -> None:
        """The overview for each Claude account a running agent is on, the
        default first; nothing without one."""
        folders = {
            account_folder(row.get("account", ""))
            for row in self._rows
            if _harness_and_role(row)[0] == "claude"
        }
        known = self._usage_by_folder or {}
        accounts = sorted(
            (known.get(folder)
             or {"name": f"claude ({Path(folder).name})", "plan": "",
                 "seen": False}
             for folder in folders),
            key=lambda account: (account["name"] != "claude",
                                 account["name"]),
        ) if self._usage_by_folder is not None else []
        now = time.time()
        # Redraw only when an account or a countdown changes.
        left = [countdown(window["resets_at"] - now)
                for account in accounts for key, _ in WINDOWS
                if (window := account.get(key))]
        key = json.dumps([accounts, left], sort_keys=True)
        if key == self._usage_shown:
            return
        self._usage_shown = key
        self.query_one("#usage-rule").display = bool(accounts)
        usage = self.query_one("#usage", Static)
        usage.display = bool(accounts)
        usage.update(usage_prompt(accounts, now))

    def show_config_error(self, error: str | None) -> None:
        widget = self.query_one("#config-error", Static)
        widget.display = error is not None
        if error is not None:
            widget.update(f"config.toml ignored: {error}")

    def show_header(self, rows: list[Row], ok: bool) -> None:
        title = Table.grid(expand=True)
        title.add_column(ratio=1, no_wrap=True)
        title.add_column(justify="right", no_wrap=True)
        if self._view == "messages":
            unread = len(self._log.unread)
            title.add_row(
                Text("Messages", style="bold"),
                Text(f"{UNREAD} {unread}" if unread else "", style="bold"),
            )
            hints = "⏎ jump  m agents  ? help"
        else:
            title.add_row(Text("Agents", style="bold"), summary(rows))
            hints = "⏎ jump  m messages  ? help"
        self.query_one("#header", Static).update(title)
        self.query_one("#footer", Static).update(
            hints if ok else Text("scan failed, retrying", style="yellow")
        )

    def pull_request(self, row: Row) -> dict[str, Any] | None:
        return self._prs.get(row["project"], {}).get(row["branch"])

    def show_rows(self) -> None:
        rows, here = self._rows, self._here
        key = json.dumps(
            [rows, sorted(here), self._prs, sorted(self._collapsed),
             sorted(self._compact),
             {pane: sorted(ids) for pane, ids in self._inbox.items()}],
            sort_keys=True,
        )
        if key == self._shown:
            return
        first = self._shown is None
        self._shown = key
        self._by_pane = {row["pane_id"]: row for row in rows}

        agents = self.query_one("#agents", OptionList)
        agents.display = bool(rows)
        self.query_one("#empty").display = not rows

        previous = agents.highlighted_option
        options: list[Option | None] = []
        # The line the cursor lands on for each agent and project: a folded
        # project's one line stands in for its agents, and an unfolded
        # project's header, which the cursor skips, for its first agent.
        line: dict[str, str] = {}
        folded_before = False
        for index, (project, group) in enumerate(group_by_project(rows)):
            folded = project in self._collapsed
            # Folded projects in a row read as one list, so no rule between.
            if index and not (folded and folded_before):
                options.append(None)
            folded_before = folded
            project_id = PROJECT_PREFIX + project
            if folded:
                options.append(Option(
                    collapsed_prompt(
                        project, group,
                        any(row["pane_id"] in here for row in group),
                        # A message to a gone pane is in the inbox of every
                        # agent in its session, and counts once here.
                        len(set().union(*(self._inbox.get(row["pane_id"], ())
                                          for row in group))),
                    ),
                    id=project_id,
                ))
                line |= dict.fromkeys(
                    [project_id, *(row["pane_id"] for row in group)],
                    project_id,
                )
                continue
            options.append(Option(
                project_prompt(project, len(group)),
                id=project_id,
                disabled=True,
            ))
            options.extend(
                Option(self.agent_prompt(row, row["pane_id"] in here),
                       id=row["pane_id"])
                for row in group
            )
            line[project_id] = group[0]["pane_id"]
            line |= {row["pane_id"]: row["pane_id"] for row in group}
        agents.set_options(options)

        ids = [row["pane_id"] for row in rows]
        # The same agent stays under the cursor as rows reorder or its
        # project folds. On the first scan there is nothing to keep, so start
        # on where you already are.
        target = previous.id if previous is not None and not first else None
        if target not in line:
            target = next((i for i in ids if i in here), ids[0] if ids else None)
        if target is not None:
            agents.highlighted = agents.get_option_index(line[target])

    def agent_prompt(self, row: Row, here: bool) -> Group | Table:
        unread = len(self._inbox.get(row["pane_id"], ()))
        if row["pane_id"] in self._compact:
            return compact_prompt(row, here, unread)
        return agent_prompt(row, here, self.pull_request(row), unread)

    def show_view(self, view: str) -> None:
        self._view = view
        self.query_one(ContentSwitcher).current = f"{view}-view"
        # Start on the newest message each time.
        self._messages_shown = None
        self._expanded = None
        self.query_one("#messages", OptionList).highlighted = None
        self.show_messages()
        self.show_header(self._rows, ok=True)
        self.query_one(f"#{view}", OptionList).focus()

    def show_messages(self) -> None:
        """The newest messages first, the highlighted one in full."""
        if self._view != "messages":
            return
        now = time.time()
        messages: dict[str, Row] = {}
        for message in reversed(self._log.latest):
            messages.setdefault(str(message["id"]), message)
        unread = {key for key in messages if int(key) not in self._log.read}
        # Redraw when a message comes, is read, or ages a minute.
        key = json.dumps([[key, key in unread, sent_at(message) and
                           age(now - sent_at(message))]
                          for key, message in messages.items()])
        if key == self._messages_shown:
            return
        self._messages_shown = key
        self._by_message, self._unread_listed = messages, unread

        listing = self.query_one("#messages", OptionList)
        listing.display = bool(messages)
        self.query_one("#no-messages").display = not messages
        previous = listing.highlighted_option
        target = previous.id if previous is not None else None
        if target not in messages:
            target = next(iter(messages), None)
        self._expanded = target
        options: list[Option | None] = []
        for key, message in messages.items():
            # A rule between messages, or the three lines of each run into
            # the next.
            if options:
                options.append(None)
            options.append(Option(message_prompt(message, key in unread, now,
                                                 full=key == target), id=key))
        listing.set_options(options)
        if target is not None:
            listing.highlighted = listing.get_option_index(target)

    def message_option(self, key: str, full: bool) -> None:
        message = self._by_message.get(key)
        if message is not None:
            self.query_one("#messages", OptionList).replace_option_prompt(
                key, message_prompt(message, key in self._unread_listed,
                                    time.time(), full=full))

    def on_option_list_option_highlighted(
        self, event: OptionList.OptionHighlighted,
    ) -> None:
        key = event.option.id
        if event.option_list.id != "messages" or key == self._expanded:
            return
        if self._expanded is not None:
            self.message_option(self._expanded, full=False)
        self._expanded = key
        if key is not None:
            self.message_option(key, full=True)
            self.call_after_refresh(event.option_list.scroll_to_highlight)

    def selected(self) -> Row | None:
        option = self.query_one("#agents", OptionList).highlighted_option
        if option is None or option.id is None:
            return None
        return self._by_pane.get(option.id)

    def project(self) -> str | None:
        """The project under the cursor, folded or not."""
        option = self.query_one("#agents", OptionList).highlighted_option
        if option is None or option.id is None:
            return None
        if option.id.startswith(PROJECT_PREFIX):
            return option.id.removeprefix(PROJECT_PREFIX)
        row = self._by_pane.get(option.id)
        return row["project"] if row else None

    def on_agent(
        self, act: Callable[[Row], None], or_project: bool = False,
    ) -> None:
        row = self.selected()
        # On a folded project, its first agent stands in for actions on
        # the project itself.
        if row is None and or_project:
            project = self.project()
            row = next((r for r in self._rows if r["project"] == project),
                       None)
        if row is None:
            self.bell()
            return
        act(row)

    def glue(self, *args: str) -> None:
        # In a worker: most actions hold a popup open for as long as you use
        # it, and the list keeps scanning meanwhile.
        self.run_worker(self._run(GLUE, *args))

    def on_option_list_option_selected(
        self, event: OptionList.OptionSelected,
    ) -> None:
        # Only jumps from the main agents list; modal prompts (e.g. harness
        # selection) handle their own OptionSelected.
        try:
            control_id = event.control.id  # type: ignore[attr-defined]
        except AttributeError:
            control_id = None
        if control_id is not None and control_id not in ("agents", "messages"):
            return
        self.action_jump()

    def action_jump(self) -> None:
        if self._view == "messages":
            option = self.query_one("#messages", OptionList).highlighted_option
            message = option and option.id and self._by_message.get(option.id)
            if not message:
                self.bell()
                return
            self.run_worker(self.jump_to(message))
            return
        if self.selected() is None and self.project() in self._collapsed:
            self.action_expand()
            return
        # switch-client to a pane lands on its session, window and the pane
        # itself; the sidebar follows through tmux's hooks.
        self.on_agent(lambda row: self.run_worker(
            self._run("tmux", "switch-client", "-t", row["pane_id"])
        ))

    async def jump_to(self, message: Row) -> None:
        """To the pane a message went to; when that is gone, to its session,
        which by agent-msg's rule has its mail."""
        session, pane = address(message.get("to"))
        panes = await self._panes()
        if panes.get(pane) == session:
            target = pane
        elif session in panes.values():
            target = f"={session}"
        else:
            self.bell()
            return
        await self._run("tmux", "switch-client", "-t", target)

    def action_thread(self) -> None:
        option = self.query_one("#messages", OptionList).highlighted_option
        if option is None or option.id not in self._by_message:
            self.bell()
            return
        self.glue("thread", option.id)

    def action_messages(self) -> None:
        self.show_view("agents" if self._view == "messages" else "messages")

    def action_new_worktree(self) -> None:
        def ask(row: Row) -> None:
            def create(result: dict | None) -> None:
                if not result:
                    return
                account = result["account"]
                self.glue(
                    "new-worktree", row["pane_id"], result["branch"],
                    result["harness"],
                    *(("--account", account) if account else ()),
                )
            self.push_screen(
                NewWorktreePrompt(row["project"], row.get("cwd"),
                                  self._accounts()),
                create,
            )
        self.on_agent(ask, or_project=True)

    def action_open(self) -> None:
        self.glue("open")

    def action_review(self) -> None:
        self.on_agent(lambda row: self.glue("review", row["pane_id"]))

    def action_git(self) -> None:
        self.on_agent(lambda row: self.glue("git", row["pane_id"]))

    def action_pr(self) -> None:
        self.on_agent(lambda row: self.glue("pr", row["pane_id"]))

    def action_kill(self) -> None:
        def ask(row: Row) -> None:
            def kill(yes: bool | None) -> None:
                if yes:
                    self.glue("kill", row["pane_id"])
            harness, role = _harness_and_role(row)
            who = f"{harness} · {role}" if role else harness
            question = Text.assemble(
                "Kill ", (who or row["agent"], "bold"), " in ",
                (f"{row['project']}/{row['branch']}", "bold"), "?",
            )
            self.push_screen(Confirm(question), kill)
        self.on_agent(ask)

    def action_remove_worktree(self) -> None:
        self.on_agent(lambda row: self.glue("remove-worktree", row["pane_id"]))

    def remember(
        self, collapsed: set[str] | None = None,
        compact: set[str] | None = None,
    ) -> None:
        if collapsed is not None:
            self._collapsed = collapsed
        if compact is not None:
            # A pane id dies with its pane, and tmux hands it out again
            # after a restart, so only agents still running are kept.
            self._compact = compact & self._by_pane.keys()
        save_state(self._state, self._collapsed, self._compact)
        self.show_rows()

    def action_collapse(self) -> None:
        project = self.project()
        if project is None:
            self.bell()
            return
        self.remember(collapsed=self._collapsed | {project})

    def action_expand(self) -> None:
        project = self.project()
        if project is None:
            self.bell()
            return
        self.remember(collapsed=self._collapsed - {project})

    def action_collapse_all(self) -> None:
        projects = {project for project, _ in group_by_project(self._rows)}
        self.remember(collapsed=self._collapsed | projects)

    def action_expand_all(self) -> None:
        self.remember(collapsed=set())

    def action_compact(self) -> None:
        self.on_agent(
            lambda row: self.remember(compact=self._compact ^ {row["pane_id"]})
        )

    def action_compact_all(self) -> None:
        panes = self._by_pane.keys()
        if panes <= self._compact:
            self.remember(compact=self._compact - panes)
        else:
            self.remember(compact=self._compact | panes)

    def action_help(self) -> None:
        self.push_screen(Help())

    def action_cursor(self, direction: str) -> None:
        listing = self.query_one(f"#{self._view}", OptionList)
        if direction == "down":
            listing.action_cursor_down()
        else:
            listing.action_cursor_up()

    def action_config(self) -> None:
        async def edit() -> None:
            await self._run(GLUE, "config")
            # What changed shows now, not at the next tick.
            self._wake.set()
        self.run_worker(edit())

    def action_rescan(self) -> None:
        self._wake.set()

    async def action_back(self) -> None:
        if self._view == "messages":
            self.show_view("agents")
            return
        pane = os.environ.get("TMUX_PANE", "")
        await self._run(
            "sh", "-c",
            'tmux last-pane 2>/dev/null || tmux select-pane -R -t "$1"',
            "sh", pane,
        )

    async def action_close(self) -> None:
        await self._run(GLUE, "close")


if __name__ == "__main__":
    AgentSidebar().run()
