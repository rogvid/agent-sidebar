#!/usr/bin/env -S uv run --script
# vim: set ft=python:
# -*- mode: python -*-
# language: python
# /// script
# requires-python = ">=3.13"
# dependencies = []
# ///
"""agent-sidebar-config - the agent-sidebar settings, from one place.

Settings live in ${XDG_CONFIG_HOME:-~/.config}/agent-sidebar/config.toml.
Every setting is optional, and so is the file:

  hide       tmux session names whose agents the sidebar and the status
             bar leave out; shell globs (`scratch-*`) match too
  harnesses  the harnesses the new-worktree dialog offers
  agent      the default harness, or a whole command
  yolo       whether the dialog's yolo checkbox starts ticked
  width      the sidebar's width in columns
  command    what runs in the sidebar pane

For each setting the first of these that has it wins: the project's
`git config agent-sidebar.harness` / `agent-sidebar.yolo` (agent and yolo,
in the sidebar's dialog only), its AGENT_SIDEBAR_<NAME> variable (not
hide), the file, the default.

A file that is not valid TOML, or that has a key or a type this does not
know, is ignored as a whole rather than half applied: everything falls back
to the variables and defaults, and the sidebar and the status bar say the
file is broken until it is fixed.

This is the one reader of that file. agent-scan and agent-sidebar load it
as a module; agent-sidebar-tmux, in bash, runs it.

Usage: agent-sidebar-config get NAME...   each setting, one a line
       agent-sidebar-config check         say what is wrong with the file,
                                          exit 1 if anything is
       agent-sidebar-config path          where the file is
"""

from __future__ import annotations

import os
import subprocess
import sys
import tomllib
from collections.abc import Iterable, Mapping
from fnmatch import fnmatchcase
from pathlib import Path
from typing import Any

DEFAULTS: dict[str, Any] = {
    "hide": [],
    "harnesses": ["claude", "codex", "opencode", "pi"],
    "agent": "claude",
    "yolo": True,
    "width": 36,
    "command": "agent-sidebar",
}
# hide has no variable: it names sessions, and which sessions are yours is
# a thing to write down once, not to export.
VARIABLES = {
    "harnesses": "AGENT_SIDEBAR_HARNESSES",
    "agent": "AGENT_SIDEBAR_AGENT",
    "yolo": "AGENT_SIDEBAR_YOLO",
    "width": "AGENT_SIDEBAR_WIDTH",
    "command": "AGENT_SIDEBAR_COMMAND",
}
# Per project, set with `git config` in the repository.
GIT_KEYS = {
    "agent": "agent-sidebar.harness",
    "yolo": "agent-sidebar.yolo",
}
FALSE = frozenset({"0", "false", "no", "off"})


class ConfigError(Exception):
    """The file is there but cannot be used."""


def path(env: Mapping[str, str] = os.environ) -> Path:
    base = env.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return Path(base) / "agent-sidebar" / "config.toml"


def _check(key: str, value: Any) -> None:
    """Raise ConfigError unless value is what key takes."""
    if key not in DEFAULTS:
        raise ConfigError(f"unknown setting {key!r}")
    kind = type(DEFAULTS[key])
    if kind is list:
        if not isinstance(value, list) or not all(
            isinstance(item, str) and item for item in value
        ):
            raise ConfigError(f"{key} must be a list of names")
        if key == "harnesses" and not value:
            raise ConfigError("harnesses must name at least one harness")
    elif kind is bool:
        if not isinstance(value, bool):
            raise ConfigError(f"{key} must be true or false")
    elif kind is int:
        # TOML's true is a Python int too.
        if isinstance(value, bool) or not isinstance(value, int) or value < 1:
            raise ConfigError(f"{key} must be a whole number above 0")
    # bash reads the answers a line each, so a value may not span two.
    elif not isinstance(value, str) or not value or "\n" in value:
        raise ConfigError(f"{key} must be one line of text")


def read(file: Path | None = None) -> dict[str, Any]:
    """The file's settings; none when there is no file. Raises ConfigError
    when it is broken, naming the file and what is wrong."""
    file = file or path()
    try:
        with file.open("rb") as handle:
            data = tomllib.load(handle)
    except FileNotFoundError:
        return {}
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise ConfigError(f"{file}: {error}") from None
    try:
        for key, value in data.items():
            _check(key, value)
    except ConfigError as error:
        raise ConfigError(f"{file}: {error}") from None
    return data


def load(file: Path | None = None) -> tuple[dict[str, Any], str | None]:
    """The file's settings and what is wrong with it: no settings at all
    when anything is."""
    try:
        return read(file), None
    except ConfigError as error:
        return {}, str(error)


def _git_config(cwd: str, key: str) -> str | None:
    try:
        proc = subprocess.run(
            ["git", "config", "--get", key],
            cwd=cwd, capture_output=True, text=True, timeout=2,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    value = proc.stdout.strip()
    return value if proc.returncode == 0 and value else None


def _parse(key: str, raw: str) -> Any:
    """A variable's or git config's text as key's value, None when it
    cannot be one."""
    kind = type(DEFAULTS[key])
    if kind is list:
        # Space or comma separated; empty means unset.
        return raw.replace(",", " ").split() or None
    if kind is bool:
        return raw.strip().lower() not in FALSE
    if kind is int:
        try:
            value = int(raw)
        except ValueError:
            return None
        return value if value > 0 else None
    return raw or None


def get(
    key: str,
    cwd: str | None = None,
    settings: Mapping[str, Any] | None = None,
    env: Mapping[str, str] = os.environ,
) -> Any:
    """key's value. The project's git config counts only when cwd is
    given; settings are the file's, read afresh when not given."""
    if cwd and key in GIT_KEYS:
        raw = _git_config(cwd, GIT_KEYS[key])
        if raw is not None and (value := _parse(key, raw)) is not None:
            return value
    if key in VARIABLES and VARIABLES[key] in env:
        value = _parse(key, env[VARIABLES[key]])
        if value is not None:
            return value
    if settings is None:
        settings = load()[0]
    return settings.get(key, DEFAULTS[key])


def hidden(session: str, patterns: Iterable[str]) -> bool:
    """Whether a tmux session is one hide leaves out."""
    return any(fnmatchcase(session, pattern) for pattern in patterns)


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help", "help"):
        assert __doc__
        print(__doc__.strip())
        return 0
    command, names = (args[0], args[1:]) if args else ("", [])
    if command == "path" and not names:
        print(path())
        return 0
    if command == "check" and not names:
        _, error = load()
        if error:
            print(error, file=sys.stderr)
            return 1
        return 0
    if command == "get" and names:
        unknown = [name for name in names if name not in DEFAULTS]
        if unknown:
            print(f"agent-sidebar-config: no setting {unknown[0]!r}",
                  file=sys.stderr)
            return 2
        settings, error = load()
        if error:
            # Still answer: whoever asked has something to start.
            print(f"agent-sidebar-config: ignoring {error}", file=sys.stderr)
        for name in names:
            value = get(name, settings=settings)
            if isinstance(value, bool):
                value = "true" if value else "false"
            elif isinstance(value, list):
                value = " ".join(value)
            print(value)
        return 0
    print("Usage: agent-sidebar-config get NAME... | check | path",
          file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
