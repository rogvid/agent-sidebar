#!/usr/bin/env bash
# agent-sidebar-setup - set up the parts of agent-sidebar that live outside
# tmux. Safe to re-run; run it again after moving the plugin.
#
#   agent-sidebar-setup            make the changes
#   agent-sidebar-setup --check    say what it would change, touch nothing
#
# It does four things:
#
#   - Links the tools into ${XDG_BIN_HOME:-~/.local/bin}. tmux hands a new
#     pane the PATH of the terminal it was opened from, not its own, so the
#     PATH the plugin gives tmux reaches its keys and hooks but not the
#     agents in your panes, which run agent-scan and agent-msg by name.
#
#   - Links the agent-sidebar skill, which tells agents how to use
#     agent-scan and agent-msg, into ~/.agents/skills (Codex, OpenCode and
#     Pi read it there) and into the skills folder of every Claude Code
#     config folder (~/.claude and each ~/.claude-* profile). It is a link
#     to this plugin's copy, so it always matches the tools.
#
#   - Links the television channels into television's cable folder:
#     `tv agents` lists the agents, `tv projects` the git repositories to
#     open (the sidebar's o). Only when television is installed.
#
#   - Puts agent-usage-tap in front of each Claude Code statusline, in the
#     settings.json of each of those folders, so the sidebar can show how
#     much of each account's 5 hour and weekly limits is used. Claude Code
#     hands those only to its statusline. settings.json is Claude Code's
#     own, so only statusLine changes, and folders that link one
#     settings.json share one edit. Claude Code also runs outside tmux,
#     where this plugin is not on PATH, so the tap goes in by its path.
set -euo pipefail

bin="$(dirname "$(realpath "$0")")"
readonly bin
skill="$(dirname "${bin}")/skills/agent-sidebar"
readonly skill
channels="$(dirname "${bin}")/extras/television"
readonly channels
readonly cable="${XDG_CONFIG_HOME:-${HOME}/.config}/television/cable"
readonly user_bin="${XDG_BIN_HOME:-${HOME}/.local/bin}"
# The shell Claude Code runs the statusline in expands a leading ~.
readonly tap="${bin/#"${HOME}"/\~}/agent-usage-tap"
CHECK=0
case "${1:-}" in
    --check) CHECK=1 ;;
    "") ;;
    *) echo "Usage: agent-sidebar-setup [--check]" >&2; exit 2 ;;
esac

say() { printf '  %s\n' "$*"; }
head_() { printf '\n%s\n' "$*"; }
would() { ((CHECK)) && { say "would: $*"; return 1; }; return 0; }

claude_dirs() {
    local cfg
    for cfg in "${HOME}/.claude" "${HOME}"/.claude-*/; do
        cfg="${cfg%/}"
        [[ -d "${cfg}" ]] && printf '%s\n' "${cfg}"
    done
}

link_skill() {
    head_ "skill -> ~/.agents/skills and Claude Code config folders"
    local dir changed=0 dirs
    mapfile -t dirs < <(claude_dirs | sed 's|$|/skills|')
    for dir in "${HOME}/.agents/skills" "${dirs[@]}"; do
        link_to "${skill}" "${dir}/agent-sidebar"
    done
    ((changed)) || say "every skills folder links the plugin's skill"
}

# link_to SOURCE LINK: link LINK to SOURCE, unless something of the user's
# own is there. Sets changed when it had something to do.
link_to() {
    local source="$1" link="$2"
    [[ -L "${link}" && "$(realpath "${link}")" == "$(realpath "${source}")" ]] && return 0
    if [[ -e "${link}" && ! -L "${link}" ]]; then
        say "skipped  ${link} - not a link; remove it to use the plugin's"
        return 0
    fi
    changed=1
    would "link ${link}" || return 0
    mkdir -p "$(dirname "${link}")"
    ln -sfn "${source}" "${link}"
    say "linked   ${link}"
}

link_tools() {
    head_ "tools -> ${user_bin}"
    local tool changed=0
    for tool in "${bin}"/*; do
        [[ -f "${tool}" && -x "${tool}" ]] || continue
        link_to "${tool}" "${user_bin}/$(basename "${tool}")"
    done
    ((changed)) || say "every tool is linked"
    case ":${PATH}:" in
        *":${user_bin}:"*) ;;
        *) say "note: ${user_bin} is not on PATH; add it in your shell's rc file" ;;
    esac
}

link_channels() {
    head_ "television channels -> ${cable}"
    if ! command -v tv >/dev/null; then
        say "skipped - television (tv) is not installed"
        return 0
    fi
    local channel changed=0
    for channel in "${channels}"/*.toml; do
        link_to "${channel}" "${cable}/$(basename "${channel}")"
    done
    ((changed)) || say "every channel is linked"
}

wire_usage_tap() {
    head_ "agent-usage-tap -> Claude Code statusline"
    command -v jq >/dev/null || { say "skipped - needs jq"; return 0; }
    local cfg settings real current command first updated changed=0
    local -A seen=()
    while IFS= read -r cfg; do
        settings="${cfg}/settings.json"
        real="$(realpath -m "${settings}")"
        [[ -n "${seen[${real}]:-}" ]] && continue
        seen[${real}]=1
        current="$(cat "${real}" 2>/dev/null || echo '{}')"
        command="$(jq -r '.statusLine.command // ""' <<<"${current}" 2>/dev/null)" || {
            say "skipped  ${settings} - not valid JSON"
            continue
        }
        first="${command%% *}"
        [[ "${first}" == "${tap}" ]] && continue
        # A tap from elsewhere, or from where this plugin was before.
        if [[ "${first}" == agent-usage-tap || "${first}" == */agent-usage-tap ]]; then
            command="${command#"${first}"}"
            command="${command# }"
        fi
        # The tap execs its arguments, so only a plain command line survives
        # the prefix.
        if [[ -n "${command}" && ! "${command}" =~ ^[][A-Za-z0-9_./~=:@%+,\ -]+$ ]]; then
            say "skipped  ${settings} - put agent-usage-tap in front of its statusLine.command by hand"
            continue
        fi
        if [[ -z "${command}" && -e "${cfg}/statusline.sh" ]]; then
            command="${cfg/#"${HOME}"/\~}/statusline.sh"
        fi
        changed=1
        command="${tap}${command:+ }${command}"
        would "statusLine.command in ${settings}: ${command}" || continue
        updated="$(jq --arg command "${command}" '
            .statusLine = ({type: "command", padding: 1, refreshInterval: 10}
                           + (.statusLine // {}) + {command: $command})' <<<"${current}")"
        mkdir -p "$(dirname "${real}")"
        printf '%s\n' "${updated}" >"${real}.partial" && mv -f "${real}.partial" "${real}"
        say "wired    ${settings}"
    done < <(claude_dirs)
    ((changed)) || say "every Claude Code statusline runs through agent-usage-tap"
}

((CHECK)) && echo "check mode - nothing will be modified"
link_tools
link_skill
link_channels
wire_usage_tap
