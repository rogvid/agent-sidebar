#!/usr/bin/env bash
# agent-sidebar-tmux - keep one agent-sidebar pane down the left of the
# window you are looking at.
#
# tmux has no sidebar, only panes, and a pane lives in exactly one window.
# So there is one sidebar pane, and whenever the window you are looking at
# changes, a hook moves that pane into it with join-pane. The process keeps
# running; only the window around it changes.
#
# Usage: agent-sidebar-tmux COMMAND [ARGS]
#
#   toggle                   show the sidebar in this window, or close it if
#                            it is already here (M-2)
#   close                    close it until the next toggle
#   follow                   move it into the window you are looking at
#                            (hooks)
#   prune-resurrect FILE     drop it from a tmux-resurrect save file
#
# The sidebar's actions, each on an agent's pane:
#
#   new-worktree PANE BRANCH [HARNESS] [--account NAME]
#                            create a worktree of PANE's project, give it a
#                            session of its own and start HARNESS there
#                            (default: the agent setting, claude unless
#                            configured; "none" starts no harness), on
#                            HARNESS's account NAME
#   spawn PANE|DIR BRANCH [HARNESS] [--account NAME]
#                            new-worktree for an agent starting workers, or
#                            for you from any shell: no popup, you stay
#                            where you are, an existing session is refused,
#                            failures exit non-zero; prints the new
#                            session's pane id. Without --account the
#                            session keeps the caller's accounts.
#   accounts                 list each harness's accounts besides its
#                            default: harness, name and folder, tab
#                            separated
#   review PANE              review PANE's uncommitted changes in tuicr; its
#                            export (y) is pasted into PANE's input
#   git PANE                 lazygit in PANE's directory
#   pr PANE                  PANE's pull request, or offer to create one
#   kill PANE                kill PANE
#   remove-worktree PANE     remove PANE's worktree (git-wt-remove asks
#                            first), then PANE
#   open                     pick a git repository to open in its own
#                            session (tv projects)
#   config                   edit the settings file in nvim, in a popup
#                            that closes when nvim does
#   thread ID                agent-msg message ID and the rest of its
#                            thread in less, in a popup, opened at ID
#
# An account is a harness's config folder next to its default one, named by
# its suffix, when it holds a login: ~/.claude-NAME, ~/.codex-NAME,
# ~/.pi-NAME/agent. Accounts kept anywhere else go in
# ${XDG_CONFIG_HOME:-~/.config}/agent-sidebar/accounts, one
# "HARNESS NAME FOLDER" a line. A session started on an account keeps it
# for everything run in it.
#
# The sidebar's width, its command and the default harness are settings:
# see agent-sidebar-config.
#
# Whether the sidebar is wanted is the global @agent-sidebar-open option.
# The pane itself carries the pane option @agent-sidebar. Keeping the two
# apart is what lets follow bring a fresh sidebar back after the old one
# died with a window you killed.

set -euo pipefail

# resurrect saves panes with their title, which is how prune-resurrect
# recognises this one.
readonly title="agent-sidebar"

usage() {
    sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
}

# The one reader of the config file, from beside this script's real path:
# it is linked into ~/.local/bin on its own, and a script added since the
# last `mise bootstrap` is not linked yet.
config_reader="$(dirname "$(realpath "$0")")/agent-sidebar-config"
readonly config_reader
# agent-msg, from beside it the same way.
messenger="$(dirname "$(realpath "$0")")/agent-msg"
readonly messenger

# One setting, from the variables, the config file and the defaults. Asked
# only where it is needed: each ask starts Python.
#
# A broken config file is not reported here: the hooks run this in the
# background, and tmux would put the report over your pane on every window
# switch. The sidebar and the status bar say it instead.
setting() {
    local value
    value="$("${config_reader}" get "$1" 2>/dev/null)" || true
    if [[ -z "${value}" ]]; then
        echo "agent-sidebar-tmux: cannot read the $1 setting from" \
            "${config_reader}" >&2
        return 1
    fi
    echo "${value}"
}

# The sidebar's pane id, or nothing.
sidebar_pane() {
    tmux list-panes -a -F '#{pane_id} #{@agent-sidebar}' |
        awk '$2 == "1" { print $1; exit }'
}

# Whether a client runs inside one of this server's popups. A popup that
# attaches a nested client (M-1, M-3) is a client too, and it is the most
# recently active one while it is open, but you are looking through the
# client underneath it.
#
# A popup runs its command as the leader of a session of its own, on the
# popup's terminal, so a client in it has a session leader the server
# started. Asked of the session rather than of the client's parents: as a
# popup closes its shell goes first, and for that moment the client, still
# listed, has no parent that leads back to the server. Its session leader is
# gone by then, and so is a client that has exited.
in_popup() {
    local pid="$1" server_pid="$2" leader parent
    leader="$(ps -o sid= -p "${pid}" 2>/dev/null | tr -d ' ')"
    [[ -n "${leader}" ]] || return 0
    parent="$(ps -o ppid= -p "${leader}" 2>/dev/null | tr -d ' ')"
    [[ -z "${parent}" || "${parent}" == "${server_pid}" ]]
}

# "<window_id> <zoomed>" for the window you are looking at, or nothing when
# no client is attached.
#
# Asked of the client rather than taken from the hook's own format: in
# hooks such as pane-exited, #{window_id} names whatever window tmux picks
# as current, which is not necessarily the one on screen.
viewed_window() {
    local server_pid pid window zoomed
    local -a clients
    local client
    server_pid="$(tmux display-message -p '#{pid}')"
    mapfile -t clients < <(
        tmux list-clients -F \
            '#{client_activity} #{client_pid} #{window_id} #{window_zoomed_flag}' |
            sort -rn
    )
    for client in "${clients[@]}"; do
        read -r _ pid window zoomed <<<"${client}"
        if in_popup "${pid}" "${server_pid}"; then
            continue
        fi
        echo "${window} ${zoomed}"
        return 0
    done
}

# Start a sidebar WIDTH columns wide in a window without focusing it; print
# its pane id.
#
# COLORTERM because tmux does not set it, and without it textual rounds its
# colours to the 256 palette: the cursor row's quiet surface turns grey.
# tmux converts true colour for any terminal that lacks it, so it is safe.
open_in() {
    local window="$1" width="$2" pane sidebar_command
    sidebar_command="$(setting command)"
    pane="$(tmux split-window -hbf -l "${width}" -d -t "${window}" \
        -e COLORTERM=truecolor -P -F '#{pane_id}' "${sidebar_command}")"
    tmux set-option -p -t "${pane}" @agent-sidebar 1 \; \
        select-pane -t "${pane}" -T "${title}"
    echo "${pane}"
}

follow() {
    if [[ "$(tmux show-options -gqv @agent-sidebar-open)" != 1 ]]; then
        return 0
    fi
    local viewed window zoomed pane home panes pane_width width
    width="$(setting width)"
    viewed="$(viewed_window)"
    if [[ -z "${viewed}" ]]; then
        return 0
    fi
    read -r window zoomed <<<"${viewed}"
    pane="$(sidebar_pane)"

    if [[ -n "${pane}" ]]; then
        read -r home panes pane_width <<<"$(tmux display-message -p \
            -t "${pane}" '#{window_id} #{window_panes} #{pane_width}')"
        if ((panes == 1)); then
            # Everything it sat beside is gone and it is all that keeps the
            # window open. Letting the window go moves you somewhere else,
            # so ask again where that is.
            tmux kill-pane -t "${pane}"
            pane=""
            viewed="$(viewed_window)"
            if [[ -z "${viewed}" ]]; then
                return 0
            fi
            read -r window zoomed <<<"${viewed}"
        fi
    fi

    # A zoomed window is showing one pane on purpose. Joining it would undo
    # the zoom; unzooming fires a hook that brings the sidebar in then.
    if [[ "${zoomed}" == 1 ]]; then
        return 0
    fi
    if [[ -z "${pane}" ]]; then
        open_in "${window}" "${width}" >/dev/null
    elif [[ "${home}" != "${window}" ]]; then
        tmux join-pane -hbf -l "${width}" -d -s "${pane}" -t "${window}"
    elif ((pane_width != width)); then
        # A layout change or a resized terminal spread the columns out
        # again. Only when it is off: resize-pane fires the very hooks that
        # run this.
        tmux resize-pane -t "${pane}" -x "${width}"
    fi
}

toggle() {
    local viewed window zoomed pane home width
    width="$(setting width)"
    viewed="$(viewed_window)"
    if [[ -z "${viewed}" ]]; then
        return 0
    fi
    read -r window zoomed <<<"${viewed}"
    pane="$(sidebar_pane)"
    home=""
    if [[ -n "${pane}" ]]; then
        home="$(tmux display-message -p -t "${pane}" '#{window_id}')"
    fi

    if [[ "${home}" == "${window}" && "${zoomed}" != 1 ]]; then
        close
        return 0
    fi
    tmux set-option -g @agent-sidebar-open 1
    if [[ "${home}" == "${window}" ]]; then
        # Here, but hidden behind a zoomed pane: pressing M-2 means you
        # want to see it.
        tmux resize-pane -Z -t "${window}"
    elif [[ -n "${pane}" ]]; then
        tmux join-pane -hbf -l "${width}" -d -s "${pane}" -t "${window}"
    else
        pane="$(open_in "${window}" "${width}")"
    fi
    tmux select-pane -t "${pane}"
}

close() {
    local pane
    tmux set-option -gu @agent-sidebar-open
    pane="$(sidebar_pane)"
    if [[ -n "${pane}" ]]; then
        tmux kill-pane -t "${pane}"
    fi
}

# Restoring a saved sidebar would bring back a plain shell squeezed into
# its slot, because resurrect restores commands, not what they were for.
# resurrect hands this hook the file it has just written.
prune_resurrect() {
    local file="$1"
    awk -F '\t' -v title="${title}" '!($1 == "pane" && $7 == title)' \
        "${file}" >"${file}.agent-sidebar"
    mv "${file}.agent-sidebar" "${file}"
}

# --- actions ---

pane_path() {
    tmux display-message -p -t "$1" '#{pane_current_path}'
}

# The project folder a directory is in, or nothing. Every worktree shares
# its project's common dir, which is `<project>/.bare`.
project_of() {
    local common
    common="$(git -C "$1" rev-parse --path-format=absolute \
        --git-common-dir 2>/dev/null)" || return 0
    if [[ "$(basename "${common}")" == ".bare" ]]; then
        dirname "${common}"
    fi
}

# git-wt's tmux session name and folder for a directory, tab separated:
# what it opens a worktree as, so opening it any way lands in one session.
session_of() {
    git-wt session "$1" 2>/dev/null
}

# The worktree that has a branch checked out, or nothing.
worktree_for_branch() {
    git -C "$1" worktree list --porcelain |
        awk -v ref="refs/heads/$2" '
            /^worktree / { path = substr($0, 10) }
            $0 == "branch " ref { print path; exit }'
}

# Run a command in a popup over the client you are looking through. tmux
# blocks until the popup closes, so whatever follows sees its result.
popup() {
    local dir="$1"
    shift
    # display-popup hands its command to a shell, so quote each word.
    tmux display-popup -E -d "${dir}" -w 90% -h 90% "$(printf '%q ' "$@")" ||
        true
}

# nvim creates the file on write, but not its folder.
edit_config() {
    local file
    file="$("${config_reader}" path)"
    mkdir -p "$(dirname "${file}")"
    popup "$(dirname "${file}")" nvim "${file}"
}

# A message's whole thread, oldest first, opened at the message itself.
show_thread() {
    "${messenger}" log --thread "$1" | less -R "+/^#$1  "
}

# Keep a popup open until a key is pressed, so its output can be read.
hold() {
    printf '\n%s' "${1:-Press any key to close}"
    read -rsn1 _ || true
}

notify() {
    tmux display-message -d 5000 "agent-sidebar: $1"
}

# The variable a harness picks its account by, for the harnesses that keep
# more than one. opencode keeps its logins in its share of XDG_DATA_HOME,
# and moving that would move every other tool's data along with them.
account_variable() {
    case "$1" in
    claude) echo CLAUDE_CONFIG_DIR ;;
    codex) echo CODEX_HOME ;;
    pi) echo PI_CODING_AGENT_DIR ;;
    *) return 1 ;;
    esac
}

readonly account_variables=(CLAUDE_CONFIG_DIR CODEX_HOME PI_CODING_AGENT_DIR)

# Each harness's accounts besides its default, "HARNESS<tab>NAME<tab>FOLDER"
# a line. The login each folder must hold is what the harness writes there:
# claude's credentials are in the macOS keychain, but .claude.json is not.
accounts() {
    local folder harness name file
    {
        for folder in "${HOME}"/.claude-*/.claude.json \
            "${HOME}"/.codex-*/auth.json "${HOME}"/.pi-*/agent/auth.json; do
            [[ -e "${folder}" ]] || continue
            folder="$(dirname "${folder}")"
            name="${folder#"${HOME}"/.}"
            name="${name%/agent}"
            printf '%s\t%s\t%s\n' "${name%%-*}" "${name#*-}" "${folder}"
        done
        file="${XDG_CONFIG_HOME:-${HOME}/.config}/agent-sidebar/accounts"
        if [[ -r "${file}" ]]; then
            while read -r harness name folder; do
                if [[ -n "${folder}" ]] && account_variable "${harness}" >/dev/null; then
                    printf '%s\t%s\t%s\n' "${harness}" "${name}" \
                        "${folder/#\~/${HOME}}"
                fi
            done <"${file}"
        fi
    } | sort -t $'\t' -k1,1 -k2,2
}

# new-session's -e arguments for starting COMMAND on its harness's account
# NAME, in `session_env`, or why not in `account_error`. With INHERIT, the
# caller's accounts come along for every other harness, and for this one
# when no NAME is given.
account_env() {
    local command="$1" name="$2" inherit="$3" harness variable folder h n f
    session_env=()
    read -r harness _ <<<"${command}"
    harness="$(basename "${harness:-none}")"
    if [[ -n "${name}" ]]; then
        if ! variable="$(account_variable "${harness}")"; then
            account_error="${harness} keeps no accounts"
            return 1
        fi
        while IFS=$'\t' read -r h n f; do
            if [[ "${h}" == "${harness}" && "${n}" == "${name}" ]]; then
                folder="${f}"
                break
            fi
        done < <(accounts)
        if [[ -z "${folder:-}" ]]; then
            account_error="no ${harness} account ${name} (see: agent-sidebar-tmux accounts)"
            return 1
        fi
        session_env+=(-e "${variable}=${folder}")
    fi
    if [[ -n "${inherit}" ]]; then
        for h in "${account_variables[@]}"; do
            if [[ -n "${!h:-}" && "${h}" != "${variable:-}" ]]; then
                session_env+=(-e "${h}=${!h}")
            fi
        done
    fi
}

new_worktree() {
    local pane="$1" branch="$2" harness="${3:-}" account="${4:-}"
    local project path session chosen
    project="$(project_of "$(pane_path "${pane}")")"
    if [[ -z "${project}" ]]; then
        notify "no project behind ${pane}"
        return 0
    fi
    chosen="${harness:-$(setting agent)}"
    if ! account_env "${chosen}" "${account}" ""; then
        notify "${account_error}"
        return 0
    fi
    # git-wt-add reports as it goes - setting the worktree up included - so
    # it runs where you can read it.
    popup "${project}" "$0" _worktree-add "${branch}"
    path="$(worktree_for_branch "${project}" "${branch}")"
    if [[ -z "${path}" ]]; then
        return 0
    fi
    session="$(session_of "${path}" | cut -f1)"
    if [[ -z "${session}" ]]; then
        notify "no tmux session name for ${path}"
        return 0
    fi
    if ! tmux has-session -t "=${session}" 2>/dev/null; then
        tmux new-session -d -s "${session}" -c "${path}" "${session_env[@]}"
        # Typed into the shell rather than run as the session's command, so
        # the session outlives the agent.
        if [[ -n "${chosen}" && "${chosen}" != "none" ]]; then
            tmux send-keys -t "=${session}:" "${chosen}" Enter
        fi
    fi
    tmux switch-client -t "=${session}"
}

# new-worktree for an agent starting workers. Nothing takes over the screen,
# and a session that already exists is refused rather than typed into: it
# may be anyone's, and the harness command would reach whoever is in it.
spawn() {
    local where="$1" branch="$2" harness="${3:-}" account="${4:-}"
    local dir project path session new chosen
    # A pane for an agent, a folder for you in a shell outside tmux.
    if [[ "${where}" == %* ]]; then
        dir="$(pane_path "${where}")"
    else
        dir="${where}"
    fi
    project="$(project_of "${dir}")"
    if [[ -z "${project}" ]]; then
        echo "agent-sidebar-tmux: no git-wt project behind ${where}" >&2
        return 1
    fi
    chosen="${harness:-$(setting agent)}"
    if ! account_env "${chosen}" "${account}" inherit; then
        echo "agent-sidebar-tmux: ${account_error}" >&2
        return 1
    fi
    (cd "${project}" && git-wt-add "${branch}" </dev/null) >&2
    path="$(worktree_for_branch "${project}" "${branch}")"
    if [[ -z "${path}" ]]; then
        echo "agent-sidebar-tmux: no worktree has ${branch} checked out" >&2
        return 1
    fi
    session="$(session_of "${path}" | cut -f1)"
    if [[ -z "${session}" ]]; then
        echo "agent-sidebar-tmux: no tmux session name for ${path}" >&2
        return 1
    fi
    if tmux has-session -t "=${session}" 2>/dev/null; then
        echo "agent-sidebar-tmux: session ${session} already exists, started nothing" >&2
        return 1
    fi
    new="$(tmux new-session -d -P -F '#{pane_id}' -s "${session}" -c "${path}" \
        "${session_env[@]}")"
    if [[ "${chosen}" != "none" ]]; then
        tmux send-keys -t "${new}" -l "${chosen}"
        tmux send-keys -t "${new}" Enter
    fi
    echo "${new}"
}

worktree_add() {
    if ! git-wt-add "$1"; then
        hold "git-wt-add failed. Press any key to close"
    fi
}

review() {
    local pane="$1" dir out
    dir="$(pane_path "${pane}")"
    out="$(mktemp)"
    # --stdout sends tuicr's export to the file instead of the clipboard, and
    # exporting ends the review; the review itself still draws on the
    # terminal. The $1 belongs to the inner sh, hence the single quotes.
    # shellcheck disable=SC2016
    popup "${dir}" sh -c 'tuicr -w --stdout --no-update-check --appearance dark >"$1"' sh "${out}"
    if [[ -s "${out}" ]]; then
        tmux load-buffer -b agent-sidebar-review "${out}"
        # Bracketed and without Enter: the comments land in the agent's
        # input for you to read over and send.
        tmux paste-buffer -p -d -b agent-sidebar-review -t "${pane}"
        tmux switch-client -t "${pane}"
    fi
    rm -f "${out}"
}

pull_request() {
    if ! gh pr view; then
        local answer
        read -rp "Create a pull request for this branch? [y/N] " answer
        if [[ "${answer}" == [yY]* ]]; then
            gh pr create || true
        fi
    fi
    hold
}

remove_worktree() {
    local pane="$1" dir project main top
    dir="$(pane_path "${pane}")"
    project="$(project_of "${dir}")"
    main="$(session_of "${project:-/nonexistent}" | cut -f2)"
    top="$(git -C "${dir}" rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -z "${project}" || -z "${top}" || "${top}" == "${main}" ]]; then
        notify "${pane} is not working in a project's worktree"
        return 0
    fi
    popup "${project}" "$0" _worktree-remove "${top}"
    # git-wt-remove asks first, refuses to throw away uncommitted work, and
    # closes the worktree's own session. Only once the worktree is really
    # gone does the agent go too, if it lived in some other session.
    if [[ ! -d "${top}" ]]; then
        tmux kill-pane -t "${pane}" 2>/dev/null || true
    fi
}

worktree_remove() {
    if ! git-wt-remove -d "$1"; then
        hold "git-wt-remove did not remove it. Press any key to close"
    fi
}

open_project() {
    tmux display-popup -E -d "${HOME}" -w 80% -h 70% -T Projects tv projects ||
        true
}

# Hooks fire in bursts - one window change is several events - and two runs
# that each see no sidebar would each open one.
#
# A burst is also coalesced: a follow already waiting its turn looks at
# where you are when it runs, not when it fired, so it covers every follow
# fired after it, and those leave. Queued one behind another they would
# hold up the M-2 pressed after them for seconds.
locked() {
    local socket lock
    socket="${TMUX%%,*}"
    lock="${TMPDIR:-/tmp}/agent-sidebar-$(id -u)-$(basename "${socket:-default}").lock"
    if [[ "$1" == follow ]]; then
        exec 8>"${lock}.waiting"
        if ! flock -n 8; then
            return 0
        fi
    fi
    exec 9>"${lock}"
    flock -w 5 9
    if [[ "$1" == follow ]]; then
        # Running now, so the next follow fired waits in its place.
        exec 8>&-
    fi
    "$@"
}

need() {
    local count="$1"
    shift
    if [[ $# -ne "${count}" ]]; then
        usage >&2
        exit 2
    fi
}

main() {
    case "${1:-}" in
    toggle | close | follow)
        locked "$1"
        ;;
    prune-resurrect)
        need 2 "$@"
        prune_resurrect "$2"
        ;;
    new-worktree | spawn)
        local command="$1" account=""
        local -a args=()
        shift
        while (($#)); do
            if [[ "$1" == --account && $# -ge 2 ]]; then
                account="$2"
                shift 2
            else
                args+=("$1")
                shift
            fi
        done
        if [[ ${#args[@]} -lt 2 || ${#args[@]} -gt 3 ]]; then
            usage >&2
            exit 2
        fi
        "${command//-/_}" "${args[0]}" "${args[1]}" "${args[2]:-}" "${account}"
        ;;
    accounts)
        accounts
        ;;
    review)
        need 2 "$@"
        review "$2"
        ;;
    git)
        need 2 "$@"
        popup "$(pane_path "$2")" lazygit
        ;;
    pr)
        need 2 "$@"
        popup "$(pane_path "$2")" "$0" _pull-request
        ;;
    kill)
        need 2 "$@"
        tmux kill-pane -t "$2"
        ;;
    remove-worktree)
        need 2 "$@"
        remove_worktree "$2"
        ;;
    open)
        open_project
        ;;
    config)
        edit_config
        ;;
    thread)
        need 2 "$@"
        [[ "$2" =~ ^[0-9]+$ ]] || { usage >&2; exit 2; }
        popup "${HOME}" "$0" _thread "$2"
        ;;
    # Run inside the popups above.
    _worktree-add)
        worktree_add "$2"
        ;;
    _worktree-remove)
        worktree_remove "$2"
        ;;
    _pull-request)
        pull_request
        ;;
    _thread)
        show_thread "$2"
        ;;
    -h | --help | help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
    esac
}

main "$@"
