#!/usr/bin/env -S uv run --script
# vim: set ft=python:
# -*- mode: python -*-
# language: python
# /// script
# requires-python = ">=3.13"
# dependencies = []
# ///
"""git-wt - a folder per project, a worktree folder per branch inside it,
set up and cleaned up without losing work.

Usage: git-wt <command> [options]

Commands:
  clone [-b BRANCH] [-t] URL [DIR]
                                clone URL as a project, with worktrees for its
                                main branch and the branch the URL points at
  add [-b BASE] [-t] [--no-fetch] [BRANCH]
                                create a worktree for BRANCH and set it up
                                (default: pick or type one with fzf)
  list [-v] [-a] [--no-fetch]   list worktrees with their merge and work state
  switch [-t] [TARGET]          go to a worktree (its tmux session in tmux)
  remove [-f] [-d] [--discard] [--no-fetch] [TARGET]
                                remove a worktree, refusing to lose work
  prune [-f] [-d] [-a] [--dry-run] [--no-fetch]
                                remove every worktree whose branch is merged
  convert [-f] [--dry-run] [PATH]
                                turn a plain clone into a project
  bootstrap [--index] [PATH]    copy and link local files into a worktree
  session [PATH]                print a worktree's tmux session and folder
  claude-hook                   Claude Code's WorktreeCreate hook

`git-wt <command> --help` describes a command. git-wt-add, git-wt-list,
git-wt-switch, git-wt-remove, git-wt-prune, git-wt-bootstrap and
claude-worktree-create run the matching command.

Layout: a project is a folder holding .bare, git's own data, a .git file
pointing at it, and a folder per worktree named after its branch, folded
to lowercase letters, digits and dashes: <project>/main, <project>/feat-x.
The main branch's worktree is the main worktree. Its tmux session is named
after the project, every other worktree's <project>-<folder>.

Merged: a branch counts as merged into origin's main branch when its own
commits are there, whether they got there by a merge, a fast-forward, a
rebase or a squash, or when GitHub or GitLab has merged a pull or merge
request for exactly its current commit. A branch that never had a commit
of its own is never merged, unless the remote branch it tracked is gone,
so a fresh worktree is never pruned.

Forge: GitHub or GitLab, told from origin's host: github.com, gitlab.com,
or a host gh or glab is logged in to. Override it with
git config worktree.forge github|gitlab|none.

Work: uncommitted changes and untracked files are what removing a worktree
would lose; git-wt refuses to remove them without --discard. Commits stay
on the branch, so they never block removing the worktree, and only a merged
branch is ever deleted.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import unicodedata
import urllib.parse
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from functools import cached_property
from pathlib import Path

GLOB_CHARS = re.compile(r"[*?\[]")
# Reflog subjects of a branch getting commits of its own, as opposed to
# being created, reset or renamed.
OWN_COMMIT_RE = re.compile(r"^(commit|merge|rebase|cherry-pick|pull|am|revert)\b")
# [user@]host:path, git's scp-like remote syntax.
SCP_RE = re.compile(r"^(?:[^@/]+@)?([^:/]+):(?!//)(.+)$")
# A GitHub .../tree/<branch> or GitLab .../-/tree/<branch> page.
TREE_URL_RE = re.compile(r"^(https?://[^/]+/.+?)(?:/-)?/tree/(.+)$")
MISE_CONFIGS = (
    "mise.toml", ".mise.toml", "mise.local.toml", ".mise.local.toml",
    ".config/mise.toml", ".config/mise/config.toml", ".mise/config.toml",
    "mise/config.toml",
)
MISE_TASK_DIRS = (
    "mise-tasks", ".mise-tasks", "mise/tasks", ".mise/tasks",
    ".config/mise/tasks",
)
EXCLUDE_MARKER = "# git-wt: paths linked into worktrees by .worktreelink"
# A main checkout in the middle of one of these cannot be converted: the
# state lives in .git itself, which becomes the shared .bare.
IN_PROGRESS = (
    "rebase-merge", "rebase-apply", "MERGE_HEAD", "CHERRY_PICK_HEAD",
    "REVERT_HEAD", "BISECT_LOG",
)
GITFILE = "gitdir: ./.bare\n"


class Fail(Exception):
    """Something the user needs to hear about; exit 1."""


# --- output ---

def colour(text: str, code: str, stream=None) -> str:
    stream = stream or sys.stdout
    if stream.isatty() and not os.environ.get("NO_COLOR"):
        return f"\033[{code}m{text}\033[0m"
    return text


def green(text: str) -> str:
    return colour(text, "32")


def blue(text: str) -> str:
    return colour(text, "34")


def yellow(text: str) -> str:
    return colour(text, "33")


def red(text: str) -> str:
    return colour(text, "31")


def dim(text: str) -> str:
    return colour(text, "2")


def bold(text: str) -> str:
    return colour(text, "1")


def say(text: str = "") -> None:
    print(text, flush=True)


def warn(text: str) -> None:
    print(colour(text, "33", sys.stderr), file=sys.stderr, flush=True)


# --- processes ---

def run(
    command: list[str], cwd: Path | None = None, check: bool = True,
    input: str | None = None, env: dict[str, str] | None = None,
    timeout: float | None = None,
) -> subprocess.CompletedProcess[str]:
    try:
        result = subprocess.run(
            command, cwd=cwd, input=input, env=env, timeout=timeout,
            capture_output=True, text=True,
        )
    except FileNotFoundError as error:
        raise Fail(f"{command[0]} is not installed") from error
    except subprocess.TimeoutExpired as error:
        raise Fail(f"{' '.join(command)} timed out") from error
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise Fail(detail or f"{' '.join(command)} failed")
    return result


def git(*args: str, cwd: Path, check: bool = True) -> str:
    return run(["git", *args], cwd=cwd, check=check).stdout


def git_ok(*args: str, cwd: Path) -> bool:
    return run(["git", *args], cwd=cwd, check=False).returncode == 0


def stream(command: list[str], cwd: Path) -> int:
    """Run with its output going straight to ours, so git's own messages
    show; returns the exit code."""
    sys.stdout.flush()
    return subprocess.run(
        command, cwd=cwd, stdout=sys.stdout, stderr=sys.stderr,
    ).returncode


def current_dir() -> Path:
    try:
        return Path.cwd()
    except FileNotFoundError as error:
        raise Fail("the current directory no longer exists") from error


def same_path(a: Path, b: Path) -> bool:
    return os.path.realpath(a) == os.path.realpath(b)


def inside(path: Path, parent: Path) -> bool:
    real, top = os.path.realpath(path), os.path.realpath(parent)
    return real == top or real.startswith(top + os.sep)


def common_dir(start: Path) -> Path | None:
    """The git common dir of the repository start is in: <project>/.bare
    for every worktree of a project."""
    if not start.is_dir():
        return None
    result = run(
        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
        cwd=start, check=False,
    )
    if result.returncode != 0:
        return None
    return Path(result.stdout.strip())


# --- names ---

def slug(branch: str) -> str:
    folded = unicodedata.normalize("NFKD", branch)
    ascii_only = folded.encode("ascii", "ignore").decode().lower()
    return re.sub(r"[^a-z0-9]+", "-", ascii_only).strip("-")


def session_name(project: str, folder: str | None) -> str:
    name = project if folder is None else f"{project}-{folder}"
    # tmux reads `.` and `:` in a target as window and pane separators.
    return name.translate(str.maketrans(".:", "__"))


def split_remote(url: str) -> tuple[str, str] | None:
    """(host, path) of a remote URL, the path without .git; None for a
    local path."""
    if "://" in url:
        parsed = urllib.parse.urlsplit(url)
        if parsed.scheme == "file" or not parsed.hostname:
            return None
        host, path = parsed.hostname, parsed.path
    else:
        match = SCP_RE.match(url)
        if not match:
            return None
        host, path = match.groups()
    path = path.strip("/").removesuffix(".git")
    return (host.lower(), path) if path else None


# --- repository ---

@dataclass
class Worktree:
    path: Path
    head: str
    branch: str | None
    locked: str | None
    prunable: bool
    is_main: bool

    @property
    def name(self) -> str:
        return self.path.name

    @property
    def label(self) -> str:
        return self.branch or f"(detached {self.head[:8]})"

    @property
    def missing(self) -> bool:
        return self.prunable or not self.path.is_dir()


def parse_worktrees(out: str, main: Path) -> list[Worktree]:
    """`git worktree list --porcelain -z`, without the bare repository."""
    worktrees = []
    for record in out.split("\0\0"):
        fields = [f for f in record.split("\0") if f]
        if not fields or not fields[0].startswith("worktree "):
            continue
        path = Path(fields[0].removeprefix("worktree "))
        head, branch, locked, prunable, bare = "", None, None, False, False
        for field in fields[1:]:
            key, _, value = field.partition(" ")
            if key == "HEAD":
                head = value
            elif key == "branch":
                branch = value.removeprefix("refs/heads/")
            elif key == "locked":
                locked = value
            elif key == "prunable":
                prunable = True
            elif key == "bare":
                bare = True
        if bare:
            continue
        worktrees.append(Worktree(path, head, branch, locked, prunable, same_path(path, main)))
    return worktrees


def find_main_branch(cwd: Path) -> str:
    def ref_exists(ref: str) -> bool:
        return git_ok("show-ref", "--verify", "--quiet", ref, cwd=cwd)

    configured = git("config", "--get", "worktree.mainBranch", cwd=cwd, check=False).strip()
    if configured:
        return configured
    origin_head = git(
        "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD",
        cwd=cwd, check=False,
    ).strip()
    if origin_head.startswith("origin/"):
        return origin_head.removeprefix("origin/")
    for name in ("main", "master", "trunk"):
        if ref_exists(f"refs/heads/{name}") or ref_exists(f"refs/remotes/origin/{name}"):
            return name
    raise Fail(
        "Could not tell the main branch; set it with: "
        "git config worktree.mainBranch <branch>"
    )


@dataclass
class Work:
    changes: list[str]
    unpushed: int
    unreachable: int

    @property
    def at_risk(self) -> bool:
        return bool(self.changes) or self.unreachable > 0


@dataclass
class Forge:
    kind: str
    host: str | None
    path: str | None


def forge_of_host(host: str) -> str | None:
    if host == "github.com":
        return "github"
    if host == "gitlab.com":
        return "gitlab"
    # A self-hosted instance is whichever of the two is logged in to it;
    # both answer from their own config, without asking the server.
    try:
        if shutil.which("gh") and run(
            ["gh", "auth", "token", "--hostname", host], check=False, timeout=10,
        ).returncode == 0:
            return "github"
        if shutil.which("glab") and run(
            ["glab", "config", "get", "token", "--host", host], check=False, timeout=10,
        ).stdout.strip():
            return "gitlab"
    except Fail:
        pass
    return None


class Repo:
    """A project: <root>/.bare holds git's data, <root>/.git points at it,
    and every worktree is a folder <root>/<branch slug>."""

    def __init__(self, root: Path, common: Path) -> None:
        self.root = root
        self.common = common

    @classmethod
    def at(cls, start: Path) -> Repo:
        common = common_dir(start)
        if common is None:
            raise Fail(f"Not in a git repository: {start}")
        if common.name == ".bare":
            repo = cls(common.parent, common)
            repo.keep_reflogs()
            return repo
        if common.name == ".git" and common.is_dir():
            raise Fail(
                f"{common.parent} is a plain clone, not a project with a folder per "
                f"worktree; convert it with: git-wt convert {common.parent}"
            )
        raise Fail(f"Unsupported repository layout: {common} is not a project's .bare")

    @property
    def name(self) -> str:
        return self.root.name

    def keep_reflogs(self) -> None:
        # A bare repository keeps no reflogs unless told to, and a branch's
        # reflog is what tells one merged by fast-forward apart from one
        # that never had a commit.
        if not self.git("config", "--get", "core.logAllRefUpdates", check=False).strip():
            self.git("config", "core.logAllRefUpdates", "true")

    def git(self, *args: str, check: bool = True) -> str:
        return git(*args, cwd=self.root, check=check)

    def ok(self, *args: str) -> bool:
        return git_ok(*args, cwd=self.root)

    def ref_exists(self, ref: str) -> bool:
        return self.ok("show-ref", "--verify", "--quiet", ref)

    @cached_property
    def main_branch(self) -> str:
        return find_main_branch(self.root)

    @cached_property
    def target(self) -> str:
        """What merged means merged into: origin's main branch if known."""
        if self.ref_exists(f"refs/remotes/origin/{self.main_branch}"):
            return f"origin/{self.main_branch}"
        if self.ref_exists(f"refs/heads/{self.main_branch}"):
            return self.main_branch
        raise Fail(f"The main branch {self.main_branch} does not exist")

    @cached_property
    def has_origin(self) -> bool:
        return self.ok("remote", "get-url", "origin")

    def folder(self, branch: str) -> Path:
        return self.root / slug(branch)

    @property
    def main_path(self) -> Path:
        return self.folder(self.main_branch)

    def session(self, path: Path) -> str:
        folder = None if same_path(path, self.main_path) else path.name
        return session_name(self.name, folder)

    def worktrees(self) -> list[Worktree]:
        out = self.git("worktree", "list", "--porcelain", "-z")
        return parse_worktrees(out, self.main_path)

    def fetch(self) -> None:
        if not self.has_origin:
            return
        # --prune, so a remote branch deleted after its merge reads as gone.
        result = run(
            ["git", "fetch", "--quiet", "--prune", "origin"], cwd=self.root,
            check=False, timeout=120,
        )
        if result.returncode != 0:
            reason = (result.stderr.strip().splitlines() or ["unknown error"])[0]
            warn(f"Could not fetch origin of {self.name} ({reason}); using what is already known.")

    def work(self, worktree: Worktree) -> Work:
        if worktree.missing:
            return Work([], 0, 0)
        out = git(
            "status", "--porcelain=v1", "-z", "--untracked-files=all",
            cwd=worktree.path,
        )
        changes, tokens = [], iter(out.split("\0"))
        for token in tokens:
            if not token:
                continue
            changes.append(token)
            # A rename or copy is followed by the path it came from.
            if token[0] in "RC":
                next(tokens, None)
        if worktree.branch:
            local_main = f"refs/heads/{self.main_branch}"
            exclude = [local_main] if self.ref_exists(local_main) else []
            unpushed = self.git(
                "rev-list", "--count", f"refs/heads/{worktree.branch}",
                "--not", "--remotes", *exclude,
            ).strip()
            return Work(changes, int(unpushed or 0), 0)
        unreachable = self.git(
            "rev-list", "--count", worktree.head, "--not", "--branches", "--remotes",
        ).strip()
        return Work(changes, 0, int(unreachable or 0))

    @cached_property
    def forge(self) -> Forge | None:
        urls = [
            # As written, then as git rewrites it with url.<base>.insteadOf.
            self.git("config", "--get", "remote.origin.url", check=False).strip(),
            self.git("remote", "get-url", "origin", check=False).strip(),
        ]
        remotes = [r for r in (split_remote(url) for url in urls if url) if r]
        configured = self.git("config", "--get", "worktree.forge", check=False).strip().lower()
        if configured:
            if configured == "none":
                return None
            if configured not in ("github", "gitlab"):
                warn(f"Ignoring worktree.forge={configured}: use github, gitlab or none.")
                return None
            host, path = remotes[0] if remotes else (None, None)
            return Forge(configured, host, path)
        for host, path in remotes:
            kind = forge_of_host(host)
            if kind:
                return Forge(kind, host, path)
        return None


class Merges:
    """Answers "is this branch merged", fetching and asking the forge once."""

    def __init__(self, repo: Repo, fetch: bool) -> None:
        self.repo = repo
        if fetch:
            repo.fetch()
        self._requests: dict[str, list[tuple[str, str]]] | None = None

    def reason(self, branch: str | None) -> str | None:
        """Why the branch counts as merged, or None when it does not."""
        repo = self.repo
        if not branch or branch == repo.main_branch:
            return None
        ref = f"refs/heads/{branch}"
        if not repo.ref_exists(ref):
            return None
        target = repo.target
        tip = repo.git("rev-parse", ref).strip()
        own = int(repo.git("rev-list", "--count", f"{target}..{ref}").strip())
        if own == 0:
            if self._had_own_commits(ref):
                return f"merged into {target}"
            if self._upstream_gone(ref):
                return f"in {target}, and its remote branch is gone"
        else:
            cherry = repo.git("cherry", target, ref).split()
            marks = cherry[0::2]
            # Every commit's change is already there: rebased, cherry-picked,
            # or a one-commit squash, which git cannot tell apart.
            if marks and all(mark == "-" for mark in marks):
                return f"merged into {target}, rebased or squashed"
            merged_tree = run(
                ["git", "merge-tree", "--write-tree", target, ref],
                cwd=repo.root, check=False,
            )
            target_tree = repo.git("rev-parse", f"{target}^{{tree}}").strip()
            lines = merged_tree.stdout.split()
            if merged_tree.returncode == 0 and lines and lines[0] == target_tree:
                return f"merged into {target}, squashed"
        for label, head in self.requests().get(branch, []):
            if head == tip:
                return f"merged by {label}"
        return None

    def _had_own_commits(self, ref: str) -> bool:
        subjects = self.repo.git("reflog", "show", "--format=%gs", ref, check=False)
        return any(OWN_COMMIT_RE.match(line) for line in subjects.splitlines())

    def _upstream_gone(self, ref: str) -> bool:
        track = self.repo.git("for-each-ref", "--format=%(upstream:track)", ref, check=False)
        return track.strip() == "[gone]"

    def requests(self) -> dict[str, list[tuple[str, str]]]:
        """Merged pull or merge requests by branch: (label, head commit)."""
        if self._requests is not None:
            return self._requests
        self._requests = {}
        forge = self.repo.forge if self.repo.has_origin else None
        if forge is None:
            return self._requests
        try:
            listed = self._github(forge) if forge.kind == "github" else self._gitlab(forge)
        except (Fail, json.JSONDecodeError):
            listed = []
        for label, branch, head in listed:
            if isinstance(branch, str) and isinstance(head, str):
                self._requests.setdefault(branch, []).append((label, head))
        return self._requests

    def _github(self, forge: Forge) -> list[tuple[str, object, object]]:
        if not shutil.which("gh"):
            return []
        command = [
            "gh", "pr", "list", "--state", "merged", "--limit", "500",
            "--json", "number,headRefName,headRefOid",
        ]
        if forge.host and forge.path:
            command += ["--repo", f"{forge.host}/{forge.path}"]
        result = run(command, cwd=self.repo.root, check=False, timeout=30)
        rows = json.loads(result.stdout) if result.returncode == 0 else []
        return [
            (f"pull request #{row.get('number')}", row.get("headRefName"), row.get("headRefOid"))
            for row in (rows if isinstance(rows, list) else []) if isinstance(row, dict)
        ]

    def _gitlab(self, forge: Forge) -> list[tuple[str, object, object]]:
        if not shutil.which("glab"):
            return []
        rows: list = []
        for page in range(1, 6):
            command = [
                "glab", "mr", "list", "--merged", "--per-page", "100",
                "--page", str(page), "--output", "json",
            ]
            if forge.host and forge.path:
                command += ["--repo", f"https://{forge.host}/{forge.path}"]
            result = run(command, cwd=self.repo.root, check=False, timeout=30)
            batch = json.loads(result.stdout) if result.returncode == 0 else None
            if not isinstance(batch, list):
                break
            rows += batch
            if len(batch) < 100:
                break
        return [
            (f"merge request !{row.get('iid')}", row.get("source_branch"), row.get("sha"))
            for row in rows if isinstance(row, dict)
        ]


def all_projects() -> list[Repo]:
    """Every project git-projects finds, most recently used first."""
    lister = Path(__file__).resolve().with_name("git-projects")
    result = run([str(lister) if lister.is_file() else "git-projects"], check=False, timeout=120)
    if result.returncode != 0:
        raise Fail(f"git-projects failed: {result.stderr.strip()}")
    repos = []
    for line in result.stdout.splitlines():
        root = Path(line)
        if (root / ".bare").is_dir() and (root / ".git").is_file():
            repo = Repo(root, root / ".bare")
            repo.keep_reflogs()
            repos.append(repo)
    return repos


def fetch_all(repos: list[Repo]) -> None:
    with ThreadPoolExecutor(max_workers=8) as pool:
        list(pool.map(Repo.fetch, repos))


# --- tmux ---

def tmux(*args: str) -> subprocess.CompletedProcess[str] | None:
    if not shutil.which("tmux"):
        return None
    return subprocess.run(["tmux", *args], capture_output=True, text=True)


def has_session(name: str) -> bool:
    result = tmux("has-session", "-t", f"={name}")
    return result is not None and result.returncode == 0


def ensure_session(name: str, path: Path) -> str:
    if not has_session(name):
        result = tmux("new-session", "-d", "-s", name, "-c", str(path))
        if result is None or result.returncode != 0:
            raise Fail(f"Could not start tmux session {name}")
    return name


def open_session(name: str, path: Path) -> None:
    if not shutil.which("tmux"):
        raise Fail("tmux is not installed")
    ensure_session(name, path)
    verb = "switch-client" if os.environ.get("TMUX") else "attach-session"
    sys.stdout.flush()
    os.execvp("tmux", ["tmux", verb, "-t", f"={name}"])


def close_session(repo: Repo, worktree: Worktree) -> None:
    name = repo.session(worktree.path)
    if not has_session(name):
        return
    listed = tmux("list-clients", "-t", f"={name}", "-F", "#{client_name}")
    clients = listed.stdout.split() if listed and listed.returncode == 0 else []
    if clients:
        # Somewhere to stand before the floor goes, so nobody is detached.
        home = repo.main_path if repo.main_path.is_dir() else repo.root
        refuge = ensure_session(session_name(repo.name, None), home)
        for client in clients:
            tmux("switch-client", "-c", client, "-t", f"={refuge}")
    tmux("kill-session", "-t", f"={name}")
    say(f"Closed tmux session: {name}")


# --- picking ---

def fzf(lines: list[str], *options: str) -> subprocess.CompletedProcess[str]:
    if not shutil.which("fzf"):
        raise Fail("fzf is needed to pick; name what you want instead")
    return subprocess.run(
        ["fzf", "--delimiter=\t", "--with-nth=1", *options],
        input="\n".join(lines) + "\n", stdout=subprocess.PIPE, text=True,
    )


def find_worktree(worktrees: list[Worktree], target: str) -> Worktree | None:
    candidate = Path(target).expanduser()
    if candidate.exists():
        real = candidate.resolve()
        # The deepest worktree containing it: a subdirectory counts, and a
        # worktree nested in another one's folder wins over its parent.
        for worktree in sorted(worktrees, key=lambda w: len(str(w.path)), reverse=True):
            if inside(real, worktree.path):
                return worktree
    for worktree in worktrees:
        if worktree.branch == target:
            return worktree
    for worktree in worktrees:
        if worktree.name == target:
            return worktree
    return None


def pick_worktree(worktrees: list[Worktree], header: str) -> Worktree:
    lines = [f"{w.label}  [{w.name}]\t{i}" for i, w in enumerate(worktrees)]
    result = fzf(lines, f"--header={header}")
    chosen = result.stdout.strip()
    if result.returncode != 0 or not chosen:
        raise Fail("No worktree selected.")
    return worktrees[int(chosen.rsplit("\t", 1)[-1])]


def resolve(worktrees: list[Worktree], target: str | None, header: str) -> Worktree:
    if target is None:
        return pick_worktree(worktrees, header)
    found = find_worktree(worktrees, target)
    if found is None:
        available = "\n".join(f"  - {w.label} ({w.name})" for w in worktrees)
        raise Fail(f"Worktree not found: {target}\nAvailable worktrees:\n{available or '  (none)'}")
    return found


def pick_branch(repo: Repo, fetch: bool) -> str:
    """A branch without a worktree, local ones first, or a new name typed
    into the query."""
    if not shutil.which("fzf"):
        raise Fail("fzf is needed to pick a branch; name one instead")
    if fetch:
        repo.fetch()
    taken = {w.branch for w in repo.worktrees() if w.branch}
    local = [
        ref.removeprefix("refs/heads/") for ref in
        repo.git("for-each-ref", "--format=%(refname)", "refs/heads/").split()
    ]
    remote = [
        ref.removeprefix("refs/remotes/origin/") for ref in
        repo.git("for-each-ref", "--format=%(refname)", "refs/remotes/origin/").split()
    ]
    lines = [f"{green('local ')}  {b}\t{b}" for b in local if b not in taken]
    lines += [
        f"{blue('remote')}  {b}\t{b}" for b in remote
        if b != "HEAD" and b not in taken and b not in local
    ]
    result = fzf(
        lines, "--ansi", "--print-query",
        "--header=Pick a branch, or type a new one:",
    )
    # 1 is no match: what was typed is a new branch's name.
    if result.returncode not in (0, 1):
        raise Fail("No branch selected.")
    query, _, chosen = result.stdout.partition("\n")
    chosen = chosen.strip()
    branch = chosen.rsplit("\t", 1)[-1] if chosen else query.strip()
    if not branch:
        raise Fail("No branch selected.")
    return branch


def confirm(question: str) -> bool:
    print(f"{question} [y/N] ", end="", flush=True)
    answer = sys.stdin.readline()
    return answer.strip().lower() in ("y", "yes")


# --- bootstrap ---

def read_patterns(path: Path) -> list[str]:
    """Pattern lines the way Claude Code reads .worktreeinclude: trimmed,
    without blanks or comments."""
    if not path.is_file():
        return []
    lines = (line.strip() for line in path.read_text().splitlines())
    return [line for line in lines if line and not line.startswith("#")]


class Matcher:
    """gitignore matching done by git itself, so the syntax is exactly
    gitignore's. The empty repository keeps the real one's own .gitignore
    files out of it."""

    def __init__(self, scratch: Path) -> None:
        self.bare = scratch / "matcher.git"
        self.tree = scratch / "matcher"
        self.tree.mkdir()
        run(["git", "init", "-q", "--bare", str(self.bare)], cwd=scratch)

    def matching(self, patterns: Path, paths: list[str]) -> list[str]:
        if not paths:
            return []
        result = run(
            ["git", f"--git-dir={self.bare}", f"--work-tree={self.tree}",
             "-c", f"core.excludesFile={patterns}",
             "check-ignore", "--no-index", "--stdin", "-z"],
            cwd=self.tree, check=False, input="\0".join(paths) + "\0",
        )
        # 1 only means nothing matched.
        if result.returncode > 1:
            raise Fail(result.stderr.strip())
        return [path for path in result.stdout.split("\0") if path]


def reaches(entry: str, patterns: list[str]) -> bool:
    """Whether a pattern can match inside a wholly ignored directory.

    git lists such a directory as one entry, and looking inside every one
    (.venv, node_modules) would be slow, so Claude Code only looks where a
    pattern could reach. This is its rule, kept as it is so one
    .worktreeinclude copies the same files whichever tool made the worktree.
    """
    parts = [part.lower() for part in entry.rstrip("/").split("/")]
    for pattern in patterns:
        stem = pattern.removeprefix("/")
        if stem.startswith(entry):
            return True
        prefix = GLOB_CHARS.split(stem, maxsplit=1)[0]
        if prefix != stem and prefix and entry.startswith(prefix):
            return True
        first = stem
        while first.startswith("**/"):
            first = first[3:]
        if first == stem:
            continue
        first = first.split("/", 1)[0]
        name = GLOB_CHARS.split(first, maxsplit=1)[0].replace("\\", "").lower()
        if not name:
            continue
        wild = bool(GLOB_CHARS.search(first))
        if any(part.startswith(name) if wild else part == name for part in parts):
            return True
    return False


def worktree_index(worktree: Path, common: Path) -> int:
    """A small integer that stays with the worktree: the lowest free one
    from 1. It lives in the worktree's private git dir, so git deletes it
    with the worktree, which frees the number for the next one."""
    own = Path(git("rev-parse", "--absolute-git-dir", cwd=worktree).strip()) / "worktree-index"
    try:
        existing = own.read_text().strip()
        if existing.isdigit() and int(existing) > 0:
            return int(existing)
    except FileNotFoundError:
        pass
    # Claude Code can create several subagent worktrees at once; without
    # the lock two of them could pick the same number.
    lock = common / "worktree-index.lock"
    for _ in range(100):
        try:
            lock.mkdir()
            break
        except FileExistsError:
            time.sleep(0.1)
    else:
        raise Fail(f"Timed out waiting for {lock}; remove it if no bootstrap is running")
    try:
        used = set()
        for other in (common / "worktrees").glob("*/worktree-index"):
            if other != own:
                text = other.read_text().strip()
                if text.isdigit():
                    used.add(int(text))
        index = 1
        while index in used:
            index += 1
        own.write_text(f"{index}\n")
        return index
    finally:
        lock.rmdir()


def exclude_links(common: Path, paths: list[str]) -> None:
    """Keep linked paths out of `git status` everywhere.

    A `data/` pattern only matches a directory, and the link is a file, so
    without this the link shows as untracked, and committing and merging it
    would replace main's own data/ with a link to itself. info/exclude is
    shared by every worktree, and excluding the path in the main worktree
    too, where it is the real ignored directory, changes nothing there.
    """
    exclude = common / "info" / "exclude"
    exclude.parent.mkdir(parents=True, exist_ok=True)
    lines = exclude.read_text().splitlines() if exclude.exists() else []
    wanted = [f"/{path}" for path in paths if f"/{path}" not in lines]
    if not wanted:
        return
    if EXCLUDE_MARKER not in lines:
        wanted.insert(0, EXCLUDE_MARKER)
    text = "\n".join(lines + wanted) + "\n"
    exclude.write_text(text)


def bootstrap(target: Path, print_index: bool = False) -> int:
    result = run(["git", "rev-parse", "--show-toplevel"], cwd=target, check=False) \
        if target.is_dir() else None
    if result is None or result.returncode != 0:
        raise Fail(f"Not a git worktree: {target}")
    worktree = Path(result.stdout.strip())
    common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=worktree).strip())
    if common.name == ".bare":
        main = Repo(common.parent, common).main_path
    elif common.name == ".git":
        # A plain clone, which Claude Code's hook still makes worktrees in.
        main = common.parent
    else:
        raise Fail(f"Unsupported repository layout: {common} is not a .bare or .git directory")

    if same_path(worktree, main):
        if print_index:
            say("0")
            return 0
        raise Fail(f"{worktree} is the main worktree; bootstrap another worktree instead")
    if not main.is_dir():
        raise Fail(f"There is no main worktree at {main} to set {worktree.name} up from")

    index = worktree_index(worktree, common)
    if print_index:
        say(str(index))
        return 0

    say(f"Bootstrapping worktree: {worktree.name}")
    say(f"  Main: {main}")
    ignored = [e for e in git(
        "ls-files", "-z", "--others", "--ignored", "--exclude-standard", "--directory",
        cwd=main,
    ).split("\0") if e]

    def escapes(dest: Path) -> bool:
        """Whether writing dest would go through a symlink out of the worktree."""
        return not inside(dest.parent.resolve(), worktree)

    with tempfile.TemporaryDirectory() as scratch_dir:
        scratch = Path(scratch_dir)
        matcher = Matcher(scratch)

        # Links go first: a directory linked here must not also be copied
        # file by file. Only whole gitignored entries are linked, never
        # anything git tracks.
        link_patterns = read_patterns(main / ".worktreelink")
        if link_patterns:
            patterns = scratch / "link"
            patterns.write_text("\n".join(link_patterns) + "\n")
            candidates = []
            for entry in ignored:
                candidates.append(entry)
                # "data/" as a pattern only matches a directory, which git
                # spells with the slash; "data" matches either.
                if entry.endswith("/"):
                    candidates.append(entry.rstrip("/"))
            linked = sorted({m.rstrip("/") for m in matcher.matching(patterns, candidates)})
            for path in linked:
                dest = worktree / path
                if dest.exists() or dest.is_symlink():
                    say(dim(f"  Exists: {path}"))
                elif escapes(dest):
                    warn(f"  Skipped, would leave the worktree: {path}")
                else:
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    dest.symlink_to(main / path)
                    say(f"  Linked: {path}")
            exclude_links(common, linked)

        include_patterns = read_patterns(main / ".worktreeinclude")
        if include_patterns:
            patterns = scratch / "include"
            patterns.write_text("\n".join(include_patterns) + "\n")
            files = matcher.matching(patterns, [e for e in ignored if not e.endswith("/")])
            reached = [
                entry for entry in ignored
                if entry.endswith("/") and (
                    reaches(entry, include_patterns)
                    or matcher.matching(patterns, [entry.rstrip("/"), entry])
                )
            ]
            if reached:
                inside_dirs = run(
                    ["git", "ls-files", "-z", "--others", "--ignored",
                     "--exclude-standard", "--", *reached],
                    cwd=main, env=os.environ | {"GIT_LITERAL_PATHSPECS": "1"},
                ).stdout
                files += matcher.matching(patterns, [p for p in inside_dirs.split("\0") if p])
            for path in sorted(set(files)):
                source, dest = main / path, worktree / path
                if source.is_symlink():
                    warn(f"  Skipped symlink: {path}")
                elif dest.exists() or dest.is_symlink():
                    say(dim(f"  Exists: {path}"))
                elif escapes(dest):
                    warn(f"  Skipped, would leave the worktree: {path}")
                else:
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(source, dest)
                    say(f"  Copied: {path}")

    say(f"  Index: {index}")

    if (worktree / ".envrc").is_file() and shutil.which("direnv"):
        run(["direnv", "allow", str(worktree)], cwd=worktree)
        say("  direnv: allowed .envrc")

    if shutil.which("mise"):
        uses_mise = False
        for config in MISE_CONFIGS:
            if (worktree / config).is_file():
                run(["mise", "trust", str(worktree / config)], cwd=worktree)
                say(f"  mise: trusted {config}")
                uses_mise = True
        uses_mise = uses_mise or any((worktree / d).is_dir() for d in MISE_TASK_DIRS)
        env = os.environ | {"PWD": str(worktree)}
        if uses_mise and run(
            ["mise", "tasks", "info", "worktree:setup"], cwd=worktree, check=False, env=env,
        ).returncode == 0:
            say(blue("  Running mise task: worktree:setup"))
            code = subprocess.run(
                ["mise", "run", "worktree:setup"], cwd=worktree,
                env=env | {"WORKTREE_INDEX": str(index), "WORKTREE_MAIN": str(main)},
                stdout=sys.stdout, stderr=sys.stderr,
            ).returncode
            if code != 0:
                raise Fail("mise task worktree:setup failed; fix it and re-run git-wt bootstrap")

    say(green("✓ Worktree bootstrapped"))
    return 0


# --- commands ---

def add_worktree(repo: Repo, branch: str, base: str | None) -> Path:
    if not git_ok("check-ref-format", "--branch", branch, cwd=repo.root):
        raise Fail(f"Not a valid branch name: {branch}")

    worktrees = repo.worktrees()
    existing = next((w for w in worktrees if w.branch == branch), None)
    if existing is not None and existing.missing:
        repo.git("worktree", "prune")
        say(dim(f"Pruned the stale registration of {existing.path}"))
        worktrees = repo.worktrees()
        existing = None
    if existing is not None:
        say(f"Worktree already exists: {existing.name}")
        say(f"  Branch: {branch}")
        say(f"  Path: {existing.path}")
        return existing.path

    if not slug(branch):
        raise Fail(f"{branch} makes no usable folder name")
    path = repo.folder(branch)
    is_main = branch == repo.main_branch
    if not is_main and same_path(path, repo.main_path):
        raise Fail(f"{branch} would take the main worktree's folder {path}; pick another name")
    occupant = next((w for w in worktrees if same_path(w.path, path)), None)
    if occupant is not None:
        if occupant.missing:
            repo.git("worktree", "prune")
        else:
            raise Fail(
                f"{path} already holds {occupant.label}; {branch} would share its "
                "folder, so pick a branch name that makes a different one"
            )
    if path.exists() or path.is_symlink():
        raise Fail(f"{path} already exists and is not a worktree; move it away first")

    for remote in repo.git("remote").split():
        if (branch.startswith(f"{remote}/")
                and repo.ref_exists(f"refs/remotes/{branch}")
                and not repo.ref_exists(f"refs/heads/{branch}")):
            raise Fail(
                f"{branch} is {remote}'s branch; to work on it, use: "
                f"git-wt add {branch.removeprefix(remote + '/')}"
            )

    if repo.ref_exists(f"refs/heads/{branch}"):
        if base:
            warn(f"{branch} already exists; ignoring -b {base}")
        say(blue(f"Using existing local branch: {branch}"))
        command = ["git", "worktree", "add", str(path), branch]
    elif repo.ref_exists(f"refs/remotes/origin/{branch}"):
        say(blue(f"Checking out origin/{branch}"))
        command = ["git", "worktree", "add", "--track", "-b", branch, str(path), f"origin/{branch}"]
    else:
        if base is None:
            base = repo.main_branch
            if not repo.ref_exists(f"refs/heads/{base}"):
                base = repo.target
        if not repo.ok("rev-parse", "--verify", "--quiet", f"{base}^{{commit}}"):
            raise Fail(f"Base not found: {base}")
        say(blue(f"Creating branch {branch} from {base}"))
        command = ["git", "worktree", "add", "-b", branch, str(path), base]

    if stream(command, repo.root) != 0:
        raise Fail("git worktree add failed")
    say()
    say(green("✓ Worktree created"))
    say(f"  Branch: {branch}")
    say(f"  Path: {path}")
    say()
    if is_main:
        return path
    try:
        bootstrap(path)
    except Fail as error:
        warn(f"Bootstrap failed: {error}")
        warn(f"Re-run it with: git-wt bootstrap {path}")
    return path


def cmd_add(args: argparse.Namespace) -> int:
    repo = Repo.at(current_dir())
    branch = args.branch or pick_branch(repo, fetch=not args.no_fetch)
    path = add_worktree(repo, branch, args.base)
    if args.tmux:
        open_session(repo.session(path), path)
    return 0


def work_flags(worktree: Worktree, work: Work, reason: str | None) -> list[str]:
    flags = []
    if worktree.missing:
        flags.append(red("[MISSING]"))
    elif not worktree.branch:
        flags.append(red("[DETACHED]"))
    elif reason:
        flags.append(green("[MERGED]"))
    if worktree.locked is not None:
        flags.append(yellow("[LOCKED]"))
    if work.changes:
        flags.append(yellow(f"[DIRTY {len(work.changes)}]"))
    # A merged branch's commits being on no remote is how a squash merge
    # looks, not work waiting to be pushed.
    if work.unpushed and not reason:
        flags.append(yellow(f"[UNPUSHED {work.unpushed}]"))
    if work.unreachable:
        flags.append(red(f"[UNREACHABLE {work.unreachable}]"))
    return flags


def list_rows(repo: Repo, merges: Merges, linked: list[Worktree], verbose: bool) -> None:
    width = max(len(w.label) for w in linked)

    def folder(worktree: Worktree) -> str:
        # Mostly the branch name again; only worth showing when it is not.
        return "" if worktree.name == worktree.label else worktree.name

    folders = max(len(folder(w)) for w in linked)
    for worktree in linked:
        work = repo.work(worktree)
        reason = merges.reason(worktree.branch)
        if worktree.missing or not worktree.branch:
            symbol = red("!")
        elif reason:
            symbol = green("✓")
        else:
            symbol = blue("•")
        parts = [f"{symbol} {worktree.label.ljust(width)}"]
        if folders:
            parts.append(dim(folder(worktree).ljust(folders)))
        if verbose:
            parts.append(dim(worktree.head[:8]))
        parts.extend(work_flags(worktree, work, reason))
        if verbose and reason:
            parts.append(dim(reason))
        say("  " + "  ".join(parts).rstrip())


def list_legend(target: str) -> None:
    say()
    say("Legend:")
    say(f"  {green('✓')} merged into {target} (or its pull or merge request is)")
    say(f"  {blue('•')} not merged")
    say(f"  {red('!')} detached HEAD, or its folder is missing")
    say("  [DIRTY n]     uncommitted or untracked files, lost if removed")
    say("  [UNPUSHED n]  commits on no remote; they stay on the branch")
    say("  [LOCKED]      locked with git worktree lock")


def cmd_list(args: argparse.Namespace) -> int:
    if args.all:
        return list_all(args)
    repo = Repo.at(current_dir())
    merges = Merges(repo, fetch=not args.no_fetch)
    main = repo.main_path
    say(f"{bold('Project:')}       {repo.root}")
    say(f"{bold('Main worktree:')} {main}{'' if main.is_dir() else red(' (missing)')}")
    say(f"{bold('Merged into:')}   {repo.target}")
    say()

    linked = [w for w in repo.worktrees() if not w.is_main]
    if not linked:
        say("No worktrees found.")
        say()
        say("Create one with:")
        say("  git-wt add <branch>")
        return 0

    say(bold("Worktrees:"))
    list_rows(repo, merges, linked, args.verbose)
    list_legend(repo.target)
    return 0


def list_all(args: argparse.Namespace) -> int:
    repos = all_projects()
    if not args.no_fetch:
        fetch_all(repos)
    shown = False
    for repo in repos:
        try:
            linked = [w for w in repo.worktrees() if not w.is_main]
            if not linked:
                continue
            say(f"{bold(repo.name)}  {dim(str(repo.root))}")
            list_rows(repo, Merges(repo, fetch=False), linked, args.verbose)
            say()
            shown = True
        except Fail as error:
            warn(f"Skipping {repo.root}: {error}")
    if not shown:
        say("No worktrees found.")
        return 0
    list_legend("its project's main branch")
    return 0


def cmd_switch(args: argparse.Namespace) -> int:
    repo = Repo.at(current_dir())
    worktrees = [w for w in repo.worktrees() if not w.missing]
    worktree = resolve(worktrees, args.target, "Switch to worktree:")
    say(blue(f"Switching to worktree: {worktree.label}"))
    say(f"  Path: {worktree.path}")
    if os.environ.get("TMUX") or args.tmux:
        open_session(repo.session(worktree.path), worktree.path)
    shell = os.environ.get("SHELL") or "/bin/sh"
    os.chdir(worktree.path)
    sys.stdout.flush()
    os.execvp(shell, [shell])
    return 0


def delete_branch(repo: Repo, branch: str) -> None:
    # -D: the merge check above is the safety, and git's own -d refuses
    # branches that were squash-merged.
    result = run(["git", "branch", "-D", branch], cwd=repo.root, check=False)
    if result.returncode == 0:
        say(green(f"✓ Deleted branch {branch}"))
    else:
        warn(f"Could not delete branch {branch}: {result.stderr.strip()}")


def cmd_remove(args: argparse.Namespace) -> int:
    start = current_dir()
    repo = Repo.at(start)
    worktrees = repo.worktrees()
    if args.target is None:
        linked = [w for w in worktrees if not w.is_main]
        if not linked:
            say("No worktrees found.")
            return 0
        worktree = pick_worktree(linked, "Remove worktree:")
    else:
        worktree = resolve(worktrees, args.target, "Remove worktree:")
    if worktree.is_main:
        raise Fail(f"Cannot remove the main worktree: {worktree.path}")
    if worktree.locked is not None:
        why = f" ({worktree.locked})" if worktree.locked else ""
        raise Fail(
            f"{worktree.name} is locked{why}; unlock it first with: "
            f"git worktree unlock {worktree.path}"
        )

    merges = Merges(repo, fetch=not args.no_fetch)
    reason = merges.reason(worktree.branch)

    if worktree.missing:
        repo.git("worktree", "prune")
        say(f"The folder of {worktree.name} was already gone; removed its registration.")
    else:
        work = repo.work(worktree)
        say("Removing worktree:")
        say(f"  Name:   {worktree.name}")
        say(f"  Branch: {worktree.label}")
        say(f"  Path:   {worktree.path}")
        say(f"  Status: {green(reason) if reason else yellow('not merged')}")
        if work.unpushed and not reason:
            say(f"  Unpushed commits: {work.unpushed} (they stay on the branch)")
        if work.unreachable:
            say(red(f"  Commits on no branch: {work.unreachable} (lost when removed)"))
        if work.changes:
            say(yellow(f"  Uncommitted or untracked files: {len(work.changes)}"))
            for change in work.changes[:10]:
                say(f"    {change}")
            if len(work.changes) > 10:
                say(f"    ... and {len(work.changes) - 10} more")
        say()
        if work.at_risk and not args.discard:
            raise Fail(
                f"{worktree.name} has work that removing it would lose. "
                "Commit or stash it, or re-run with --discard to throw it away."
            )
        if not args.force:
            deleting = f" and delete branch {worktree.branch}" if args.delete and reason else ""
            if not confirm(f"Remove {worktree.name}{deleting}?"):
                say("Aborted.")
                return 1
        command = ["git", "worktree", "remove", str(worktree.path)]
        if args.discard:
            command.insert(3, "--force")
        result = run(command, cwd=repo.root, check=False)
        if result.returncode != 0:
            raise Fail(f"git worktree remove failed: {result.stderr.strip()}")
        say(green(f"✓ Removed worktree {worktree.name}"))

    close_session(repo, worktree)
    if worktree.branch:
        if args.delete and reason:
            delete_branch(repo, worktree.branch)
        elif args.delete:
            say(f"Kept branch {worktree.branch}: it is not merged into {repo.target}.")
        elif reason:
            say(dim(f"Branch {worktree.branch} is merged; delete it with: git-wt remove -d, or git branch -D {worktree.branch}"))
    if inside(start, worktree.path):
        home = repo.main_path if repo.main_path.is_dir() else repo.root
        warn(f"Your shell is still in the removed folder; cd {home}")
    return 0


@dataclass
class PrunePlan:
    repo: Repo
    candidates: list[tuple[Worktree, str | None]]
    skipped: list[tuple[Worktree, str]]


def plan_prune(repo: Repo) -> PrunePlan:
    merges = Merges(repo, fetch=False)
    plan = PrunePlan(repo, [], [])
    for worktree in repo.worktrees():
        if worktree.is_main:
            continue
        reason = merges.reason(worktree.branch)
        if worktree.missing:
            plan.candidates.append((worktree, reason))
            continue
        if not reason:
            continue
        if worktree.locked is not None:
            plan.skipped.append((worktree, "locked"))
            continue
        work = repo.work(worktree)
        if work.at_risk:
            plan.skipped.append((worktree, f"{len(work.changes)} uncommitted or untracked files"))
            continue
        plan.candidates.append((worktree, reason))
    return plan


def carry_out(plan: PrunePlan, delete: bool) -> int:
    """Removes the plan's worktrees; returns how many could not be."""
    repo, failures = plan.repo, 0
    for worktree, reason in plan.candidates:
        if worktree.missing:
            repo.git("worktree", "prune")
            say(green(f"✓ Pruned {worktree.name} (folder was gone)"))
        else:
            result = run(
                ["git", "worktree", "remove", str(worktree.path)],
                cwd=repo.root, check=False,
            )
            if result.returncode != 0:
                failures += 1
                warn(f"✗ Could not remove {worktree.name}: {result.stderr.strip()}")
                continue
            say(green(f"✓ Removed {worktree.name}"))
        close_session(repo, worktree)
        if delete and worktree.branch and reason:
            delete_branch(repo, worktree.branch)
    return failures


def cmd_prune(args: argparse.Namespace) -> int:
    repos = all_projects() if args.all else [Repo.at(current_dir())]
    if not args.no_fetch:
        fetch_all(repos)
    plans = []
    for repo in repos:
        try:
            plan = plan_prune(repo)
        except Fail as error:
            if not args.all:
                raise
            warn(f"Skipping {repo.root}: {error}")
            continue
        if plan.candidates or plan.skipped:
            plans.append(plan)

    if not plans:
        say(green("No merged worktrees found. Nothing to prune."))
        return 0
    verb = "Would remove" if args.dry_run else "Will remove"
    for plan in plans:
        if args.all:
            say(f"{bold(plan.repo.name)}  {dim(str(plan.repo.root))}")
        if plan.candidates:
            say(f"{verb} {len(plan.candidates)} worktree(s):")
            for worktree, reason in plan.candidates:
                why = "folder missing" if worktree.missing else reason
                say(f"  {green('✓')} {worktree.label}  {dim(worktree.name)}  {dim(why or '')}")
        if plan.skipped:
            say(f"Skipping {len(plan.skipped)} merged worktree(s):")
            for worktree, why in plan.skipped:
                say(f"  {yellow('!')} {worktree.label}  {dim(worktree.name)}  {yellow(why)}")
        say()
    if args.dry_run or not any(plan.candidates for plan in plans):
        return 0
    if not args.force:
        deleting = " and delete their merged branches" if args.delete else ""
        if not confirm(f"Remove these worktrees{deleting}?"):
            say("Aborted.")
            return 1

    failures = sum(carry_out(plan, args.delete) for plan in plans)
    if failures:
        raise Fail(f"{failures} worktree(s) could not be removed")
    return 0


# --- clone ---

def parse_clone_url(url: str) -> tuple[str, str | None]:
    """What to clone, and the branch a GitHub or GitLab tree page names,
    slashes and all: it can only be told apart from a path inside the
    branch once the remote's branches are known."""
    match = TREE_URL_RE.match(url.split("#", 1)[0].split("?", 1)[0])
    if not match:
        return url, None
    base, rest = match.groups()
    return base, urllib.parse.unquote(rest).strip("/") or None


def project_name(url: str) -> str:
    remote = split_remote(url)
    path = remote[1] if remote else url.rstrip("/")
    return re.split(r"[/:\\]", path)[-1].removesuffix(".git")


def branch_from_tree(repo: Repo, rest: str) -> str:
    branches = [
        ref.removeprefix("refs/remotes/origin/") for ref in
        repo.git("for-each-ref", "--format=%(refname)", "refs/remotes/origin/").split()
    ]
    matching = [b for b in branches if b != "HEAD" and (rest == b or rest.startswith(b + "/"))]
    if not matching:
        raise Fail(f"origin has no branch matching {rest}")
    return max(matching, key=len)


def cmd_clone(args: argparse.Namespace) -> int:
    url, tree = parse_clone_url(args.url)
    name = args.dir or project_name(url)
    if not name:
        raise Fail(f"Cannot tell a folder name from {args.url}; name one")
    root = (current_dir() / name).absolute()
    existed = root.exists()
    if existed and (not root.is_dir() or any(root.iterdir())):
        raise Fail(f"{root} already exists and is not an empty folder")

    common = root / ".bare"
    try:
        root.mkdir(parents=True, exist_ok=True)
        run(["git", "init", "--quiet", "--bare", str(common)], cwd=root)
        (root / ".git").write_text(GITFILE)
        repo = Repo(root, common)
        repo.git("config", "core.logAllRefUpdates", "true")
        repo.git("remote", "add", "origin", url)
        say(f"Cloning {url} into {root}")
        if stream(["git", "fetch", "origin"], root) != 0:
            raise Fail(f"Could not fetch {url}")
        if not repo.git("for-each-ref", "refs/remotes/origin/").strip():
            raise Fail(f"{url} has no branches to clone")
        repo.git("remote", "set-head", "origin", "--auto", check=False)
        main = repo.main_branch
        repo.git("symbolic-ref", "HEAD", f"refs/heads/{main}")
        say()
        main_path = add_worktree(repo, main, None)
    except (Fail, KeyboardInterrupt):
        # Nothing of anyone's is in it yet: it was missing or empty.
        shutil.rmtree(common, ignore_errors=True)
        if existed:
            (root / ".git").unlink(missing_ok=True)
        else:
            shutil.rmtree(root, ignore_errors=True)
        raise

    branch = args.branch or (branch_from_tree(repo, tree) if tree else None)
    path = main_path
    if branch and branch != main:
        path = add_worktree(repo, branch, None)
    if args.tmux:
        open_session(repo.session(path), path)
    return 0


# --- convert ---

def linked_paths(common: Path) -> list[str]:
    """What bootstrap has linked into worktrees, from info/exclude."""
    exclude = common / "info" / "exclude"
    if not exclude.exists():
        return []
    lines = exclude.read_text().splitlines()
    if EXCLUDE_MARKER not in lines:
        return []
    after = lines[lines.index(EXCLUDE_MARKER) + 1:]
    return [line.removeprefix("/") for line in after if line.startswith("/")]


def cmd_convert(args: argparse.Namespace) -> int:
    start = Path(args.path).expanduser().absolute() if args.path else current_dir()
    common = common_dir(start)
    if common is None:
        raise Fail(f"Not in a git repository: {start}")
    if common.name == ".bare":
        raise Fail(f"{common.parent} is already a project")
    root = common.parent
    if (common.name != ".git" or not common.is_dir()
            or git("rev-parse", "--is-bare-repository", cwd=root).strip() != "false"):
        raise Fail(f"Unsupported repository layout: {common} is not a clone's .git directory")
    if (common / "modules").is_dir():
        raise Fail(f"{root} has submodules, whose paths converting would break")
    busy = [marker for marker in IN_PROGRESS if (common / marker).exists()]
    if busy:
        raise Fail(f"{root} is in the middle of an operation ({', '.join(busy)}); finish or abort it first")
    if (root / ".bare").exists():
        raise Fail(f"{root / '.bare'} is in the way; move it first")

    main_branch = find_main_branch(root)
    branch = git("symbolic-ref", "--quiet", "--short", "HEAD", cwd=root, check=False).strip()
    if branch != main_branch:
        raise Fail(
            f"The main checkout has {branch or 'a detached HEAD'} checked out; check out "
            f"{main_branch} there first, so the main worktree keeps its local files"
        )
    main_folder = slug(main_branch)
    if not main_folder:
        raise Fail(f"{main_branch} makes no usable folder name")

    worktrees = parse_worktrees(git("worktree", "list", "--porcelain", "-z", cwd=root), root)
    # Registrations whose folder is gone are pruned, not moved.
    stale = [w for w in worktrees if not w.is_main and w.missing]
    linked = [w for w in worktrees if not w.is_main and not w.missing]
    locked = [w for w in linked if w.locked is not None]
    if locked:
        names = ", ".join(str(w.path) for w in locked)
        raise Fail(f"Unlock these worktrees first, they cannot be moved: {names}")

    main_dest = root / main_folder
    taken: dict[str, Path] = {main_folder: root}
    moves: list[tuple[Worktree, Path]] = []
    for worktree in linked:
        if worktree.branch:
            folder = slug(worktree.branch)
        else:
            folder = slug(worktree.name.removeprefix(f"{root.name}-")) or f"detached-{worktree.head[:8]}"
        if folder in taken:
            raise Fail(f"{worktree.path} and {taken[folder]} would both become {root / folder}")
        taken[folder] = worktree.path
        moves.append((worktree, root / folder))

    say(f"Converting {root} into a project:")
    say(f"  {common}  ->  {root / '.bare'}")
    say(f"  {root} (main checkout)  ->  {main_dest}")
    for worktree, dest in moves:
        say(f"  {worktree.path}  ->  {dest}")
    for worktree in stale:
        say(f"  {worktree.path}  (folder gone; its registration is pruned)")
    say()
    say("Everything that knows the old paths has to catch up: shells and tmux")
    say("sessions standing in them, editors, stow links into the project, and")
    say("virtualenvs such as .venv, which record where they live. mise and")
    say("direnv ask to trust the moved configs again.")
    say()
    if args.dry_run:
        return 0
    if not args.force and not confirm(f"Convert {root.name}?"):
        say("Aborted.")
        return 1

    done: list[str] = []
    stage = root / f".git-wt-convert-{os.getpid()}"
    try:
        if stale:
            git("worktree", "prune", cwd=root)
            done.append("pruned the registrations of missing worktrees")
        # Everything but .git goes into the main worktree's folder, by way
        # of a stage, so a tracked file or folder already named like it is
        # never in the way.
        stage.mkdir()
        for entry in list(root.iterdir()):
            if entry.name not in (".git", stage.name):
                os.rename(entry, stage / entry.name)
        os.rename(stage, main_dest)
        done.append(f"moved the main checkout's files into {main_dest}")

        os.rename(common, root / ".bare")
        common = root / ".bare"
        (root / ".git").write_text(GITFILE)
        repo = Repo(root, common)
        repo.git("config", "core.bare", "true")
        # A bare repository keeps no reflogs by default.
        repo.git("config", "core.logAllRefUpdates", "true")
        done.append(f"moved .git to {common}")

        # Deepest first, so a worktree nested in another leaves before its
        # parent moves.
        for worktree, dest in sorted(moves, key=lambda m: len(str(m[0].path)), reverse=True):
            source = worktree.path
            if inside(source, root):
                source = main_dest / source.relative_to(root)
            shutil.move(source, dest)
            done.append(f"moved {worktree.path} to {dest}")
        if moves:
            repo.git("worktree", "repair", *(str(dest) for _, dest in moves))

        # The old main checkout becomes a worktree like the others: a
        # registration made where nothing is in the way, then moved in.
        # Its index comes along, so what was staged stays staged.
        stage.mkdir()
        registration = stage / main_folder
        repo.git("worktree", "add", "--quiet", "--no-checkout", str(registration), main_branch)
        gitdir = Path((registration / ".git").read_text().split("gitdir:", 1)[1].strip())
        if (common / "index").exists():
            os.replace(common / "index", gitdir / "index")
        os.replace(registration / ".git", main_dest / ".git")
        registration.rmdir()
        stage.rmdir()
        repo.git("worktree", "repair", str(main_dest))
        done.append(f"registered {main_dest} as the main worktree")

        old_targets = {path: root / path for path in linked_paths(common)}
        for _, dest in moves:
            for path, old in old_targets.items():
                link = dest / path
                if link.is_symlink() and os.readlink(link) == str(old):
                    link.unlink()
                    link.symlink_to(main_dest / path)
    except (OSError, Fail) as error:
        steps = "".join(f"\n  - {step}" for step in done) or "\n  (nothing)"
        raise Fail(
            f"Conversion stopped: {error}\nDone so far:{steps}\n"
            f"git -C {main_dest} worktree list shows where everything is."
        ) from error

    say(green(f"✓ Converted {root.name}"))
    say(f"  Main worktree: {main_dest}")
    for _, dest in moves:
        say(f"  Worktree: {dest}")
    return 0


# --- the rest ---

def cmd_bootstrap(args: argparse.Namespace) -> int:
    return bootstrap(Path(args.path), print_index=args.index)


def cmd_session(args: argparse.Namespace) -> int:
    target = Path(args.path).expanduser()
    if not target.is_dir():
        raise Fail(f"Not a folder: {target}")
    target = target.resolve()
    common = common_dir(target)
    if common is None or common.name != ".bare":
        raise Fail(f"{target} is not in a project")
    repo = Repo(common.parent, common)
    if same_path(target, repo.root) or inside(target, repo.common):
        path = repo.main_path
        if not path.is_dir():
            raise Fail(f"{repo.name} has no main worktree at {path}")
    else:
        top = run(["git", "rev-parse", "--show-toplevel"], cwd=target, check=False)
        if top.returncode != 0:
            raise Fail(f"{target} is not in a worktree of {repo.name}")
        path = Path(top.stdout.strip())
    say(f"{repo.session(path)}\t{path}")
    return 0


def cmd_claude_hook(args: argparse.Namespace) -> int:
    # Claude Code reads the worktree path from stdout, so everything else,
    # git's own output included, goes to stderr.
    real_stdout, sys.stdout = sys.stdout, sys.stderr
    try:
        try:
            data = json.load(sys.stdin)
        except json.JSONDecodeError as error:
            raise Fail("Hook input is not JSON") from error
        name = data.get("name") if isinstance(data, dict) else None
        if not name:
            raise Fail("Hook input has no worktree name")
        start = Path(data.get("cwd") or current_dir())
        common = common_dir(start)
        if common is None:
            raise Fail(f"Not in a git repository: {start}")
        if common.name == ".bare":
            repo = Repo(common.parent, common)
            repo.keep_reflogs()
            path = add_worktree(repo, name, None)
        else:
            # Claude Code's own place and branch name. A submodule's git dir
            # lives in its superproject's .git/modules, so the checkout is
            # taken from the working tree, not from the git dir.
            if common.name == ".git":
                top = common.parent
            else:
                top = Path(git("rev-parse", "--show-toplevel", cwd=start).strip())
            path = top / ".claude" / "worktrees" / name
            registered = git("worktree", "list", "--porcelain", cwd=top)
            if f"worktree {path}\n" not in registered + "\n" or not path.is_dir():
                branch = f"worktree-{name}"
                command = ["git", "worktree", "add", str(path)]
                if git_ok("show-ref", "--verify", "--quiet", f"refs/heads/{branch}", cwd=top):
                    command.append(branch)
                else:
                    command[3:3] = ["-b", branch]
                if stream(command, top) != 0:
                    raise Fail("git worktree add failed")
                try:
                    bootstrap(path)
                except Fail as error:
                    warn(f"Bootstrap failed: {error}")
        if not path.is_dir():
            raise Fail(f"Worktree was not created: {path}")
    finally:
        sys.stdout = real_stdout
    print(path)
    return 0


def parser() -> argparse.ArgumentParser:
    top = argparse.ArgumentParser(
        prog="git-wt", description=__doc__.split("\n\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="\n\n".join(__doc__.split("\n\n")[2:]),
    )
    commands = top.add_subparsers(dest="command", required=True, metavar="<command>")

    def command(name: str, help: str) -> argparse.ArgumentParser:
        return commands.add_parser(name, help=help, description=help)

    clone = command(
        "clone",
        "Clone URL as a project: <DIR>/.bare, a worktree for the main branch, and "
        "one for the branch a GitHub or GitLab tree URL points at.",
    )
    clone.add_argument("-b", "--branch", help="also make a worktree for BRANCH")
    clone.add_argument("-t", "--tmux", action="store_true", help="open the last worktree's tmux session")
    clone.add_argument("url")
    clone.add_argument("dir", nargs="?", help="the project folder (default: the repository's name)")
    clone.set_defaults(func=cmd_clone)

    add = command("add", "Create a worktree for a branch and set it up.")
    add.add_argument("-b", "--base", help="branch a new branch off BASE (default: the main branch)")
    add.add_argument("-t", "--tmux", action="store_true", help="open its tmux session")
    add.add_argument("--no-fetch", action="store_true", help="do not fetch origin before picking")
    add.add_argument("branch", nargs="?", help="the branch (default: pick or type one with fzf)")
    add.set_defaults(func=cmd_add)

    list_ = command("list", "List worktrees with their merge and work state.")
    list_.add_argument("-v", "--verbose", action="store_true", help="show why a branch counts as merged")
    list_.add_argument("-a", "--all", action="store_true", help="every project git-projects finds")
    list_.add_argument("--no-fetch", action="store_true", help="do not fetch origin first")
    list_.set_defaults(func=cmd_list)

    switch = command("switch", "Go to a worktree: its tmux session inside tmux, a shell in it outside.")
    switch.add_argument("-t", "--tmux", action="store_true", help="open its tmux session outside tmux too")
    switch.add_argument("target", nargs="?", help="branch, folder name or path (default: pick with fzf)")
    switch.set_defaults(func=cmd_switch)

    remove = command("remove", "Remove a worktree and close its tmux session.")
    remove.add_argument("-f", "--force", action="store_true", help="do not ask for confirmation")
    remove.add_argument("-d", "--delete", action="store_true", help="also delete its branch if merged")
    remove.add_argument("--discard", action="store_true", help="throw away uncommitted and untracked files")
    remove.add_argument("--no-fetch", action="store_true", help="do not fetch origin first")
    remove.add_argument("target", nargs="?", help="branch, folder name or path (default: pick with fzf)")
    remove.set_defaults(func=cmd_remove)

    prune = command("prune", "Remove every worktree whose branch is merged.")
    prune.add_argument("-f", "--force", action="store_true", help="do not ask for confirmation")
    prune.add_argument("-d", "--delete", action="store_true", help="also delete their merged branches")
    prune.add_argument("-a", "--all", action="store_true", help="every project git-projects finds")
    prune.add_argument("--dry-run", action="store_true", help="only show what would be removed")
    prune.add_argument("--no-fetch", action="store_true", help="do not fetch origin first")
    prune.set_defaults(func=cmd_prune)

    convert = command(
        "convert",
        "Turn a plain clone into a project in place: .git becomes .bare, the main "
        "checkout's files, local and uncommitted ones included, move into the main "
        "worktree's folder, and its other worktrees move in next to it.",
    )
    convert.add_argument("-f", "--force", action="store_true", help="do not ask for confirmation")
    convert.add_argument("--dry-run", action="store_true", help="only show what would move")
    convert.add_argument("path", nargs="?", help="the clone (default: the current one)")
    convert.set_defaults(func=cmd_convert)

    boot = command(
        "bootstrap",
        "Set a worktree up from the main worktree: copy .worktreeinclude files, "
        "link .worktreelink paths, allow direnv, trust mise, run the "
        "worktree:setup mise task with WORKTREE_INDEX and WORKTREE_MAIN.",
    )
    boot.add_argument("--index", action="store_true", help="only print the worktree's WORKTREE_INDEX")
    boot.add_argument("path", nargs="?", default=".")
    boot.set_defaults(func=cmd_bootstrap)

    session = command(
        "session",
        "Print the tmux session name and folder of the worktree PATH is in, tab "
        "separated; for the project folder itself, its main worktree's.",
    )
    session.add_argument("path", nargs="?", default=".")
    session.set_defaults(func=cmd_session)

    hook = command(
        "claude-hook",
        "Claude Code WorktreeCreate hook: reads the hook JSON on stdin, prints the worktree path.",
    )
    hook.set_defaults(func=cmd_claude_hook)
    return top


def main() -> int:
    args = parser().parse_args()
    try:
        return args.func(args)
    except Fail as error:
        sys.stdout.flush()
        print(colour(f"Error: {error}", "31", sys.stderr), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
