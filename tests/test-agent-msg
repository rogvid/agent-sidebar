#!/usr/bin/env bash
# End-to-end checks for agent-msg on a throwaway tmux server: what reaches
# an agent's pane, what the log keeps, whose inbox a message lands in, and
# that concurrent writers never share an id.
#
# The agents are stand-ins named after harnesses, so agent-scan lists them
# and reads their state off the screen: one waits at a prompt with
# bracketed paste on and records every byte it is sent (`claude draft` has
# unsent text in its input box, and `claude suggest` a dim suggested
# prompt), one sits on a permission dialog.
#
# Run: tests/test-agent-msg     (or `mise run test`)

set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
readonly repo
readonly socket="agent-msg-test-$$"
scratch="$(mktemp -d)"
readonly scratch

cleanup() {
    tmux -L "${socket}" kill-server 2>/dev/null || true
    rm -rf "${scratch}"
}
trap cleanup EXIT

readonly received="${scratch}/received"
mkdir -p "${scratch}/bin" "${received}"
# An idle agent: a direct #!/bin/bash, so the process keeps the name claude
# (and cat does not replace it).
cat >"${scratch}/bin/claude" <<EOF
#!/bin/bash
# A pane started again keeps the old screen until something clears it.
printf '\e[H\e[2J'
rule="\$(printf '─%.0s' {1..60})"
if [[ "\${1:-}" == draft ]]; then
    printf '%s\n' "\${rule}" "❯ half a thought" "\${rule}"
elif [[ "\${1:-}" == suggest ]]; then
    printf '%s\n' "\${rule}" $'❯ \e[2mrun the tests again\e[0m' "\${rule}"
fi
printf '\e[?2004h❯ '
stty raw -echo
cat >"${received}/\${TMUX_PANE#%}"
EOF
# An agent waiting on a permission dialog.
cat >"${scratch}/bin/codex" <<EOF
#!/bin/bash
printf 'Do you want to run this command?\n❯ 1. Yes\n  2. No\n\nEsc to cancel\n'
stty raw -echo
cat >"${received}/\${TMUX_PANE#%}"
EOF
chmod +x "${scratch}/bin/"*

# A pre-commit hook hands down GIT_INDEX_FILE and friends.
while IFS= read -r var; do unset "${var}"; done < <(env | awk -F= '/^GIT_/ { print $1 }')
readonly project="${scratch}/app"
git init -q -b main "${project}"

export PATH="${scratch}/bin:${repo}/bin:${PATH}"
# agent-scan is a uv script: keep uv's Python and cache out of the fake
# home, or every run downloads them again.
UV_CACHE_DIR="$(uv cache dir)" UV_PYTHON_INSTALL_DIR="$(uv python dir)"
export UV_CACHE_DIR UV_PYTHON_INSTALL_DIR
export HOME="${scratch}/home" XDG_STATE_HOME="${scratch}/state"
# The stand-ins listen at once, where a real harness takes seconds; the
# wait for one just started has a check of its own.
export AGENT_MSG_WARMUP=0
mkdir -p "${HOME}"
readonly messages="${XDG_STATE_HOME}/agent-sidebar/messages.jsonl"
readonly delivered="${XDG_STATE_HOME}/agent-sidebar/messages-delivered.jsonl"
readonly nudged="${XDG_STATE_HOME}/agent-sidebar/messages-nudged.jsonl"
unset TMUX TMUX_PANE

t() { tmux -L "${socket}" "$@"; }

t -f /dev/null new-session -d -s scratch -x 160 -y 40
t set-option -g default-shell /bin/sh
TMUX="$(t display-message -p '#{socket_path},#{pid},0')"
export TMUX

# Start COMMAND in a new session NAME; print its pane id.
start() {
    t new-session -d -s "$1" -x 160 -y 40 -c "${project}" -P -F '#{pane_id}' "$2"
}
# Wait until PANE shows TEXT, which a stand-in draws once it listens.
wait_for() {
    local _
    for _ in $(seq 50); do
        t capture-pane -p -t "$1" | grep -qF "$2" && return 0
        sleep 0.1
    done
    echo "      ${1} never showed ${2}" >&2
    return 1
}
# Wait until PANE no longer shows TEXT: a pane started again shows its old
# screen until the new stand-in clears it.
wait_gone() {
    local _
    for _ in $(seq 50); do
        t capture-pane -p -t "$1" | grep -qF "$2" || return 0
        sleep 0.1
    done
    echo "      ${1} still shows ${2}" >&2
    return 1
}
# What PANE's agent has been sent, once the paste has had time to land;
# with SKIP, only what came after its first SKIP bytes.
got() {
    sleep 0.2
    tail -c "+$((${2:-0} + 1))" "${received}/${1#%}" 2>/dev/null
}
size() {
    wc -c <"${received}/${1#%}" | tr -d ' '
}

orch="$(start orchestrator claude)"
worker="$(start app-feat-x claude)"
dialog="$(start app-feat-y codex)"
shell="$(start app-shell 'sleep 3600')"
wait_for "${orch}" '❯'
wait_for "${worker}" '❯'
wait_for "${dialog}" 'Esc to cancel'

failures=0
total=0
check() {
    local name="$1"
    shift
    total=$((total + 1))
    if "$@"; then
        printf 'ok    %s\n' "${name}"
    else
        printf 'FAIL  %s\n' "${name}"
        failures=$((failures + 1))
    fi
}
same() {
    [[ "$1" == "$2" ]] || { printf '      want %q\n      got  %q\n' "$2" "$1"; return 1; }
}
has() {
    [[ "$1" == *"$2"* ]] || { printf '      want it to contain %q\n      got %q\n' "$2" "$1"; return 1; }
}
# A field of message ID in the log, as compact JSON.
field() {
    jq -cR --argjson id "$1" "fromjson? | select(.id == \$id) | $2" "${messages}"
}
count() {
    if [[ -f "${messages}" ]]; then wc -l <"${messages}" | tr -d ' '; else echo 0; fi
}

msg() { TMUX_PANE="${orch}" agent-msg "$@"; }
as_worker() { TMUX_PANE="${worker}" agent-msg "$@"; }

# --- send ---

out="$(msg send "${worker}" "fix the test; then commit")"
check "send says what it sent where" same "${out}" "sent msg 1 to app-feat-x ${worker}"
check "the agent gets one bracketed paste, header first, then Enter" \
    same "$(got "${worker}")" \
    $'\e[200~[msg 1 from orchestrator '"${orch}"$' · verify: agent-msg verify 1 · reply: agent-msg reply 1 "..."]\rfix the test; then commit\e[201~\r'
check "the log keeps who sent it to whom" \
    same "$(field 1 '[.kind, .from, .to, .reply_to, .text]')" \
    "$(jq -c -n --arg orch "${orch}" --arg worker "${worker}" '["send",
        {pane: $orch, session: "orchestrator", project: "app", branch: "main"},
        {pane: $worker, session: "app-feat-x", project: "app", branch: "main"},
        null, "fix the test; then commit"]')"
check "and when" test -n "$(field 1 '.time | fromdateiso8601')"

skip="$(size "${worker}")"
printf 'line one\nline two;\n' | msg send "${worker}" >/dev/null
check "text on stdin keeps its newlines inside the paste, so only the last Enter submits" \
    same "$(got "${worker}" "${skip}")" \
    $'\e[200~[msg 2 from orchestrator '"${orch}"$' · verify: agent-msg verify 2 · reply: agent-msg reply 2 "..."]\rline one\rline two;\e[201~\r'
check "and is logged whole" same "$(field 2 .text)" '"line one\nline two;"'

# --- refusals: nothing pasted, nothing logged ---

before="$(count)"
out="$(msg send "${shell}" "rm -rf /" 2>&1)" && status=0 || status=$?
check "a pane with no agent is refused" test "${status}" -ne 0
check "because the text would run there" has "${out}" "runs no agent"
out="$(msg send %9999 "hi" 2>&1)" && status=0 || status=$?
check "a pane that does not exist is refused" \
    same "${status} ${out}" "1 agent-msg: no pane %9999"
out="$(msg send "${orch}" "hi" 2>&1)" && status=0 || status=$?
check "so is your own pane" same "${status} ${out}" "1 agent-msg: ${orch} is your own pane"
out="$(msg send app-feat-x "hi" 2>&1)" && status=0 || status=$?
check "and a session name, which tmux would resolve loosely" test "${status}" -ne 0
out="$(msg send "${worker}" "   " 2>&1)" && status=0 || status=$?
check "an empty message is refused" same "${status} ${out}" "1 agent-msg: the message is empty"
out="$(TMUX_PANE="" agent-msg send "${worker}" "hi" 2>&1)" && status=0 || status=$?
check "outside tmux there is nobody to answer" test "${status}" -ne 0
check "none of those were logged" same "$(count)" "${before}"
check "or pasted" same "$(got "${worker}" "${skip}")" \
    $'\e[200~[msg 2 from orchestrator '"${orch}"$' · verify: agent-msg verify 2 · reply: agent-msg reply 2 "..."]\rline one\rline two;\e[201~\r'

# --- reply ---

out="$(as_worker reply 1 "fixed and committed")"
check "reply says where it went" same "${out}" "sent reply 3 to orchestrator ${orch}"
check "it goes to the original sender, answering the message" \
    same "$(field 3 '[.kind, .from.pane, .to.pane, .reply_to]')" \
    "[\"reply\",\"${worker}\",\"${orch}\",1]"
check "and is pasted into the sender's pane, under a header saying what it answers" \
    same "$(got "${orch}")" \
    $'\e[200~[reply 3 to msg 1 from app-feat-x '"${worker}"$' · verify: agent-msg verify 3 · reply: agent-msg reply 3 "..."]\rfixed and committed\e[201~\r'
check "every message is logged to be pushed" same "$(field 3 .push)" true
check "and its delivery recorded, with the pane it went to" \
    same "$(jq -c 'select(.id == 3) | [.id, .pane]' "${delivered}")" "[3,\"${orch}\"]"
out="$(as_worker reply 99 "hi" 2>&1)" && status=0 || status=$?
check "a reply to no message is refused" same "${status} ${out}" "1 agent-msg: no message 99"
out="$(as_worker reply 3 "talking to myself" 2>&1)" && status=0 || status=$?
check "and so is a reply to your own message" \
    same "${status} ${out}" "1 agent-msg: message 3 is your own"

# --- verify ---

out="$(as_worker verify 1)" && status=0 || status=$?
check "the receiver verifies a message sent to it" same "${status}" 0
check "and is told who sent it" \
    has "${out}" "VERIFIED: message 1 was sent to you by orchestrator ${orch} at "
check "and what was logged, which is what to act on" \
    has "${out}" $'Its text as logged:\n\nfix the test; then commit'
read_marks() {
    jq -c '[.id, .by]' "${XDG_STATE_HOME}/agent-sidebar/messages-read.jsonl" | paste -sd ' '
}
check "and it is marked read, by the pane that verified it" \
    same "$(read_marks)" "[1,\"${worker}\"]"
out="$(as_worker verify 2 "line one line three;" 2>&1)" && status=0 || status=$?
check "altered text is not verified (5)" same "${status}" 5
check "saying so" has "${out}" "NOT VERIFIED: the text differs from message 2"
check "nor marked read" same "$(read_marks)" "[1,\"${worker}\"]"
out="$(printf 'line one\r\nline two;  \n' | as_worker verify 2 -)" && status=0 || status=$?
check "the pasted text checks out however its newlines and spaces arrived" \
    same "${status}" 0
check "and says so" has "${out}" "and its text matches"
out="$(as_worker verify 2 "line one line two;")" && status=0 || status=$?
check "the text can be given as arguments too" same "${status}" 0
check "a message verified again is marked read only once" \
    same "$(read_marks)" "[1,\"${worker}\"] [2,\"${worker}\"]"
out="$(as_worker verify 42 2>&1)" && status=0 || status=$?
check "a message that is not in the log is not verified (3)" same "${status}" 3
check "saying so" has "${out}" "NOT VERIFIED: there is no message 42"
out="$(msg verify 1 2>&1)" && status=0 || status=$?
check "nor is one sent to someone else (4)" same "${status}" 4
check "saying who it was for" \
    has "${out}" "message 1 was sent to app-feat-x ${worker}, not to you (orchestrator ${orch})"
check "and marks nothing read for whoever asked" \
    same "$(read_marks)" "[1,\"${worker}\"] [2,\"${worker}\"]"
# A harness can run commands with a stdin that never closes.
out="$(timeout 5 env TMUX_PANE="${worker}" agent-msg verify 1 < <(sleep 10))" &&
    status=0 || status=$?
check "an open stdin is not waited on" same "${status}" 0

# --- inbox ---

out="$(msg inbox --unread)"
check "the sender finds the reply in its inbox" has "${out}" "#3  "
check "with who sent it and what it answers" \
    has "${out}" "app-feat-x ${worker} → orchestrator ${orch}  re #1  unread"
check "and its text" has "${out}" $'\n    fixed and committed'
check "and nothing sent by it" same "$(grep -oE '^#[0-9]+' <<<"${out}")" "#3"

msg inbox --unread --mark-read >/dev/null
check "read, it leaves the unread inbox" \
    same "$(msg inbox --unread)" "no unread messages for ${orch}"
check "but stays in the inbox" has "$(msg inbox)" "#3  "
check "read by the pane that read it" \
    same "$(read_marks)" "[1,\"${worker}\"] [2,\"${worker}\"] [3,\"${orch}\"]"
check "the worker's inbox has both its messages, read once verified" \
    same "$(as_worker inbox --json | jq -c '[.[] | [.id, .unread]]')" \
    '[[1,false],[2,false]]'
check "inbox SESSION reads a session's messages" \
    same "$(agent-msg inbox --json app-feat-x | jq -c 'map(.id)')" '[1,2]'

# The orchestrator's session is killed and started again under its name:
# a new pane id, and the old one gone.
t kill-session -t orchestrator
orch_before="${orch}"
orch="$(start orchestrator claude)"
wait_for "${orch}" '❯'
out="$(as_worker reply 2 "both lines seen")"
check "a restarted session's pane inherits the mail of the pane it replaced" \
    same "$(msg inbox --json | jq -c 'map(.id)')" '[3,4]'
check "and a message to the pane before it is pasted into it" \
    same "${out} $(got "${orch}")" \
    "sent reply 4 to orchestrator ${orch} "$'\e[200~[reply 4 to msg 2 from app-feat-x '"${worker}"$' · verify: agent-msg verify 4 · reply: agent-msg reply 4 "..."]\rboth lines seen\e[201~\r'
check "and can verify it" same "$(msg verify 3 >/dev/null && echo ok)" ok
second="$(t split-window -d -t "${orch}" -c "${project}" -P -F '#{pane_id}' claude)"
wait_for "${second}" '❯'
msg send "${worker}" "status?" >/dev/null
as_worker reply 5 "all green" >/dev/null
check "mail to a pane that still lives is not another pane's in its session" \
    same "$(TMUX_PANE="${second}" agent-msg inbox --json | jq -c 'map(.id)')" '[3,4]'
check "while the pane it went to has it" \
    same "$(msg inbox --json | jq -c 'map(.id)')" '[3,4,6]'

# --- log ---

out="$(agent-msg log)"
check "log shows every message, oldest first" \
    same "$(grep -oE '^#[0-9]+' <<<"${out}" | tr '\n' ' ')" "#1 #2 #3 #4 #5 #6 "
check "log --thread follows a conversation from any message in it" \
    same "$(agent-msg log --json --thread 3 | jq -c 'map(.id)')" '[1,3]'
check "log --from takes a pane" \
    same "$(agent-msg log --json --from "${orch_before}" | jq -c 'map(.id)')" '[1,2]'
check "log --to takes a session" \
    same "$(agent-msg log --json --to orchestrator | jq -c 'map(.id)')" '[3,4,6]'
check "log --with takes either side" \
    same "$(agent-msg log --json --with "${orch}" | jq -c 'map(.id)')" '[5,6]'
check "log --last keeps the newest" \
    same "$(agent-msg log --json --last 2 | jq -c 'map(.id)')" '[5,6]'
check "and all of them when there are fewer" \
    same "$(agent-msg log --json --last 50 | jq -c 'length')" '6'

# tmux numbers panes from %0 again when its server restarts, so an old
# message can name a pane id that now belongs to someone else.
jq -nc --arg worker "${worker}" '{id: 7, time: "2026-01-01T00:00:00Z",
    kind: "send", from: {pane: "%0", session: "old", project: "app", branch: "main"},
    to: {pane: $worker, session: "before-restart", project: "app", branch: "main"},
    reply_to: null, text: "old"}' >>"${messages}"
check "a pane id used again in another session does not get the old pane's mail" \
    same "$(as_worker inbox --json | jq -c 'map(.id)')" '[1,2,5]'

# A line cut short by a crash is skipped, not fatal.
printf '{"id":8,"time":"2026-' >>"${messages}"
printf '\n' >>"${messages}"
check "a broken line in the log is skipped" \
    same "$(agent-msg log --json | jq -c 'length')" '7'

# --- concurrency ---

for i in $(seq 20); do
    as_worker reply 1 "parallel ${i}" >/dev/null &
    msg inbox --unread --mark-read >/dev/null &
done
wait
check "concurrent writers never share an id" \
    same "$(jq -cR 'fromjson? | .id' "${messages}" | sort -n | uniq -d)" ""
check "or lose a message" \
    same "$(agent-msg log --json | jq -c '[.[] | select(.text | startswith("parallel"))] | length')" '20'
check "and every read mark is whole" \
    same "$(jq -cR 'fromjson? | .id' "${XDG_STATE_HOME}/agent-sidebar/messages-read.jsonl" | wc -l)" \
    "$(wc -l <"${XDG_STATE_HOME}/agent-sidebar/messages-read.jsonl")"
check "and none marked twice" \
    same "$(jq -cR 'fromjson? | .id' "${XDG_STATE_HOME}/agent-sidebar/messages-read.jsonl" | sort -n | uniq -d)" ""

# --- a pane scrolled up ---

# Scrolled up, the pane is in copy mode. That takes Enter for itself, and
# a paste into it loses its brackets, so the message would be cut at its
# first newline and the rest left in the input box, never submitted.
t copy-mode -t "${worker}"
skip="$(size "${worker}")"
printf 'line one\nline two;\n' | msg send "${worker}" >/dev/null
id="$(agent-msg log --json --last 1 | jq '.[0].id')"
check "a pane scrolled up in copy mode gets the message as one paste, submitted" \
    same "$(got "${worker}" "${skip}")" \
    $'\e[200~[msg '"${id}"' from orchestrator '"${orch}"$' · verify: agent-msg verify '"${id}"$' · reply: agent-msg reply '"${id}"$' "..."]\rline one\rline two;\e[201~\r'
check "and is back at the bottom, showing it" \
    same "$(t display-message -p -t "${worker}" '#{pane_in_mode}')" 0

# --- queued, and delivered later ---

# The id the next message gets.
next() {
    agent-msg log --json | jq '[.[].id] | max + 1'
}
delivered_to() {
    jq -c --argjson id "$1" 'select(.id == $id) | .pane' "${delivered}" 2>/dev/null
}
nudged_to() {
    jq -c --argjson id "$1" 'select(.id == $id) | .pane' "${nudged}" 2>/dev/null
}

id="$(next)"
out="$(msg send "${dialog}" "yes please")"
check "a message to a blocked agent is queued, saying why" \
    has "${out}" "queued msg ${id} for app-feat-y ${dialog}: ${dialog} is blocked on a dialog (Do you want to run this command?)."
check "and that nothing will paste it while no deliver --watch runs" \
    has "${out}" "No agent-msg deliver --watch is running"
check "its dialog gets nothing" same "$(got "${dialog}")" ""
check "it is logged, to be pushed" same "$(field "${id}" .push)" true
agent-msg deliver
check "deliver leaves it queued while the dialog is up" \
    same "$(got "${dialog}") $(delivered_to "${id}")" " "
# The dialog answered: the same pane, now at its prompt.
t respawn-pane -k -t "${dialog}" claude
wait_gone "${dialog}" 'Esc to cancel'
wait_for "${dialog}" '❯'
agent-msg deliver
check "once it clears, deliver pastes it under its header" \
    same "$(got "${dialog}")" \
    $'\e[200~[msg '"${id}"' from orchestrator '"${orch}"$' · verify: agent-msg verify '"${id}"$' · reply: agent-msg reply '"${id}"$' "..."]\ryes please\e[201~\r'
check "and records it delivered" same "$(delivered_to "${id}")" "\"${dialog}\""
skip="$(size "${dialog}")"
agent-msg deliver
check "a delivered message is not pasted again" same "$(got "${dialog}" "${skip}")" ""

drafting="$(start app-draft 'claude draft')"
wait_for "${drafting}" 'half a thought'
first="$(next)"
out="$(msg send "${drafting}" "when you have a moment")"
check "a message to a pane with unsent text in its input is queued" \
    has "${out}" "queued msg ${first} for app-draft ${drafting}: ${drafting} has unsent text in its input."
check "rather than pasted into the middle of it" same "$(got "${drafting}")" ""
id="$(next)"
out="$(AGENT_MSG_WARMUP=3600 msg send "${worker}" "too soon")"
check "a harness just started is not pasted into, as it is not listening yet" \
    has "${out}" "queued msg ${id} for app-feat-x ${worker}: ${worker} has only just started, and is not listening yet."
agent-msg deliver
check "and gets it once it has had time" same "$(delivered_to "${id}")" "\"${worker}\""
suggesting="$(start app-suggest 'claude suggest')"
wait_for "${suggesting}" 'run the tests again'
check "a dim suggested prompt in the box is nobody's typing, so it is pasted" \
    has "$(msg send "${suggesting}" "hello")" "sent msg "

# A message to a pane that is gone goes to the one agent left in its
# session, but not back to its own sender.
alone="$(start app-pair claude)"
wait_for "${alone}" '❯'
gone="$(t split-window -d -t "${alone}" -P -F '#{pane_id}' codex)"
wait_for "${gone}" 'Esc to cancel'
id="$(next)"
TMUX_PANE="${alone}" agent-msg send "${gone}" "to my neighbour" >/dev/null
t kill-pane -t "${gone}"
agent-msg deliver
check "a message whose pane is gone is not pasted back into its sender" \
    same "$(got "${alone}") $(delivered_to "${id}")" " "

# Waiting long, its sender is told: AGENT_MSG_NUDGE=0 makes any wait long.
from_shell="$(next)"
TMUX_PANE="${shell}" agent-msg send "${drafting}" "from a shell" >/dev/null
blocker="$(start app-blocked codex)"
wait_for "${blocker}" 'Esc to cancel'
from_blocked="$(next)"
TMUX_PANE="${blocker}" agent-msg send "${drafting}" "from a dialog" >/dev/null
skip="$(size "${orch}")"
AGENT_MSG_NUDGE=0 agent-msg deliver
note="$(got "${orch}" "${skip}")"
check "the sender of a message that waits long is told, by a note" \
    has "${note}" $'\e[200~[note from agent-msg · msg '"${first}"' to app-draft '"${drafting}"' is still queued after '
check "saying why it waits, pasted and submitted" \
    has "${note}" ': '"${drafting}"$' has unsent text in its input · it is pasted once that clears]\e[201~\r'
check "and recorded as told" same "$(nudged_to "${first}")" "\"${orch}\""
check "a sender that runs no agent is recorded as told nobody" \
    same "$(nudged_to "${from_shell}")" null
check "one blocked on a dialog itself is left to a later pass" \
    same "$(got "${blocker}") $(nudged_to "${from_blocked}")" " "
t respawn-pane -k -t "${blocker}" claude
wait_gone "${blocker}" 'Esc to cancel'
wait_for "${blocker}" '❯'
skip="$(size "${orch}")"
AGENT_MSG_NUDGE=0 agent-msg deliver
check "which tells it once it clears" \
    has "$(got "${blocker}")" "[note from agent-msg · msg ${from_blocked} to app-draft ${drafting} is still queued"
check "and tells a sender only once" same "$(got "${orch}" "${skip}")" ""
check "while the messages still wait" \
    same "$(delivered_to "${first}")$(delivered_to "${from_shell}")$(delivered_to "${from_blocked}")" ""

id="$(next)"
TMUX_PANE="${shell}" agent-msg send "${worker}" "sent from a shell" >/dev/null
out="$(as_worker reply "${id}" "seen")"
check "a reply to a pane that runs no agent is only logged, for its inbox" \
    same "${out}" "reply $((id + 1)) logged for app-shell ${shell}, which runs no agent; they read it with agent-msg inbox"
check "not to be pushed" same "$(field "$((id + 1))" .push)" false
check "and its inbox has it" \
    same "$(agent-msg inbox --json "${shell}" | jq -c 'map(.id)')" "[$((id + 1))]"

# A day in the queue is enough: older, it is left to the inbox.
jq -nc --arg worker "${worker}" --arg orch "${orch}" '{id: 1000,
    time: "2026-01-01T00:00:00Z", kind: "send",
    from: {pane: $orch, session: "orchestrator", project: "app", branch: "main"},
    to: {pane: $worker, session: "app-feat-x", project: "app", branch: "main"},
    reply_to: null, text: "stale", push: true}' >>"${messages}"
skip="$(size "${worker}")"
agent-msg deliver
check "a message queued for more than a day is not pasted" \
    same "$(got "${worker}" "${skip}")" ""

AGENT_MSG_INTERVAL=0.2 agent-msg deliver --watch &
watcher=$!
sleep 0.5
timeout 5 agent-msg deliver --watch && status=0 || status=$?
check "a second deliver --watch leaves it to the one running" same "${status}" 0
id="$(next)"
out="$(msg send "${drafting}" "still there?")"
check "while one runs, a queued message is said to be pasted once it clears" \
    has "${out}" "agent-msg deliver pastes it once that clears, and tells you if it still waits in 10m."
t respawn-pane -k -t "${drafting}" claude
wait_gone "${drafting}" 'half a thought'
wait_for "${drafting}" '❯'
for _ in $(seq 50); do
    [[ -n "$(delivered_to "${id}")" ]] && break
    sleep 0.1
done
check "deliver --watch pastes the queue, oldest first, once it clears" \
    same "$(got "${drafting}" | tr '\r' '\n' | grep -oE '\[msg [0-9]+' | paste -sd ' ')" \
    "[msg ${first} [msg ${from_shell} [msg ${from_blocked} [msg ${id}"

# A watcher whose script is updated under it, as TPM does, goes on as the
# new code: a copy of its own, with a log of its own.
mkdir -p "${scratch}/updated"
cp "${repo}/bin/agent-msg" "${scratch}/updated/agent-msg"
XDG_STATE_HOME="${scratch}/updated" AGENT_MSG_INTERVAL=0.2 \
    "${scratch}/updated/agent-msg" deliver --watch &
updated=$!
sleep 0.5
sed -i "2i touch '${scratch}/updated/ran'" "${scratch}/updated/agent-msg"
for _ in $(seq 50); do
    [[ -e "${scratch}/updated/ran" ]] && break
    sleep 0.1
done
check "an updated deliver --watch runs its new code" test -e "${scratch}/updated/ran"
XDG_STATE_HOME="${scratch}/updated" timeout 5 agent-msg deliver --watch && status=0 || status=$?
check "still the one watcher, holding the lock" \
    same "${status} $(kill -0 "${updated}" && echo running)" "0 running"

XDG_STATE_HOME="" msg send "${worker}" "hi" >/dev/null
check "without XDG_STATE_HOME the log is in ~/.local/state" \
    test -s "${HOME}/.local/state/agent-sidebar/messages.jsonl"

t kill-server
for _ in $(seq 50); do
    kill -0 "${watcher}" 2>/dev/null || break
    sleep 0.1
done
kill -0 "${watcher}" 2>/dev/null && status=0 || status=$?
check "deliver --watch stops with the tmux server" test "${status}" -ne 0
wait "${updated}" 2>/dev/null || true

printf '\n%s/%s passed\n' "$((total - failures))" "${total}"
((failures == 0))
