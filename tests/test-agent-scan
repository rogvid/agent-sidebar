def row(**overrides):
    """A Row with every field filled, for exercising the renderer."""
    fields = dict(
        state="done", target="s:1.0", agent="claude", context="10.0k",
        duration="5m", block="1h", weekly="-", age="2h",
        message="hello", flag=" ",
    )
    return AGENT_SCAN.Row(**(fields | overrides))


# A column every row reports as `-` carries nothing and is dropped, which is
# what keeps the weekly notice from costing width the rest of the time.
COLLAPSE_CASES = (
    ("hidden when nothing reports it", "-", False),
    ("shown as soon as one row has it", "95%", True),
)


def main() -> int:
    global AGENT_SCAN
    AGENT_SCAN = mod = load_agent_scan()
    failures = 0

    for name, sample, want in STATE_CASES:
        got = mod.classify(mod.visible_lines(sample))
        ok = got == want
        failures += not ok
        print(f"{'ok  ' if ok else 'FAIL'}  state    {name:36} "
              f"want={want:8} got={got}")

    for name, sample, want in CONTEXT_CASES:
        got = mod.parse_context(mod.visible_lines(sample))
        ok = got == want
        failures += not ok
        print(f"{'ok  ' if ok else 'FAIL'}  context  {name:36} "
              f"want={want:8} got={got}")

    for name, sample, want in AGE_CASES:
        got = mod.parse_age(mod.visible_lines(sample))
        ok = got == want
        failures += not ok
        print(f"{'ok  ' if ok else 'FAIL'}  age      {name:36} "
              f"want={str(want):8} got={got}")

    for name, sample, want in BLOCK_CASES:
        got = mod.parse_block(mod.visible_lines(sample))
        ok = got == want
        failures += not ok
        print(f"{'ok  ' if ok else 'FAIL'}  block    {name:36} "
              f"want={str(want):8} got={got}")

    for name, sample, want in COLOR_CASES:
        got = mod.context_color(sample)
        ok = got == getattr(mod, want)
        failures += not ok
        print(f"{'ok  ' if ok else 'FAIL'}  ctxcolor {name:36} "
              f"want={want:8} got={got!r}")

    for name, state, sample, want in MESSAGE_CASES:
        got = mod.pick_message(state, mod.visible_lines(sample))
        ok = got == want
        failures += not ok
        print(f"{'ok  ' if ok else 'FAIL'}  message  {name:36} "
              f"{'ok' if ok else f'want={want!r} got={got!r}'}")

    for name, state, sample, want in DURATION_CASES:
        got = mod.state_duration(state, mod.visible_lines(sample), NOW)
        ok = got == want
        failures += not ok
        print(f"{'ok  ' if ok else 'FAIL'}  duration {name:36} "
              f"want={want:8} got={got}")

    for name, sample, want in WEEKLY_CASES:
        got = mod.parse_weekly(mod.visible_lines(sample))
        ok = got == want
        failures += not ok
        print(f"{'ok  ' if ok else 'FAIL'}  weekly   {name:36} "
              f"want={str(want):8} got={got}")

    for name, sample, want in WEEKLY_COLOR_CASES:
        got = mod.weekly_color(sample)
        ok = got == getattr(mod, want)
        failures += not ok
        print(f"{'ok  ' if ok else 'FAIL'}  wkcolor  {name:36} "
              f"want={want:8} got={got!r}")

    for name, weekly, want in COLLAPSE_CASES:
        line = mod.render([row(weekly=weekly)], color=False)[0]
        ok = ("wk" in line) == want
        failures += not ok
        print(f"{'ok  ' if ok else 'FAIL'}  collapse {name:36} "
              f"want={'shown' if want else 'hidden':8} got={line.strip()!r}")

    total = (len(STATE_CASES) + len(CONTEXT_CASES) + len(AGE_CASES)
             + len(BLOCK_CASES) + len(COLOR_CASES) + len(DURATION_CASES)
             + len(MESSAGE_CASES) + len(WEEKLY_CASES)
             + len(WEEKLY_COLOR_CASES)
             + len(COLLAPSE_CASES))
    print(f"\n{total - failures}/{total} passed")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
