def message(id: int, sender: tuple[str, str], to: tuple[str, str],
            text: str = "hello", reply_to: int | None = None,
            ago: float = 120) -> dict:
    """A line of agent-msg's log, sent ago seconds before now."""
    def end(address):
        session, pane = address
        return {"pane": pane, "session": session, "project": session,
                "branch": "main"}
    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - ago))
    return {"id": id, "time": stamp, "kind": "reply" if reply_to else "send",
            "from": end(sender), "to": end(to), "reply_to": reply_to,
            "text": text}


def append(path: Path, *lines: dict | str) -> None:
    with path.open("a") as file:
        for line in lines:
            file.write((line if isinstance(line, str) else json.dumps(line))
                       + "\n")


def message_log_cases(mod) -> list[tuple[str, bool, str]]:
    """MessageLog reads agent-msg's log as it grows, and finds each pane's
    unread messages by agent-msg's inbox rule."""
    results: list[tuple[str, bool, str]] = []

    def check(name: str, ok: bool, detail: object) -> None:
        results.append((name, ok, "" if ok else f"got={detail!r}"))

    folder = Path(tempfile.mkdtemp())
    sent, read = folder / "messages.jsonl", folder / "messages-read.jsonl"
    log = mod.MessageLog(folder)
    check("no log yet reads as no messages",
          not log.refresh() and not log.latest and not log.unread,
          (list(log.latest), log.unread))
    check("and makes no file", list(folder.iterdir()) == [],
          list(folder.iterdir()))

    orch, work = ("orchestrator", "%1"), ("koyr", "%2")
    append(sent, message(1, orch, work), "not json", '["a list"]',
           message(2, work, orch, reply_to=1))
    with sent.open("a") as file:
        file.write(json.dumps(message(3, orch, work))[:20])
    check("whole lines are read, the rest skipped",
          log.refresh() and [m["id"] for m in log.latest] == [1, 2],
          [m["id"] for m in log.latest])
    check("a line still being written waits", 3 not in log.unread,
          log.unread)
    with sent.open("a") as file:
        file.write(json.dumps(message(3, orch, work))[20:] + "\n")
    log.refresh()
    check("and is read once it is whole",
          [m["id"] for m in log.latest] == [1, 2, 3],
          [m["id"] for m in log.latest])
    check("nothing added, nothing changed", not log.refresh(), None)
    check("every message starts unread",
          log.unread == {1: work, 2: orch, 3: work}, log.unread)

    append(read, {"id": 1, "time": "2026-09-30T12:00:00Z", "by": "%2"})
    log.refresh()
    check("a read mark takes it off the unread",
          log.unread == {2: orch, 3: work}, log.unread)
    append(read, {"id": 9, "time": "2026-09-30T12:00:00Z", "by": "%2"})
    append(sent, message(9, orch, work))
    log.refresh()
    check("even when the mark is read before the message", 9 not in log.unread,
          log.unread)

    append(sent, *(message(i, orch, work) for i in range(10, 10 + mod.LATEST)))
    log.refresh()
    check("only the newest are kept",
          len(log.latest) == mod.LATEST and log.latest[-1]["id"] == 109
          and log.latest[0]["id"] == 10,
          (len(log.latest), log.latest[0]["id"]))
    check("but every unread one is counted",
          len(log.unread) == 2 + mod.LATEST, len(log.unread))

    sent.write_text(json.dumps(message(1, work, orch)) + "\n")
    check("a log started over is read again from its start",
          log.refresh() and [m["id"] for m in log.latest] == [1]
          and log.unread == {}, (list(log.latest), log.unread))
    read.unlink()
    log.refresh()
    check("and so are its read marks", log.unread == {1: orch}, log.unread)

    # agent-msg's inbox rule, on a log of its own.
    folder = Path(tempfile.mkdtemp())
    append(folder / "messages.jsonl",
           message(1, orch, ("koyr", "%2")),
           message(2, orch, ("koyr", "%5")),       # gone: koyr's mail
           message(3, orch, ("hoyr", "%3")),
           message(4, orch, ("gone", "%6")),       # a gone session
           message(5, orch, ("hoyr", "%2")))       # %2 is koyr's now
    log = mod.MessageLog(folder)
    log.refresh()
    got = log.inbox({"%2": "koyr", "%4": "koyr", "%3": "hoyr"})
    want = {"%2": {1, 2}, "%4": {2}, "%3": {3, 5}}
    check("a pane's inbox is agent-msg's: its own, its session's gone panes'",
          got == want, got)
    return results


def inbox_agreement_cases(mod) -> list[tuple[str, bool, str]]:
    """The sidebar counts unread messages the way `agent-msg inbox
    --unread` lists them, on a throwaway tmux server: one rule, kept in
    two languages."""
    results: list[tuple[str, bool, str]] = []

    def check(name: str, ok: bool, detail: object) -> None:
        results.append((name, ok, "" if ok else f"got={detail!r}"))

    socket = f"agent-sidebar-test-{os.getpid()}"

    def t(*args: str) -> str:
        return subprocess.run(["tmux", "-L", socket, *args], check=True,
                              capture_output=True, text=True).stdout.strip()

    folder = Path(os.environ["XDG_STATE_HOME"]) / "agent-sidebar"
    folder.mkdir(parents=True, exist_ok=True)
    saved = os.environ.get("TMUX")
    try:
        t("-f", "/dev/null", "new-session", "-d", "-s", "koyr")
        t("new-session", "-d", "-s", "hoyr")
        koyr = t("display-message", "-p", "-t", "=koyr:", "#{pane_id}")
        other = t("split-window", "-d", "-t", koyr, "-P", "-F", "#{pane_id}")
        gone = t("split-window", "-d", "-t", koyr, "-P", "-F", "#{pane_id}")
        t("kill-pane", "-t", gone)
        hoyr = t("display-message", "-p", "-t", "=hoyr:", "#{pane_id}")
        os.environ["TMUX"] = t("display-message", "-p",
                               "#{socket_path},#{pid},0")
        orch = ("orchestrator", "%99")
        (folder / "messages.jsonl").write_text("".join(
            json.dumps(m) + "\n" for m in (
                message(1, orch, ("koyr", koyr)),
                message(2, orch, ("koyr", gone)),
                message(3, orch, ("hoyr", hoyr)),
                message(4, orch, ("hoyr", koyr)),
                message(5, orch, ("koyr", other)),
                message(6, orch, ("koyr", koyr)),
            )))
        (folder / "messages-read.jsonl").write_text(json.dumps(
            {"id": 6, "time": "2026-09-30T12:00:00Z", "by": koyr}) + "\n")

        log = mod.MessageLog(folder)
        log.refresh()
        ours = log.inbox(asyncio.run(mod.all_panes()))
        for pane in (koyr, other, hoyr):
            listed = subprocess.run(
                [str(SCRIPT.with_name("agent-msg")), "inbox", "--unread",
                 "--json", pane],
                check=True, capture_output=True, text=True).stdout
            theirs = {m["id"] for m in json.loads(listed)}
            check(f"agent-msg and the sidebar agree on {pane}'s unread",
                  ours.get(pane, set()) == theirs, (ours.get(pane), theirs))
    finally:
        if saved is None:
            os.environ.pop("TMUX", None)
        else:
            os.environ["TMUX"] = saved
        subprocess.run(["tmux", "-L", socket, "kill-server"],
                       capture_output=True)
        for name in ("messages.jsonl", "messages-read.jsonl", "messages.lock"):
            (folder / name).unlink(missing_ok=True)
    return results


