"""Checks for agent-sidebar: the grouping, and the app itself driven
headless against scans it is handed instead of agent-scan's.

Where the pane goes is agent-sidebar-tmux's job and has its own test.

Run: scripts/tests/test-agent-sidebar     (or `mise run test`)
"""

from __future__ import annotations

import asyncio
import importlib.machinery
import importlib.util
import io
import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path

from rich.console import Console

SCRIPT = Path(__file__).resolve().parents[1] / ".local" / "bin" / "agent-sidebar"


def load_agent_sidebar():
    spec = importlib.util.spec_from_loader(
        "agent_sidebar",
        importlib.machinery.SourceFileLoader("agent_sidebar", str(SCRIPT)),
    )
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules["agent_sidebar"] = module
    assert spec.loader is not None
    spec.loader.exec_module(module)
    return module


def row(project: str, pane_id: str, state: str = "done", **overrides):
    """An agent-scan --json row with every field filled."""
    return dict(
        state=state, project=project, branch="main", target="s:1.0",
        pane_id=pane_id, cwd=f"/src/{project}", agent="claude",
        context="10.0k", context_level="ok", duration="5m", since=300.0,
        block="1h", weekly="-", age="2h", message="hello", flag=" ",
    ) | overrides


# agent-scan's rows arrive in queue order, so a project's place is its
# most urgent agent's place.
GROUP_CASES = (
    ("projects in order of their first row",
     [row("koyr", "%1"), row("hoyr", "%2"), row("koyr", "%3")],
     [("koyr", ["%1", "%3"]), ("hoyr", ["%2"])]),
    ("no rows, no groups", [], []),
)


# How long until a window resets, as the overview counts it down.
COUNTDOWN_CASES = (
    ("minutes", 42 * 60 + 5, "42m"),
    ("hours and minutes", 3 * 3600 + 40 * 60, "3h40m"),
    ("days and hours", 2 * 86400 + 22 * 3600 + 59 * 60, "2d22h"),
    ("under a minute still says a minute", 20, "1m"),
    ("past is none", -5, None),
)


def plain(renderable, width: int = 34) -> str:
    console = Console(file=io.StringIO(), width=width, color_system=None)
    console.print(renderable)
    return console.file.getvalue()


class Fake:
    """Stands in for agent-scan and tmux, and records what the app runs."""

    def __init__(self, rows, here):
        self.rows = rows
        self.here = here
        self.ran: list[tuple[str, ...]] = []
        self.prs = {}
        self.pr_lookups: list[str] = []
        self.accounts: list[tuple[str, str]] = []
        self.usage: dict[str, dict] = {}
        self.usage_lookups = 0
        self.scans = 0
        # Every pane's session, as tmux would list them.
        self.panes: dict[str, str] = {}
        self.pane_lookups = 0

    async def list_panes(self):
        self.pane_lookups += 1
        return self.panes

    def list_accounts(self):
        return self.accounts

    async def list_usage(self):
        self.usage_lookups += 1
        return self.usage

    async def scan(self):
        self.scans += 1
        return self.rows

    async def panes_here(self):
        return self.here

    async def run(self, *command):
        self.ran.append(command)

    async def pull_requests(self, cwd):
        self.pr_lookups.append(cwd)
        return self.prs


async def app_cases(mod) -> list[tuple[str, bool, str]]:
    from textual.widgets import Checkbox, Input, OptionList, Static

    results: list[tuple[str, bool, str]] = []

    def check(name: str, ok: bool, detail: object) -> None:
        results.append((name, ok, "" if ok else f"got={detail!r}"))

    fake = Fake(
        [row("koyr", "%1", "blocked"), row("dotfiles", "%2"),
         row("koyr", "%3", "running")],
        {"%2", "%9"},
    )
    fake.prs = {"main": {"number": 12, "state": "MERGED", "draft": False}}
    app = mod.AgentSidebar(scan=fake.scan, panes_here=fake.panes_here,
                           run=fake.run, pull_requests=fake.pull_requests,
                           accounts=fake.list_accounts)
    glue = mod.GLUE

    async def rescan() -> None:
        app.action_rescan()
        await pilot.pause(0.3)

    # Tall enough for the help without a scrollbar, as the sidebar is.
    async with app.run_test(size=(36, 40)) as pilot:
        await pilot.pause(0.3)
        agents = app.query_one("#agents", OptionList)

        def ids() -> list[str | None]:
            return [agents.get_option_at_index(i).id
                    for i in range(agents.option_count)]

        def highlighted() -> str | None:
            option = agents.highlighted_option
            return option.id if option else None

        want = ["project:koyr", "%1", "%3", "project:dotfiles", "%2"]
        check("agents listed under their project", ids() == want, ids())
        check("starts on the agent in this window", highlighted() == "%2",
              highlighted())

        await pilot.press("k")
        check("k moves up past the project header", highlighted() == "%3",
              highlighted())

        prompt = plain(agents.get_option("%3").prompt)
        check("a branch's pull request shows on its agent", "#12" in prompt,
              prompt)
        check("pull requests are looked up once per project",
              sorted(fake.pr_lookups) == ["/src/dotfiles", "/src/koyr"],
              fake.pr_lookups)
        await rescan()
        check("and not again on the next scan",
              len(fake.pr_lookups) == 2, fake.pr_lookups)

        async def act(*keys: str) -> tuple[str, ...] | None:
            before = len(fake.ran)
            await pilot.press(*keys)
            await pilot.pause(0.1)
            return fake.ran[before] if len(fake.ran) > before else None

        for key, verb in (("d", "review"), ("g", "git"), ("p", "pr"),
                          ("X", "remove-worktree")):
            got = await act(key)
            check(f"{key} runs {verb} on the agent's pane",
                  got == (glue, verb, "%3"), got)
        got = await act("o")
        check("o opens a project", got == (glue, "open"), got)
        scans = fake.scans
        got = await act("s")
        check("s edits the settings", got == (glue, "config"), got)
        check("and rescans once the editor closes", fake.scans > scans,
              (scans, fake.scans))

        got = await act("x", "n")
        check("x asks first, and n keeps the agent", got is None, got)
        got = await act("x", "y")
        check("x then y kills it", got == (glue, "kill", "%3"), got)

        async def type_text(text: str) -> None:
            await pilot.press(*("space" if c == " " else c for c in text))

        await pilot.press("n")
        await pilot.pause(0.1)
        check("n shows single worktree+harness modal",
              isinstance(app.screen, mod.NewWorktreePrompt), app.screen)
        yolo = app.screen.query_one("#yolo-check", Checkbox)
        check("yolo is on by default", yolo.value is True, yolo.value)
        hlist = app.screen.query_one("#harness-list", OptionList)
        check("harness list has claude default", hlist.highlighted_option.id == "claude", hlist.highlighted_option.id)
        check("harness list has no sub-agent mode",
              all(hlist.get_option_at_index(i).id != "agent"
                  for i in range(hlist.option_count)),
              [hlist.get_option_at_index(i).id for i in range(hlist.option_count)])
        meta = app.screen.query("#harness-meta")
        check("no harness count line above the list", not meta, meta)
        branch = app.screen.query_one("#branch-input", Input)
        check("the branch input starts focused", branch.has_focus,
              app.screen.focused)
        await type_text("feat/jk x")
        check("j, k and space type into the branch input",
              branch.value == "feat/jk x", branch.value)
        check("and leave the harness list alone",
              hlist.highlighted_option.id == "claude",
              hlist.highlighted_option.id)
        await pilot.press("tab")
        check("tab moves to the harness list", hlist.has_focus,
              app.screen.focused)
        await pilot.press("j")
        check("j moves down the harness list", hlist.highlighted_option.id == "codex", hlist.highlighted_option.id)
        await pilot.press("k", "j")
        check("k moves up the harness list", hlist.highlighted_option.id == "codex", hlist.highlighted_option.id)
        got = await act("enter")
        check("enter on the harness list creates with that harness",
              got == (glue, "new-worktree", "%3", "feat/jk x",
                      mod.build_harness_command("codex", True)), got)
        check("and closes the modal",
              not isinstance(app.screen, mod.NewWorktreePrompt), app.screen)

        await pilot.press("n")
        await pilot.pause(0.1)
        await type_text("feat/y")
        await pilot.press("tab", "tab")
        yolo = app.screen.query_one("#yolo-check", Checkbox)
        check("tab again moves to yolo", yolo.has_focus, app.screen.focused)
        await pilot.press("space")
        check("space toggles yolo", yolo.value is False, yolo.value)
        got = await act("enter")
        check("enter on yolo creates instead of toggling",
              got == (glue, "new-worktree", "%3", "feat/y", "claude"), got)

        await pilot.press("n")
        await pilot.pause(0.1)
        await type_text("feat/x")
        got = await act("enter")
        check("enter in the branch input creates with yolo",
              got == (glue, "new-worktree", "%3", "feat/x",
                      mod.build_harness_command("claude", True)), got)

        # each harness's own yolo flag, picked and toggled with keys;
        # pi has no permission gate, so its checkbox is disabled
        for down, harness, yolo_on, want in (
            (1, "codex", True, "codex --yolo"),
            (1, "codex", False, "codex"),
            (2, "opencode", True, "opencode --auto"),
            (2, "opencode", False, "opencode"),
            (3, "pi", None, "pi"),
        ):
            await pilot.press("n")
            await pilot.pause(0.1)
            await type_text("feat/h")
            await pilot.press("tab", *["j"] * down, "tab")
            yolo = app.screen.query_one("#yolo-check", Checkbox)
            if yolo_on is None:
                check(f"{harness} disables yolo", yolo.disabled, yolo.disabled)
                check(f"tab skips {harness}'s yolo", not yolo.has_focus,
                      app.screen.focused)
            else:
                check(f"tab reaches {harness}'s yolo", yolo.has_focus,
                      app.screen.focused)
                if not yolo_on:
                    await pilot.press("space")
            got = await act("enter")
            check(f"{harness} runs {want!r}",
                  got == (glue, "new-worktree", "%3", "feat/h", want), got)

        await pilot.press("n")
        await pilot.pause(0.1)
        hlist = app.screen.query_one("#harness-list", OptionList)
        options = [hlist.get_option_at_index(i).id
                   for i in range(hlist.option_count)]
        check("the harness list ends with none", options[-1] == "none",
              options)
        await type_text("feat/bare")
        await pilot.press("tab", *["j"] * (hlist.option_count - 1))
        check("j reaches none", hlist.highlighted_option.id == "none",
              hlist.highlighted_option.id)
        check("none disables yolo",
              app.screen.query_one("#yolo-check", Checkbox).disabled,
              app.screen.query_one("#yolo-check", Checkbox).disabled)
        got = await act("enter")
        check("enter on none creates with no harness",
              got == (glue, "new-worktree", "%3", "feat/bare", "none"), got)

        # esc cancels whole modal
        await pilot.press("n")
        await pilot.pause(0.1)
        await pilot.press("tab")
        got = await act("enter")
        check("enter with no branch creates nothing", got is None, got)
        check("and goes back to the branch input",
              isinstance(app.screen, mod.NewWorktreePrompt)
              and app.screen.query_one("#branch-input", Input).has_focus,
              app.screen.focused)
        got = await act("escape")
        check("esc cancels single modal", got is None, got)
        check("and returns to list", not isinstance(app.screen, mod.NewWorktreePrompt), app.screen)

        await pilot.press("question_mark")
        await pilot.pause(0.1)
        check("? shows the keys", isinstance(app.screen, mod.Help),
              app.screen)
        title = app.screen.query_one(".legend-title", Static)
        check("the symbols have a heading of their own",
              title.content.plain == "Symbols", title.content)
        check("set off from the keys by a blank line",
              title.region.y - app.screen.query(Static)[1].region.bottom == 1,
              (title.region, app.screen.query(Static)[1].region))
        legend = app.screen.query_one(".legend", Static)
        shown = legend.content.plain
        drawn = [plain(mod.agent_prompt(row("koyr", "%1", harness=harness),
                                        here=False)).splitlines()[1]
                 for harness in mod.HARNESS_ICON]
        drawn.append(plain(mod.agent_prompt(
            row("koyr", "%1", harness="opencode", role="build"),
            here=False)).splitlines()[1])
        # Row 2 is the agent, then the duration after a gap.
        names = [line.strip().split("  ")[0] for line in drawn]
        missing = [name for name in names if name not in shown]
        check("the legend draws agents the way rows do", not missing,
              (missing, shown))
        check("and no legend line wraps at sidebar width",
              legend.size.height == len(shown.splitlines()),
              (legend.size, shown))
        await pilot.press("escape")
        await pilot.pause(0.1)
        check("esc closes them", not isinstance(app.screen, mod.Help),
              app.screen)

        titles = [c.title for c in app.get_system_commands(app.screen)]
        want = [f"{a.title} ({a.label})" for a in mod.ACTIONS
                if a.name != "help" and a.name not in mod.MESSAGE_ONLY]
        check("every agents action is in the command palette",
              titles == want, titles)

        before = len(fake.ran)
        fake.rows = [row("dotfiles", "%2", "blocked"), row("koyr", "%3"),
                     row("koyr", "%1")]
        await rescan()
        check("the cursor stays on its agent as rows reorder",
              highlighted() == "%3", (ids(), highlighted()))
        said = [c for c in fake.ran[before:] if c[:2] == ("tmux", "display-message")]
        check("an agent elsewhere that stops is announced",
              [c[-1] for c in said] == ["koyr/main done: hello"], said)

        fake.here = {"%1"}
        fake.rows = [row("koyr", "%3", "running"), row("koyr", "%1", "running"),
                     row("dotfiles", "%2")]
        await rescan()
        before = len(fake.ran)
        fake.rows = [row("koyr", "%3"), row("koyr", "%1"), row("dotfiles", "%2")]
        await rescan()
        said = [c[-1] for c in fake.ran[before:]
                if c[:2] == ("tmux", "display-message")]
        check("one in this window is not", said == ["koyr/main done: hello"],
              said)
        fake.here = {"%2", "%9"}

        await pilot.press("enter")
        await pilot.pause(0.1)
        check("enter jumps to the agent's pane",
              ("tmux", "switch-client", "-t", "%3") in fake.ran, fake.ran)

        fake.rows = [row("dotfiles", "%2")]
        await rescan()
        check("a gone agent moves the cursor to this window's",
              highlighted() == "%2", highlighted())

        before = ids()
        fake.rows = None
        await rescan()
        footer = str(app.query_one("#footer", Static).render())
        check("a failed scan keeps the list", ids() == before, ids())
        check("and says so", "scan failed" in footer, footer)

        fake.rows = []
        await rescan()
        empty = app.query_one("#empty")
        check("no agents shows the empty state",
              empty.display and not agents.display,
              (empty.display, agents.display))

        await pilot.press("q")
        await pilot.pause(0.1)
        check("q closes the sidebar",
              ("agent-sidebar-tmux", "close") in fake.ran, fake.ran)

    return results


async def project_default_cases(mod) -> list[tuple[str, bool, str]]:
    """`git config agent-sidebar.harness` in the project picks the harness
    the new-worktree modal starts on."""
    from textual.widgets import OptionList

    results: list[tuple[str, bool, str]] = []

    def check(name: str, ok: bool, detail: object) -> None:
        results.append((name, ok, "" if ok else f"got={detail!r}"))

    # Run as a pre-commit hook, git hands down GIT_DIR and friends, which
    # would aim the git calls below, and the sidebar's own, at this
    # repository instead: init would unbare it and config would land in it.
    for var in [v for v in os.environ if v.startswith("GIT_")]:
        del os.environ[var]
    with tempfile.TemporaryDirectory() as project:
        os.environ["GIT_CEILING_DIRECTORIES"] = str(Path(project).parent)
        subprocess.run(["git", "init", "-q", project], check=True)
        subprocess.run(["git", "-C", project, "config",
                        "agent-sidebar.harness", "codex"], check=True)
        fake = Fake([row("koyr", "%1", cwd=project)], {"%1"})
        app = mod.AgentSidebar(scan=fake.scan, panes_here=fake.panes_here,
                               run=fake.run, pull_requests=fake.pull_requests,
                               accounts=fake.list_accounts)
        async with app.run_test(size=(36, 30)) as pilot:
            await pilot.pause(0.3)
            await pilot.press("n")
            await pilot.pause(0.1)
            hlist = app.screen.query_one("#harness-list", OptionList)
            check("git config agent-sidebar.harness sets the default",
                  hlist.highlighted_option.id == "codex",
                  hlist.highlighted_option.id)
            before = len(fake.ran)
            await pilot.press(*"feat/x", "enter")
            await pilot.pause(0.1)
            got = fake.ran[before] if len(fake.ran) > before else None
            check("and enter creates with it",
                  got == (mod.GLUE, "new-worktree", "%1", "feat/x",
                          mod.build_harness_command("codex", True)), got)
    return results


async def fold_cases(mod) -> list[tuple[str, bool, str]]:
    """Collapsed projects and one-line agents, and that both are
    remembered for the next sidebar."""
    from textual.widgets import OptionList

    results: list[tuple[str, bool, str]] = []

    def check(name: str, ok: bool, detail: object) -> None:
        results.append((name, ok, "" if ok else f"got={detail!r}"))

    state = Path(tempfile.mkdtemp()) / "agent-sidebar" / "state.json"
    fake = Fake(
        [row("koyr", "%1", "blocked"), row("dotfiles", "%2"),
         row("koyr", "%3", "running")],
        {"%2"},
    )

    def sidebar():
        return mod.AgentSidebar(scan=fake.scan, panes_here=fake.panes_here,
                                run=fake.run, pull_requests=fake.pull_requests,
                                accounts=fake.list_accounts, state=state)

    app = sidebar()
    async with app.run_test(size=(36, 30)) as pilot:
        await pilot.pause(0.3)
        agents = app.query_one("#agents", OptionList)

        def ids() -> list[str | None]:
            return [agents.get_option_at_index(i).id
                    for i in range(agents.option_count)]

        def highlighted() -> str | None:
            option = agents.highlighted_option
            return option.id if option else None

        def lines(option_id: str) -> list[str]:
            return plain(agents.get_option(option_id).prompt).splitlines()

        async def rescan() -> None:
            app.action_rescan()
            await pilot.pause(0.3)

        async def press(*keys: str) -> None:
            await pilot.press(*keys)
            await pilot.pause(0.1)

        full = ["project:koyr", "%1", "%3", "project:dotfiles", "%2"]
        check("projects start expanded", ids() == full, ids())

        await press("k", "h")
        check("h collapses the agent's project",
              ids() == ["project:koyr", "project:dotfiles", "%2"], ids())
        check("and the cursor stays on it as one line",
              highlighted() == "project:koyr", highlighted())
        shown = lines("project:koyr")
        check("which counts its agents by state",
              len(shown) == 1 and "koyr" in shown[0]
              and shown[0].rstrip().endswith("● 1 ● 1"), shown)

        await press("j")
        check("j steps from it past the expanded header",
              highlighted() == "%2", highlighted())
        await press("k")
        check("and k back onto it", highlighted() == "project:koyr",
              highlighted())

        before = len(fake.ran)
        await press("d")
        check("agent actions do nothing on it", len(fake.ran) == before,
              fake.ran[before:])
        await press("n")
        check("n still branches its project",
              isinstance(app.screen, mod.NewWorktreePrompt)
              and app.screen.project == "koyr", app.screen)
        await press("escape")

        check("the collapse is remembered",
              json.loads(state.read_text())["collapsed"] == ["koyr"],
              state.read_text())

        await press("l")
        check("l expands it", ids() == full, ids())
        check("onto its first agent", highlighted() == "%1", highlighted())

        await press("h")
        before = len(fake.ran)
        await press("enter")
        check("enter on a collapsed project expands it",
              ids() == full and highlighted() == "%1", (ids(), highlighted()))
        check("instead of jumping", len(fake.ran) == before,
              fake.ran[before:])

        await press("end", "h")
        shown = lines("project:dotfiles")
        check("a collapsed project here keeps the bar",
              shown[0].startswith(mod.HERE), shown)
        await press("l")

        await press("H")
        check("H collapses every project",
              ids() == ["project:koyr", "project:dotfiles"], ids())
        check("with no rule between folded projects",
              agents.virtual_size.height == 2, agents.virtual_size)
        fake.rows = fake.rows + [row("hoyr", "%4")]
        await rescan()
        check("a new project starts expanded",
              ids() == ["project:koyr", "project:dotfiles",
                        "project:hoyr", "%4"], ids())
        await press("L")
        check("L expands every project", ids() == full + ["project:hoyr", "%4"],
              ids())
        fake.rows = fake.rows[:3]
        await rescan()

        def heights() -> list[int]:
            return [len(lines(i)) for i in ("%1", "%3", "%2")]

        await press("end", "c")
        check("c puts the agent on one line", heights() == [3, 3, 1],
              heights())
        check("its branch and state",
              lines("%2")[0].split() == [mod.HERE + "●", "main", "done"],
              lines("%2"))
        check("and remembers that",
              json.loads(state.read_text())["compact"] == ["%2"],
              state.read_text())
        await press("c")
        check("c again brings back its three lines", heights() == [3, 3, 3],
              heights())

        await press("C")
        check("C puts every agent on one line", heights() == [1, 1, 1],
              heights())
        await press("C")
        check("C again brings back all three lines", heights() == [3, 3, 3],
              heights())
        await press("c", "C")
        check("C with only some on one line puts them all there",
              heights() == [1, 1, 1], heights())

        fake.rows = fake.rows[:2]
        await rescan()
        await press("c", "c")
        check("an agent gone is forgotten",
              json.loads(state.read_text())["compact"] == ["%1", "%2"],
              state.read_text())
        fake.rows = [row("koyr", "%1", "blocked"), row("dotfiles", "%2"),
                     row("koyr", "%3", "running")]
        await rescan()

        await pilot.press("home")
        await press("h")
        before = state.read_text()
        await press("c")
        check("c does nothing on a collapsed project",
              state.read_text() == before, state.read_text())

    app = sidebar()
    async with app.run_test(size=(36, 30)) as pilot:
        await pilot.pause(0.3)
        agents = app.query_one("#agents", OptionList)
        got = [agents.get_option_at_index(i).id
               for i in range(agents.option_count)]
        check("the next sidebar starts with them collapsed",
              got == ["project:koyr", "project:dotfiles", "%2"], got)
        check("and its agents on one line",
              len(plain(agents.get_option("%2").prompt).splitlines()) == 1,
              plain(agents.get_option("%2").prompt))

    fake.here = {"%3"}
    app = sidebar()
    async with app.run_test(size=(36, 30)) as pilot:
        await pilot.pause(0.3)
        agents = app.query_one("#agents", OptionList)
        option = agents.highlighted_option
