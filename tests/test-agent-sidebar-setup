#!/usr/bin/env bash
# End-to-end checks for agent-sidebar-setup on a throwaway HOME with four
# Claude Code config folders:
#
#   ~/.claude           a statusline script and a hook in settings.json
#   ~/.claude-personal  links ~/.claude's settings.json; a skill of its own
#                       named agent-sidebar
#   ~/.claude-work      no settings.json yet, a statusline script; a tap
#                       from where the plugin was before
#   ~/.claude-odd       a statusline that is a shell pipeline
#
# Run: tests/test-agent-sidebar-setup     (or `mise run test`)

set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
readonly repo setup="${repo}/bin/agent-sidebar-setup"
scratch="$(mktemp -d)"
readonly scratch
trap 'rm -rf "${scratch}"' EXIT

export HOME="${scratch}/home"
# CI runners set these to the runner's own folders.
export XDG_CONFIG_HOME="${HOME}/.config" XDG_STATE_HOME="${HOME}/.local/state"
unset XDG_BIN_HOME
readonly skill="${repo}/skills/agent-sidebar"
# The path the setup writes: the plugin's bin, as Claude Code's shell reads it.
readonly tap="${repo}/bin/agent-usage-tap"
readonly cable="${HOME}/.config/television/cable"
# television is a stand-in; a channel of the user's own is already there.
mkdir -p "${scratch}/stubs" "${cable}"
printf '#!/bin/sh\n' >"${scratch}/stubs/tv"
chmod +x "${scratch}/stubs/tv"
export PATH="${scratch}/stubs:${PATH}"
printf 'own\n' >"${cable}/projects.toml"
# ~/.local/bin holds a git-wt of the user's own, and a link from an old
# install of agent-scan.
readonly user_bin="${HOME}/.local/bin"
mkdir -p "${user_bin}"
printf '#!/bin/sh\n' >"${user_bin}/git-wt"
ln -s /old/place/agent-scan "${user_bin}/agent-scan"

mkdir -p "${HOME}/.claude" "${HOME}/.claude-personal/skills/agent-sidebar" \
    "${HOME}/.claude-work" "${HOME}/.claude-odd"
printf '{"hooks": {"Stop": []}, "statusLine": {"type": "command", "command": "~/.claude/statusline.sh", "padding": 0}}\n' \
    >"${HOME}/.claude/settings.json"
ln -s ../.claude/settings.json "${HOME}/.claude-personal/settings.json"
printf 'own\n' >"${HOME}/.claude-personal/skills/agent-sidebar/SKILL.md"
printf '#!/bin/sh\necho work\n' >"${HOME}/.claude-work/statusline.sh"
chmod +x "${HOME}/.claude-work/statusline.sh"
printf '{"statusLine": {"type": "command", "command": "ccstatusline | head -1"}}\n' \
    >"${HOME}/.claude-odd/settings.json"

failures=0
total=0

check() {
    local name="$1"
    shift
    total=$((total + 1))
    if "$@" 2>/dev/null; then
        printf 'ok    %s\n' "${name}"
    else
        printf 'FAIL  %s\n' "${name}"
        failures=$((failures + 1))
    fi
}

not() { ! "$@"; }
same() { [[ "$1" == "$2" ]]; }
contains() { [[ "$1" == *"$2"* ]]; }
links_to() { [[ -L "$1" && "$(realpath "$1")" == "$(realpath "$2")" ]]; }
links_to_skill() { links_to "$1" "${skill}"; }
statusline() { jq -r ".statusLine.$2" "${HOME}/$1/settings.json"; }

out="$("${setup}" --check 2>&1)"
check "--check reports the skill link" contains "${out}" "would: link ${HOME}/.agents/skills/agent-sidebar"
check "--check links nothing" not test -e "${HOME}/.agents/skills/agent-sidebar"
check "--check reports the statusline" \
    contains "${out}" "would: statusLine.command in ${HOME}/.claude/settings.json: ${tap} ~/.claude/statusline.sh"
# shellcheck disable=SC2088 # the literal tilde settings.json holds
check "--check wires nothing" same "$(statusline .claude command)" "~/.claude/statusline.sh"
check "--check creates no settings" not test -e "${HOME}/.claude-work/settings.json"

out="$("${setup}" 2>&1)"
check "the skill goes in ~/.agents/skills" links_to_skill "${HOME}/.agents/skills/agent-sidebar"
check "and in each Claude Code config folder" links_to_skill "${HOME}/.claude/skills/agent-sidebar"
check "a skill of the folder's own is not replaced" \
    same "$(cat "${HOME}/.claude-personal/skills/agent-sidebar/SKILL.md")" own
check "and the run says why" contains "${out}" "skipped  ${HOME}/.claude-personal/skills/agent-sidebar - not a link"
check "the tools go in ~/.local/bin" links_to "${user_bin}/agent-msg" "${repo}/bin/agent-msg"
check "a link from an old install is pointed here" links_to "${user_bin}/agent-scan" "${repo}/bin/agent-scan"
check "a tool of the user's own is not replaced" not test -L "${user_bin}/git-wt"
check "and the run says ~/.local/bin is not on PATH" contains "${out}" "${user_bin} is not on PATH"
check "the agents channel goes in television's cable folder" \
    links_to "${cable}/agents.toml" "${repo}/extras/television/agents.toml"
check "a channel of the user's own is not replaced" same "$(cat "${cable}/projects.toml")" own

check "the tap goes in front of the statusline, by its path" \
    same "$(statusline .claude command)" "${tap} ~/.claude/statusline.sh"
check "the statusline keeps its own settings" same "$(statusline .claude padding)" 0
check "and refreshes for the tap" same "$(statusline .claude refreshInterval)" 10
check "the rest of settings.json is kept" same "$(jq -c .hooks "${HOME}/.claude/settings.json")" '{"Stop":[]}'
check "a linked settings.json stays a link" test -L "${HOME}/.claude-personal/settings.json"
check "and is wired once" not contains "${out}" "wired    ${HOME}/.claude-personal/settings.json"
check "a folder without settings gets its own statusline through the tap" \
    same "$(statusline .claude-work command)" "${tap} ~/.claude-work/statusline.sh"
check "a shell pipeline is left alone" same "$(statusline .claude-odd command)" "ccstatusline | head -1"
check "and the run says to wire it by hand" contains "${out}" "skipped  ${HOME}/.claude-odd/settings.json"

out="$("${setup}" 2>&1)"
check "a second run links nothing" contains "${out}" "every skills folder links the plugin's skill"
check "no channel either" contains "${out}" "every channel is linked"
check "nor a tool" contains "${out}" "every tool is linked"
check "and wires nothing" contains "${out}" "every Claude Code statusline runs through agent-usage-tap"

# The plugin moved, or the tap was wired by hand by its bare name.
printf '{"statusLine": {"command": "/old/plugin/bin/agent-usage-tap ~/.claude-work/statusline.sh"}}\n' \
    >"${HOME}/.claude-work/settings.json"
printf '{"statusLine": {"command": "agent-usage-tap"}}\n' >"${HOME}/.claude-odd/settings.json"
"${setup}" >/dev/null 2>&1
check "a tap from elsewhere is pointed at this one" \
    same "$(statusline .claude-work command)" "${tap} ~/.claude-work/statusline.sh"
check "a bare tap too" same "$(statusline .claude-odd command)" "${tap}"

# moved_to DIR: a copy of the plugin in DIR, set up from there.
moved_to() {
    mkdir -p "$1"
    cp -r "${repo}/bin" "${repo}/skills" "${repo}/extras" "$1"
    "$1/bin/agent-sidebar-setup" >/dev/null 2>&1
}
# runs FOLDER: the statusline of FOLDER, as Claude Code's shell runs it.
runs() { sh -c "$(statusline "$1" command)" </dev/null 2>&1; }
# A path with a space is quoted, past the ~ so the shell still expands it,
# and a second run finds the tap rather than stacking another.
moved_to "${HOME}/my plugins/agent-sidebar"
"${HOME}/my plugins/agent-sidebar/bin/agent-sidebar-setup" >/dev/null 2>&1
# shellcheck disable=SC2088 # the literal tilde settings.json holds
check "a plugin path with a space is quoted" same "$(statusline .claude-work command)" \
    "~/'my plugins/agent-sidebar/bin/agent-usage-tap' ~/.claude-work/statusline.sh"
check "and the statusline runs" same "$(runs .claude-work)" work
# Only a whole folder of HOME becomes ~.
moved_to "${HOME}x/agent-sidebar"
check "a folder next to HOME is not taken for one in it" \
    same "$(statusline .claude-work command)" "${HOME}x/agent-sidebar/bin/agent-usage-tap ~/.claude-work/statusline.sh"
moved_to "${HOME}/my plugins/agent-sidebar"
"${setup}" >/dev/null 2>&1
check "a quoted tap from elsewhere is pointed at this one" \
    same "$(statusline .claude-work command)" "${tap} ~/.claude-work/statusline.sh"

check "an unknown option is refused" not "${setup}" --force

rm "${scratch}/stubs/tv"
out="$(PATH="$(tr ':' '\n' <<<"${PATH}" | while read -r d; do [[ -x "${d}/tv" ]] || echo "${d}"; done | paste -sd:)" "${setup}" 2>&1)"
check "without television no channel is linked" contains "${out}" "skipped - television (tv) is not installed"

printf '\n%s/%s passed\n' "$((total - failures))" "${total}"
((failures == 0))
