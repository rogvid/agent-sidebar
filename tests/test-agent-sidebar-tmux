#!/usr/bin/env bash
# End-to-end checks for agent-sidebar-tmux on a throwaway tmux server.
#
# The sidebar follows the window a client is looking at, so a real client
# is attached: it runs inside a second throwaway server, and keys are typed
# into it the way a terminal would. The binding and hooks come straight out
# of tmux.conf, so the test and the config cannot drift apart.
#
# Run: scripts/tests/test-agent-sidebar-tmux     (or `mise run test`)

set -euo pipefail

repo="$(cd "$(dirname "$0")/../.." && pwd)"
readonly repo
readonly socket="agent-sidebar-test-$$"
readonly host="agent-sidebar-host-$$"
readonly width=36
scratch="$(mktemp -d)"
readonly scratch

cleanup() {
    tmux -L "${socket}" kill-server 2>/dev/null || true
    tmux -L "${host}" kill-server 2>/dev/null || true
    rm -rf "${scratch}"
}
trap cleanup EXIT

grep -F 'agent-sidebar-tmux' "${repo}/tmux/.tmux.conf" >"${scratch}/tmux.conf"
# Without it a typed M-2 waits half a second to be told apart from Escape.
echo 'set -g escape-time 0' >>"${scratch}/tmux.conf"
# Panes here only run stand-ins; a login shell's rc files would only slow
# them down.
echo 'set -g default-shell /bin/sh' >>"${scratch}/tmux.conf"

# The tools the actions drive, as stand-ins that record what they were
# asked to do.
mkdir -p "${scratch}/bin"
cat >"${scratch}/bin/git-wt-add" <<'EOF'
#!/bin/sh
set -e
git worktree add -q -b "$1" "$PWD/$(echo "$1" | tr / -)"
EOF
cat >"${scratch}/bin/git-wt-remove" <<'EOF'
#!/bin/sh
[ "$1" = -d ] && shift
git worktree remove --force "$1"
EOF
cat >"${scratch}/bin/tuicr" <<'EOF'
#!/bin/sh
# Verify contrast fix: review() must pass --appearance dark to avoid
# white-on-light-green in tuicr's light theme.
case "$*" in
*--appearance\ dark*) ;;
*) echo "tuicr called without --appearance dark: $*" >&2; exit 1 ;;
esac
echo "1. f.txt:~2 - rename B to b"
EOF
cat >"${scratch}/bin/tv" <<EOF
#!/bin/sh
echo "\$*" >"${scratch}/tv-args"
EOF
cat >"${scratch}/bin/less" <<EOF
#!/bin/sh
echo "\$*" >"${scratch}/less-args"
cat >"${scratch}/less-in"
EOF
# A harness that notes the account it was started on.
cat >"${scratch}/bin/claude" <<'EOF'
#!/bin/sh
echo "${CLAUDE_CONFIG_DIR:-default}" >claude-account
EOF
chmod +x "${scratch}/bin/"*

# A pre-commit hook hands down GIT_INDEX_FILE and friends, which would aim
# the git calls below at this repository.
while IFS= read -r var; do unset "${var}"; done < <(env | awk -F= '/^GIT_/ { print $1 }')
# A project the way git-wt lays one out: .bare, a .git file pointing at it,
# and the main worktree next to them.
project="${scratch}/projects/app"
main="${project}/main"
git init -q --bare -b main "${project}/.bare"
echo 'gitdir: ./.bare' >"${project}/.git"
git -C "${project}" worktree add -q --orphan -b main "${main}"
git -C "${main}" -c user.name=t -c user.email=t@t -c commit.gpgsign=false \
    commit -q --allow-empty --no-verify -m init

t() { tmux -L "${socket}" "$@"; }

# The test server's jobs - the hooks - inherit this environment. The sidebar
# itself is a stand-in: this checks where the pane goes, not what it draws.
export PATH="${scratch}/bin:${repo}/scripts/.local/bin:${PATH}"
export AGENT_SIDEBAR_COMMAND="sleep 3600"
export AGENT_SIDEBAR_AGENT="touch agent-started"
unset TMUX TMUX_PANE
# agent-sidebar-config is a uv script. Under the throwaway HOME below, uv
# would download a Python on its first run, slower than any check waits.
UV_CACHE_DIR="$(uv cache dir)" UV_PYTHON_INSTALL_DIR="$(uv python dir)"
export UV_CACHE_DIR UV_PYTHON_INSTALL_DIR
# The panes' login shells read ~/.profile, and a real one puts the real
# harnesses ahead of the stand-ins.
export HOME="${scratch}/home" XDG_CONFIG_HOME="${scratch}/home/.config"
mkdir -p "${HOME}"
# An agent running this test would hand its own account on to every spawn.
unset CLAUDE_CONFIG_DIR CODEX_HOME PI_CODING_AGENT_DIR

t -f "${scratch}/tmux.conf" new-session -d -s main -x 160 -y 45 -n one
t new-window -d -t main: -n two
t new-window -d -t main: -n three
t new-session -d -s other -x 160 -y 45
t new-session -d -s popup -x 160 -y 45
tmux -L "${host}" -f /dev/null new-session -d -s host -x 160 -y 45 \
    "env -u TMUX tmux -L ${socket} attach -t main"

press() { tmux -L "${host}" send-keys -t host "$@"; }

sidebars() { t list-panes -a -F '#{pane_id} #{@agent-sidebar}' | awk '$2 == "1" { print $1 }'; }
sidebar_count() { sidebars | wc -l | tr -d ' '; }
sidebar() { sidebars | head -1; }
viewed() { t list-clients -F '#{client_pid} #{window_id}' | sort -n | head -1 | cut -d' ' -f2; }
sidebar_window() { t display-message -p -t "$(sidebar)" '#{window_id}'; }

# One sidebar, in the window the client is looking at, full height down the
# left edge at its width.
in_place() {
    [[ "$(sidebar_count)" == 1 ]] || return 1
    [[ "$(sidebar_window)" == "$(viewed)" ]] || return 1
    local shape
    shape="$(t display-message -p -t "$(sidebar)" \
        '#{pane_left} #{pane_top} #{pane_width} #{pane_height} #{window_height}')"
    read -r left top pane_width pane_height window_height <<<"${shape}"
    ((left == 0 && top == 0 && pane_width == width && pane_height == window_height))
}

failures=0
total=0

# Hooks run in the background, so give the server a moment to settle.
check() {
    local name="$1" _
    shift
    total=$((total + 1))
    for _ in $(seq 60); do
        if "$@" 2>/dev/null; then
            printf 'ok    %s\n' "${name}"
            return 0
        fi
        sleep 0.05
    done
    printf 'FAIL  %s\n' "${name}"
    failures=$((failures + 1))
}

not() { ! "$@"; }
equals() { [[ "$($1)" == "$2" ]]; }
open_flag() { t show-options -gqv @agent-sidebar-open; }
active_pane() { t display-message -p -t "$(viewed)" '#{pane_id}'; }

check "client attached" equals viewed "$(t display-message -p -t main:one '#{window_id}')"

press M-2
check "M-2 opens it down the left of this window" in_place
check "M-2 focuses it" equals active_pane "$(sidebar)"
first="$(sidebar)"

t select-window -t main:two
check "it follows to another window" in_place
check "it is the same pane, still running" equals sidebar "${first}"
check "the window it left is whole again" equals \
    "t display-message -p -t main:one #{pane_width}" 160
check "moving it does not steal focus" not equals active_pane "${first}"

t switch-client -t other
check "it follows to another session" in_place

t new-window -t other:
check "it follows to a new window" in_place

tmux -L "${host}" resize-window -t host -x 200
check "it keeps its width when the terminal grows" in_place

t split-window -t main:three
t resize-pane -Z -t main:three
t switch-client -t main
t select-window -t main:three
sleep 0.5
check "a zoomed window keeps its zoom" equals \
    "t display-message -p -t main:three #{window_zoomed_flag}" 1
check "and does not take the sidebar" not equals sidebar_window \
    "$(t display-message -p -t main:three '#{window_id}')"
t resize-pane -Z -t main:three
check "unzooming brings it in" in_place

t kill-window -t main:three
check "killing its window brings a fresh one to where you land" in_place
check "and only one" equals sidebar_count 1

brief_window="$(t new-window -t main: -P -F '#{window_id}' 'sleep 1')"
check "it follows into a short-lived window" in_place
window_exists() { t list-windows -a -F '#{window_id}' | grep -qxF "$1"; }
check "that window starts with the sidebar beside its pane" equals \
    "t display-message -p -t ${brief_window} #{window_panes}" 2
check "when the window's last pane exits, the window closes" not \
    window_exists "${brief_window}"
check "and the sidebar lands where you do" in_place

client="$(t list-clients -F '#{client_name}' | head -1)"
t display-popup -c "${client}" -E \
    "env -u TMUX tmux -L ${socket} attach -t popup" &
check "a popup attaches its own client" equals \
    "t list-clients -F #{session_name}" "$(printf 'main\npopup')"
sleep 0.5
check "the sidebar stays with the client under the popup" in_place
t detach-client -s popup
wait

t select-pane -t "$(sidebar)"
press M-2
check "M-2 in its window closes it" equals sidebar_count 0
check "and forgets it was open" equals open_flag ""
t select-window -t main:two
sleep 0.5
check "a closed sidebar stays closed" equals sidebar_count 0

# The width is a setting, and nothing but the config file sets it here.
config="${XDG_CONFIG_HOME}/agent-sidebar/config.toml"
mkdir -p "$(dirname "${config}")"
sidebar_width() { t display-message -p -t "$(sidebar)" '#{pane_width}'; }
printf 'width = 40\n' >"${config}"
press M-2
check "the config file sets its width" equals sidebar_width 40
press M-2
check "and M-2 still closes it" equals sidebar_count 0
printf 'width = \n' >"${config}"
press M-2
check "a broken config file still opens it, at the default" \
    equals sidebar_width "${width}"
press M-2
check "and closes it" equals sidebar_count 0
rm "${config}"

printf 'pane\tmain\t1\t1\t:*\t0\tagent-sidebar\t:/home\t0\tsleep\t:\n' >"${scratch}/save"
printf 'pane\tmain\t1\t1\t:*\t1\tzsh\t:/home\t1\tzsh\t:\n' >>"${scratch}/save"
printf 'window\tmain\t1\t:one\t1\t:*\tlayout\t:\n' >>"${scratch}/save"
agent-sidebar-tmux prune-resurrect "${scratch}/save"
pruned() { [[ "$(cut -f1,7 "${scratch}/save" | tr '\t\n' ' ;')" == "pane zsh;window layout;" ]]; }
check "resurrect saves leave the sidebar out" pruned

# The actions, run the way the sidebar runs them: from inside the server.
act() {
    TMUX="$(t display-message -p '#{socket_path},#{pid},0')" agent-sidebar-tmux "$@"
}
exists() { [[ -e "$1" ]]; }
pane_alive() { t display-message -p -t "$1" '#{pane_id}' | grep -qxF "$1"; }
client_session() { t list-clients -F '#{client_pid} #{session_name}' | sort -n | head -1 | cut -d' ' -f2; }

agent="$(t new-window -t main: -n agent -c "${main}" -P -F '#{pane_id}' \
    "cat >${scratch}/pasted")"
worktree="${project}/feat-x"
act new-worktree "${agent}" feat/x
check "new-worktree makes the worktree in the agent's project" exists "${worktree}"
check "gives it the session git-wt names it" equals \
    "t display-message -p -t =app-feat-x: #{pane_current_path}" "${worktree}"
check "starts the agent in it" exists "${worktree}/agent-started"
check "and takes you there" equals client_session app-feat-x

# spawn is new-worktree for an agent starting workers: no popup, no move.
spawned="$(act spawn "${agent}" feat/y "touch agent-y" || true)"
check "spawn makes the worktree without a popup" exists "${project}/feat-y"
check "prints the new agent's pane, in the session git-wt names" equals \
    "t display-message -p -t ${spawned} #{session_name}" app-feat-y
check "starts the harness it is given there" exists "${project}/feat-y/agent-y"
check "and leaves you where you were" equals client_session app-feat-x
check "spawn refuses a session that already exists" not act spawn "${agent}" feat/y
check "and types nothing into it" equals "t list-panes -t =app-feat-y: -F #{pane_id}" "${spawned}"
outsider="$(t new-window -d -t main: -c "${scratch}" -P -F '#{pane_id}' 'sleep 3600')"
check "spawn from a pane outside a project fails" not act spawn "${outsider}" feat/z

# Accounts: a harness's config folder next to its default one, named by its
# suffix, when it holds a login; and any listed in the accounts file.
home="${HOME}"
mkdir -p "${home}/.claude-work" "${home}/.claude-empty" "${home}/.codex-alt" \
    "${home}/.pi-lab/agent" "${home}/.config/agent-sidebar" "${scratch}/far"
echo '{}' >"${home}/.claude-work/.claude.json"
echo '{}' >"${home}/.codex-alt/auth.json"
echo '{}' >"${home}/.pi-lab/agent/auth.json"
printf '# harness name folder\nclaude far %s\nopencode far %s\n' "${scratch}/far" "${scratch}/far" \
    >"${home}/.config/agent-sidebar/accounts"
accounts() { agent-sidebar-tmux accounts; }
expected="$(printf 'claude\tfar\t%s\nclaude\twork\t%s\ncodex\talt\t%s\npi\tlab\t%s' \
    "${scratch}/far" "${home}/.claude-work" "${home}/.codex-alt" "${home}/.pi-lab/agent")"
check "accounts lists each harness's accounts with a login, where it has any" \
    equals accounts "${expected}"

on_account() { cat "$1/claude-account"; }
act spawn "${agent}" feat/work claude --account work >/dev/null
check "spawn --account starts the harness on that account" \
    equals "on_account ${project}/feat-work" "${home}/.claude-work"
check "and the whole session stays on it" equals \
    "t show-environment -t =app-feat-work CLAUDE_CONFIG_DIR" \
    "CLAUDE_CONFIG_DIR=${home}/.claude-work"
CLAUDE_CONFIG_DIR="${home}/.claude-work" act spawn "${agent}" feat/inherit claude >/dev/null
check "spawn keeps the account of the agent calling it" \
    equals "on_account ${project}/feat-inherit" "${home}/.claude-work"
act spawn "${agent}" feat/plain claude >/dev/null
check "and the default account when it has none" \
    equals "on_account ${project}/feat-plain" default
check "spawn refuses an account it does not know" \
    not act spawn "${agent}" feat/nope claude --account nope
check "before making a worktree" not exists "${project}/feat-nope"
check "spawn refuses an account for a harness that keeps none" \
    not act spawn "${agent}" feat/nope opencode --account work
act spawn "${main}" feat/headless claude --account far >/dev/null
check "spawn takes a project folder instead of a pane" \
    equals "on_account ${project}/feat-headless" "${scratch}/far"

act new-worktree "${agent}" feat/picked claude --account work
check "new-worktree starts the account picked in the sidebar" \
    equals "on_account ${project}/feat-picked" "${home}/.claude-work"

act review "${agent}"
check "review pastes tuicr's export into the agent" grep -qF 'rename B to b' \
    "${scratch}/pasted"
check "and takes you to it" equals client_session main

main_agent="$(t new-window -t main: -c "${main}" -P -F '#{pane_id}' 'sleep 3600')"
act remove-worktree "${main_agent}"
check "remove-worktree leaves the main worktree alone" pane_alive "${main_agent}"
wt_agent="$(t new-window -t main: -c "${worktree}" -P -F '#{pane_id}' 'sleep 3600')"
act remove-worktree "${wt_agent}"
check "remove-worktree removes the agent's worktree" not exists "${worktree}"
check "then the agent's pane" not pane_alive "${wt_agent}"

act kill "${main_agent}"
check "kill kills the pane" not pane_alive "${main_agent}"

act open
check "open picks from the projects channel" equals "cat ${scratch}/tv-args" projects

# A thread of two messages and one besides, as agent-msg logs them.
state="${HOME}/.local/state/agent-sidebar"
mkdir -p "${state}"
for message in '1 null' '2 1' '3 null'; do
    read -r id reply_to <<<"${message}"
    jq -nc --argjson id "${id}" --argjson reply_to "${reply_to}" \
        '{id: $id, time: "2026-09-30T12:00:00Z", kind: "send",
          from: {pane: "%1", session: "a", project: "a", branch: "main"},
          to: {pane: "%2", session: "b", project: "b", branch: "main"},
          reply_to: $reply_to, text: "text \($id)"}'
done >"${state}/messages.jsonl"
paged() { grep -oE '^#[0-9]+' "${scratch}/less-in" | paste -sd ' '; }
act thread 2
check "thread pages the message's thread" equals paged "#1 #2"
check "opened at the message" equals "cat ${scratch}/less-args" "-R +/^#2  "
check "thread takes only a message id" not act thread '1; true'

printf '\n%s/%s passed\n' "$((total - failures))" "${total}"
((failures == 0))
