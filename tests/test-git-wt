def remove_scratch() -> None:
    def unlock(func, path, _exc):
        parent = os.path.dirname(path)
        os.chmod(parent, os.stat(parent).st_mode | stat.S_IWUSR | stat.S_IXUSR)
        func(path)

    shutil.rmtree(SCRATCH, onexc=unlock)
    shutil.rmtree(TMUX_DIR, ignore_errors=True)


def main() -> int:
    git_config_home(HOME, identity=True)
    make_stubs()
    try:
        for fn in SECTIONS:
            if ONLY and not any(o in fn.__name__ for o in ONLY):
                continue
            try:
                fn()
            except Exception as e:
                traceback.print_exc()
                check(f"{fn.__name__} section ran to the end", False, f"{type(e).__name__}: {e}")
    finally:
        kill_tmux()
        if os.environ.get("TEST_GIT_WT_KEEP"):
            print(f"\nscratch kept: {SCRATCH}")
        else:
            remove_scratch()
    print(f"\n{TOTAL - len(FAILED)}/{TOTAL} passed")
    return 1 if FAILED else 0


if __name__ == "__main__":
    sys.exit(main())
