}


def parse_args(argv: list[str]) -> tuple[bool, list[str]]:
    via_wrappers, only = False, []
    it = iter(argv)
    for arg in it:
        if arg == "--via-wrappers":
            via_wrappers = True
        elif arg == "--only":
            only.append(next(it, ""))
        elif arg in ("-h", "--help"):
            print(USAGE)
            sys.exit(0)
        else:
            print(USAGE, file=sys.stderr)
            sys.exit(2)
    return via_wrappers, only


VIA_WRAPPERS, ONLY = parse_args(sys.argv[1:])

