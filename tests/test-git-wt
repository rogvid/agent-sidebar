    r = wt("add", "-t", "feat/t", cwd=c4.main, env=inside_tmux_env("home"))
    session = c4.folder("feat/t").name
    check("add -t inside tmux switches the client to the new worktree's session",
          r.code == 0 and wait_until(lambda: client_sessions() == [session])
          and session_path(session) == str(c4.folder("feat/t")),
          r.desc() + f" clients={client_sessions()}")
    kill_tmux()


@section
def switch_command():
    c = Case("switch", files={"src/code.txt": "code\n"})
    one = c.add_wt("feat/one")

    def opens(name: str, target: str | None, cwd: Path, expected: Path, **env) -> None:
        args = [target] if target is not None else []
        r = wt("switch", *args, cwd=cwd, env=recording_shell() | env)
        check(name, r.code == 0 and shell_calls() == [str(expected)],
              r.desc() + f" shell={shell_calls()}")

    opens("switch by branch opens $SHELL in the worktree", "feat/one", c.main, one)
    opens("switch by folder name", one.name, c.main, one)
    opens("switch by absolute path", str(one), c.main, one)
    opens("switch by relative path", os.path.relpath(one, c.main), c.main, one)
    opens("switch by path with a trailing slash", f"{one}/", c.main, one)
    opens("switch by a subdirectory of the worktree", str(one / "src"), c.main, one)
    opens("switch . from inside the worktree", ".", one, one)
    opens("switch . from a subdirectory of the worktree", ".", one / "src", one)
    opens("switch to the main checkout by path", str(c.main), one, c.main)
    opens("switch to the main checkout by its branch", "main", one, c.main)
    opens("switch with no target opens the fzf pick", None, c.main, one, FZF_PICK=one.name)

    r = wt("switch", "feat/none", cwd=c.main, env=recording_shell())
    check("switch to an unknown target exits 1 and opens nothing",
          r.code == 1 and shell_calls() == [], r.desc())

    kill_tmux()
    r = wt("switch", cwd=c.main, env=recording_shell())
    check("a cancelled pick exits 1 with No worktree selected",
          r.code == 1 and "No worktree selected" in r.all, r.desc())
    check("and opens no shell and no tmux session", shell_calls() == [] and sessions() == set(),
          f"shell={shell_calls()} sessions={sorted(sessions())}")

    new_session("app", c.main)
    attach_client("app")
    inside = inside_tmux_env("app")
    r = wt("switch", cwd=c.main, env=inside | recording_shell())
    check("a cancelled pick inside tmux leaves the client and sessions alone",
          r.code == 1 and "No worktree selected" in r.all
          and client_sessions() == ["app"] and sessions() == {"app"}
          and shell_calls() == [], r.desc() + f" sessions={sorted(sessions())}")

    r = wt("switch", "feat/one", cwd=c.main, env=inside | recording_shell())
    check("switch inside tmux creates the worktree's session in its folder",
          r.code == 0 and wait_until(lambda: one.name in sessions())
          and session_path(one.name) == str(one), r.desc() + f" sessions={sorted(sessions())}")
    check("and switches the client to it",
          wait_until(lambda: client_sessions() == [one.name]) and shell_calls() == [],
          f"clients={client_sessions()} shell={shell_calls()}")
    r = wt("switch", "main", cwd=one, env=inside)
    check("switch inside tmux to the main checkout switches to its session",
          r.code == 0 and wait_until(lambda: client_sessions() == ["app"]),
          r.desc() + f" clients={client_sessions()}")
    r = wt("switch", one.name, cwd=c.main, env=inside)
    check("switching back reuses the existing session",
          r.code == 0 and wait_until(lambda: client_sessions() == [one.name])
          and sessions() == {"app", one.name}, r.desc() + f" sessions={sorted(sessions())}")
    kill_tmux()

    two = c.add_wt("feat/two")
    status = SCRATCH / "switch-t-status"
    run_in_host_pane(command("switch", "-t", "feat/two"), c.main, status)
    check("switch -t outside tmux attaches to the worktree's session",
          wait_until(lambda: client_sessions() == [two.name], timeout=20)
          and session_path(two.name) == str(two),
          f"clients={client_sessions()} sessions={sorted(sessions())}"
          f" status={status.read_text().strip() if status.exists() else 'running'}")
    kill_tmux()


@section
def remove_command():
    c = Case("remove", files={".gitignore": "ignored.txt\n", "src/code.txt": "code\n"})

    def removed(path: Path) -> bool:
        return not path.exists() and not c.is_registered(path)

    def kept(path: Path) -> bool:
        return path.exists() and c.is_registered(path)

    def remove(*args: str, cwd: Path | None = None, **kw) -> Result:
        return wt("remove", "--no-fetch", *args, cwd=cwd or c.main, **kw)

    p = c.add_wt("feat/by-branch")
    r = remove("-f", "feat/by-branch")
    check("remove -f by branch removes the worktree and keeps the branch",
          r.code == 0 and removed(p) and c.has_branch("feat/by-branch"), r.desc())
    p = c.add_wt("feat/by-folder")
    r = remove("-f", p.name)
    check("remove -f by folder name", r.code == 0 and removed(p), r.desc())
    p = c.add_wt("feat/by-slash")
    r = remove("-f", f"{p}/")
    check("remove -f by absolute path with a trailing slash", r.code == 0 and removed(p),
          r.desc())
    p = c.add_wt("feat/by-relative")
    r = remove("-f", os.path.relpath(p, c.main))
    check("remove -f by relative path", r.code == 0 and removed(p), r.desc())
    p = c.add_wt("feat/by-subdir")
    r = remove("-f", str(p / "src"))
    check("remove -f by a subdirectory of the worktree", r.code == 0 and removed(p), r.desc())

    p = c.add_wt("feat/inside")
    c.commit(p, "inside.txt", "inside\n")
    ff_merge(c, "feat/inside")
    r = remove("-f", "-d", ".", cwd=p)
    check("remove -f -d . from inside the worktree removes it and its merged branch",
          r.code == 0 and removed(p) and not c.has_branch("feat/inside"), r.desc())

    for target, cwd, how in ((str(c.main), c.main, "path"), (".", c.main / "src", "."),
                             ("main", c.main, "branch")):
        r = remove("-f", "-d", target, cwd=cwd)
        check(f"remove of the main checkout by {how} exits 1 and removes nothing",
              r.code == 1 and (c.main / "README.md").exists() and c.has_branch("main"),
              r.desc())

    p = c.add_wt("feat/picked")
    r = remove("-f", env={"FZF_PICK": p.name})
    check("remove with no target removes the fzf pick", r.code == 0 and removed(p), r.desc())
    p = c.add_wt("feat/unpicked")
    FZF_INPUT.unlink(missing_ok=True)
    r = remove("-f")
    check("a cancelled pick exits 1 with No worktree selected and removes nothing",
          r.code == 1 and "No worktree selected" in r.all and kept(p), r.desc())
    check("the pick offers linked worktrees only",
          FZF_INPUT.exists() and p.name in FZF_INPUT.read_text()
          and str(c.main) + "\t" not in FZF_INPUT.read_text()
          and not any(line.rstrip().endswith(str(c.main))
                      for line in FZF_INPUT.read_text().splitlines()),
          FZF_INPUT.read_text() if FZF_INPUT.exists() else "fzf not called")
    remove("-f", p.name)

    r = remove("-f", "feat/no-such-branch")
    check("remove of an unknown target exits 1 with an Error: line",
          r.code == 1 and error_line(r.err), r.desc())

    # Work at risk.
    p = c.add_wt("feat/modified")
    write(p / "README.md", "edited\n")
    r = remove("-f", "feat/modified")
    check("a modified tracked file blocks remove -f with exit 1",
          r.code == 1 and kept(p) and (p / "README.md").read_text() == "edited\n", r.desc())
    check("and says what would be lost", "README.md" in r.all, r.desc())
    p = c.add_wt("feat/untracked")
    write(p / "notes.txt", "mine\n")
    r = remove("-f", "feat/untracked")
    check("an untracked file blocks remove -f with exit 1",
          r.code == 1 and kept(p) and "notes.txt" in r.all, r.desc())
    p = c.add_wt("feat/merged-dirty")
    c.commit(p, "md.txt", "md\n")
    ff_merge(c, "feat/merged-dirty")
    write(p / "later.txt", "work after the merge\n")
    r = remove("-f", "-d", "feat/merged-dirty")
    check("a merged branch with uncommitted work is still refused",
          r.code == 1 and kept(p) and c.has_branch("feat/merged-dirty"), r.desc())
    p = c.add_wt("feat/ignored")
    write(p / "ignored.txt", "build output\n")
    r = remove("-f", "feat/ignored")
    check("an ignored file is not at risk", r.code == 0 and removed(p), r.desc())
    p = c.add_wt("feat/unpushed")
    tip = c.commit(p, "unpushed.txt", "never pushed\n")
    r = remove("-f", "feat/unpushed")
    check("unpushed commits on a branch are not at risk and the branch is kept",
          r.code == 0 and removed(p) and c.tip("feat/unpushed") == tip, r.desc())
    p = c.add_detached(c.wts / "app-orphan")
    c.commit(p, "orphan.txt", "on no branch\n")
    r = remove("-f", p.name)
    check("a detached worktree with commits on no branch is refused",
          r.code == 1 and kept(p), r.desc())
    r = remove("-f", "--discard", p.name)
    check("--discard removes it", r.code == 0 and removed(p), r.desc())
    p = c.add_detached(c.wts / "app-clean-detached")
    r = remove("-f", p.name)
    check("a clean detached worktree at a branch commit is removed",
          r.code == 0 and removed(p), r.desc())
    p = c.add_wt("feat/discard")
    write(p / "README.md", "edited\n")
    write(p / "notes.txt", "mine\n")
    r = remove("-f", "--discard", "feat/discard")
    check("--discard removes a worktree with changes", r.code == 0 and removed(p), r.desc())

    # The prompt.
    p = c.add_wt("feat/prompt")
    for answer, label in (("n\n", "n"), ("\n", "an empty answer"), ("", "end of input"),
                          ("sure\n", "sure")):
        r = remove("feat/prompt", stdin=answer)
        check(f"answering {label} at the prompt aborts with exit 1",
              r.code == 1 and kept(p) and (label == "end of input" or "Aborted." in r.all),
              r.desc())
    r = remove("feat/prompt", stdin="y\n")
    check("answering y removes it", r.code == 0 and removed(p), r.desc())
    p = c.add_wt("feat/prompt-yes")
    r = remove("feat/prompt-yes", stdin="yes\n")
    check("answering yes removes it", r.code == 0 and removed(p), r.desc())

    p = c.add_wt("feat/locked")
    git(c.main, "worktree", "lock", str(p))
    r = remove("-f", "feat/locked")
    check("a locked worktree exits 1 and is not removed", r.code == 1 and kept(p), r.desc())

    p = c.add_wt("feat/gone")
    shutil.rmtree(p)
    r = remove("-f", "feat/gone")
    check("a worktree whose folder is gone gets its registration pruned, exit 0",
          r.code == 0 and not c.is_registered(p), r.desc())

    p = c.add_wt("feat/unmerged")
    c.commit(p, "um.txt", "um\n")
    r = remove("-f", "-d", "feat/unmerged")
    check("-d on an unmerged branch removes the worktree, keeps the branch and says so",
          r.code == 0 and removed(p) and c.has_branch("feat/unmerged")
          and re.search(r"kept|keep|not merged|unmerged", r.all, re.IGNORECASE) is not None,
          r.desc())

    p = c.add_wt("feat/squashed")
    c.commit(p, "sq1.txt", "1\n")
    c.commit(p, "sq2.txt", "2\n")
    squash_merge(c, "feat/squashed")
    refused = "feat/squashed" not in git(c.main, "branch", "--merged", "main")
    r = remove("-f", "-d", "feat/squashed")
    check("-d deletes a squash-merged branch that git branch -d would refuse",
          refused and r.code == 0 and removed(p) and not c.has_branch("feat/squashed"),
          r.desc())

    # tmux.
    kill_tmux()
    p = c.add_wt("feat/tmux")
    new_session(p.name, p)
    attach_client(p.name)
    r = remove("-f", "feat/tmux")
    check("remove closes the worktree's tmux session",
          r.code == 0 and removed(p) and wait_until(lambda: p.name not in sessions()),
          r.desc() + f" sessions={sorted(sessions())}")
    check("an attached client is moved to the main checkout's session first",
          wait_until(lambda: client_sessions() == ["app"])
          and session_path("app") == str(c.main),
          f"clients={client_sessions()} sessions={sorted(sessions())}")
    q = c.add_wt("feat/tmux-detached")
    new_session(q.name, q)
    r = remove("-f", "feat/tmux-detached")
    check("a session with no client is closed too",
          r.code == 0 and wait_until(lambda: q.name not in sessions())
          and "app" in sessions(), r.desc() + f" sessions={sorted(sessions())}")
    kill_tmux()


@section
def prune_command():
    c = Case("prune", files={".gitignore": "cache/\n"})

    def merged_wt(branch: str, squash: bool = False) -> Path:
        p = c.add_wt(branch)
        c.commit(p, f"{p.name}-1.txt", "1\n")
        if squash:
            c.commit(p, f"{p.name}-2.txt", "2\n")
            squash_merge(c, branch)
        else:
            ff_merge(c, branch)
        return p

    ffm = merged_wt("feat/ff")
    sq = merged_wt("feat/squash", squash=True)
    fresh = c.add_wt("feat/fresh")
    active = c.add_wt("feat/active")
    c.commit(active, "active.txt", "active\n")
    missing = c.add_wt("feat/missing")
    shutil.rmtree(missing)
    locked = merged_wt("feat/locked")
    git(c.main, "worktree", "lock", str(locked))
    dirty = merged_wt("feat/dirty")
    write(dirty / "notes.txt", "not committed\n")
    branches = git(c.main, "branch", "--format=%(refname:short)")

    r = wt("prune", "--dry-run", "--no-fetch", cwd=c.main)
    check("prune --dry-run lists the merged worktrees",
          r.code == 0 and ffm.name in r.out and sq.name in r.out, r.desc())
    check("and changes nothing",
          all(p.exists() for p in (ffm, sq, fresh, active, locked, dirty))
          and c.is_registered(missing)
          and git(c.main, "branch", "--format=%(refname:short)") == branches, r.desc())
    check("and does not offer unmerged worktrees",
          fresh.name not in r.out and active.name not in r.out, r.desc())

    r = wt("prune", "--no-fetch", cwd=c.main, stdin="n\n")
    check("declining the prompt exits 1 and removes nothing",
          r.code == 1 and ffm.exists() and sq.exists() and c.is_registered(missing), r.desc())

    kill_tmux()
    new_session(ffm.name, ffm)
    new_session(fresh.name, fresh)
    r = wt("prune", "-d", "--no-fetch", cwd=c.main, stdin="y\n")
    check("one yes removes every merged worktree",
          not ffm.exists() and not sq.exists()
          and not c.is_registered(ffm) and not c.is_registered(sq), r.desc())
    check("-d deletes their branches, squash-merged included",
          not c.has_branch("feat/ff") and not c.has_branch("feat/squash"), r.desc())
    check("unmerged worktrees stay",
          fresh.exists() and active.exists() and c.has_branch("feat/active"), r.desc())
    check("registrations whose folder is gone are pruned", not c.is_registered(missing),
          r.desc())
    check("a merged but locked worktree is skipped and reported",
          locked.exists() and c.has_branch("feat/locked") and locked.name in r.all, r.desc())
    check("a merged worktree with uncommitted work is skipped and reported",
          (dirty / "notes.txt").exists() and c.has_branch("feat/dirty")
          and dirty.name in r.all, r.desc())
    check("prune closes the removed worktrees' tmux sessions only",
          wait_until(lambda: ffm.name not in sessions()) and fresh.name in sessions(),
          f"sessions={sorted(sessions())}")
    kill_tmux()

    git_ok(c.main, "worktree", "unlock", str(locked))
    (dirty / "notes.txt").unlink(missing_ok=True)
    r = wt("prune", "-f", "--no-fetch", cwd=c.main)
    check("-f removes without asking", r.code == 0 and not locked.exists()
          and not dirty.exists(), r.desc())
    r = wt("prune", "-f", "--no-fetch", cwd=c.main)
    check("nothing to prune exits 0", r.code == 0 and fresh.exists(), r.desc())

    # The main checkout on a merged branch.
    m = Case("prune-primary")
    git(m.main, "checkout", "-q", "-b", "feat/primary")
    m.commit(m.main, "primary.txt", "primary\n")
    git(m.main, "push", "-q", "origin", "feat/primary:main")
    git(m.main, "fetch", "-q", "origin")
    other = m.add_wt("feat/other", base="origin/main")
    r = wt("prune", "--dry-run", "--no-fetch", cwd=m.main)
    check("prune never lists the main checkout, even on a merged branch",
          r.code == 0 and "feat/primary" not in r.all, r.desc())
    r = wt("prune", "-f", "-d", "--no-fetch", cwd=other)
    check("and never removes it",
          (m.main / "README.md").exists() and m.has_branch("feat/primary"), r.desc())

    # One removal failing does not stop the others.
    f = Case("prune-failing", files={".gitignore": "cache/\n"})
    stuck = f.add_wt("feat/a-stuck")
    f.commit(stuck, "a.txt", "a\n")
    free = f.add_wt("feat/b-free")
    f.commit(free, "b.txt", "b\n")
    git(f.main, "merge", "-q", "--no-ff", "-m", "merge both", "feat/a-stuck", "feat/b-free")
    f.push_main()
    write(stuck / "cache" / "blob", "cached\n")
    (stuck / "cache").chmod(0o555)
    try:
        r = wt("prune", "-f", "--no-fetch", cwd=f.main)
    finally:
        (stuck / "cache").chmod(0o755)
    check("when one removal fails the others still run and the exit is 1",
          r.code == 1 and not free.exists() and not f.is_registered(free), r.desc())

    # fetch.
    g = Case("prune-fetch")
    b = g.add_wt("feat/remote")
    g.commit(b, "r.txt", "r\n")
    git(b, "push", "-q", "origin", "feat/remote")
    clone = g.root / "clone"
    git(g.root, "clone", "-q", str(g.origin), str(clone))
    git(clone, "merge", "-q", "--no-ff", "-m", "merge elsewhere", "origin/feat/remote")
    git(clone, "push", "-q", "origin", "main")
    r = wt("prune", "-f", "--no-fetch", cwd=g.main)
    check("prune --no-fetch does not see a merge pushed elsewhere", b.exists(), r.desc())
    r = wt("prune", "-f", cwd=g.main)
    check("prune fetches first and removes it", r.code == 0 and not b.exists(), r.desc())


@section
def bootstrap_link():
    for name, pattern in (("slash", "data/"), ("bare", "data")):
        c = Case(f"bootstrap-{name}",
                 files={".gitignore": "data/\n", ".worktreelink": f"{pattern}\n"})
        write(c.main / "data" / "big.csv", "rows\n")
        p = c.add_wt("feat/x")
        r = wt("bootstrap", cwd=p)
        linked = (p / "data").is_symlink()
        status = git(p, "status", "--porcelain", "--untracked-files=all")
        check(f"a path linked through .worktreelink ({pattern}) leaves git status empty",
              r.code == 0 and linked and status == "", r.desc() + f" status=[{status}]")
        git(p, "add", "-A")
        staged = git(p, "diff", "--cached", "--name-only")
        check(f"and git add -A cannot stage it ({pattern})", linked and staged == "",
              f"staged=[{staged}]")


@section
def claude_hook():
    c = Case("hook", files={"src/code.txt": "code\n"})

    def hook(name: str, cwd: Path) -> Result:
        return wt("claude-hook", cwd=cwd, stdin=json.dumps(
            {"session_id": "abc", "hook_event_name": "WorktreeCreate",
             "name": name, "cwd": str(cwd)}))

    path = c.folder("feat/auth")
    r = hook("feat/auth", c.main / "src")
    check("the hook creates the worktree like add and prints only its path",
          r.code == 0 and r.out == f"{path}\n" and c.is_registered(path)
          and git(path, "symbolic-ref", "--short", "HEAD") == "feat/auth", r.desc())
    r = hook("feat/auth", c.main)
    check("asking again prints the same path", r.code == 0 and r.out == f"{path}\n", r.desc())

    c.add_wt("feat/a-b")
    r = hook("feat/a_b", c.main)
    check("a name whose folder belongs to another branch fails with no path",
          r.code != 0 and r.out == "" and not c.has_branch("feat/a_b"), r.desc())

    src = SCRATCH / "hook-submodule-src"
    src.mkdir()
    git(src, "init", "-q", "-b", "main")
    git(src, "commit", "-q", "--allow-empty", "-m", "sub")
    s = Case("hook-submodule")
    git(s.main, "submodule", "add", "-q", str(src), "sub")
    git(s.main, "commit", "-qm", "add sub")
    # git keeps a submodule's branches and worktree records in
    # .git/modules/<name>, so those land there whatever the tool does. The
    # audit bug was the checkout itself landing there.
    modules = s.main / ".git" / "modules"
    r = hook("feat/sub", s.main / "sub")
    printed = Path(r.out.strip()) if r.out.strip() else None
    check("the hook in a submodule checkout puts the worktree in the submodule, "
          "not under .git/modules",
          r.code == 0 and printed is not None
          and printed.is_relative_to(s.main / "sub" / ".claude" / "worktrees")
          and not printed.resolve().is_relative_to(modules.resolve())
          and git(printed, "rev-parse", "--show-toplevel") == str(printed),
          r.desc())


