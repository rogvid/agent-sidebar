# --- running things --------------------------------------------------------------


@dataclass
class Result:
    code: int
    out: str
    err: str

    @property
    def all(self) -> str:
        return self.out + self.err

    def desc(self) -> str:
        def short(s: str) -> str:
            s = strip_ansi(s).strip().replace("\n", " | ")
            return s if len(s) <= 300 else s[:150] + " ... " + s[-150:]

        return f"exit={self.code} out=[{short(self.out)}] err=[{short(self.err)}]"


ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def strip_ansi(s: str) -> str:
    return ANSI.sub("", s)


def env_with(extra: dict[str, str | None] | None) -> dict[str, str]:
    env = dict(ENV)
    for k, v in (extra or {}).items():
        if v is None:
            env.pop(k, None)
        else:
            env[k] = v
    return env


def run(
    cmd: list[str],
    cwd: Path,
    stdin: str = "",
    env: dict[str, str | None] | None = None,
    timeout: float = 60,
) -> Result:
    try:
        p = subprocess.run(
            cmd,
            cwd=cwd,
            input=stdin,
            capture_output=True,
            text=True,
            env=env_with(env),
            timeout=timeout,
        )
    except FileNotFoundError as e:
        return Result(127, "", f"not found: {e}")
    except subprocess.TimeoutExpired as e:
        def text(b):
            return b.decode(errors="replace") if isinstance(b, bytes) else (b or "")

        return Result(124, text(e.stdout), text(e.stderr) + " [timed out]")
    return Result(p.returncode, strip_ansi(p.stdout), strip_ansi(p.stderr))


def command(cmd: str, *args: str) -> list[str]:
    if VIA_WRAPPERS and cmd in WRAPPERS:
        return [WRAPPERS[cmd], *args]
    return ["git-wt", cmd, *args]


def wt(cmd: str, *args: str, cwd: Path, **kw) -> Result:
    """git-wt <cmd> ARGS, run from cwd."""
    return run(command(cmd, *args), cwd, **kw)


class HarnessError(Exception):
    pass


def git(cwd: Path, *args: str, env=None, check: bool = True) -> str:
    p = subprocess.run(
        ["git", *args], cwd=cwd, capture_output=True, text=True, env=env_with(env)
    )
    if check and p.returncode != 0:
        raise HarnessError(f"git {' '.join(args)} in {cwd}: {p.stderr.strip()}")
    return p.stdout.strip()


def git_ok(cwd: Path, *args: str) -> bool:
    return (
        subprocess.run(
            ["git", *args], cwd=cwd, capture_output=True, env=env_with(None)
        ).returncode
        == 0
    )


# --- checks ------------------------------------------------------------------------

TOTAL = 0
FAILED: list[str] = []


def check(name: str, ok: bool, detail: str = "") -> bool:
    global TOTAL
    TOTAL += 1
    if ok:
        print(f"ok    {name}", flush=True)
    else:
        FAILED.append(name)
        print(f"FAIL  {name}  {detail}".rstrip(), flush=True)
    return ok


def wait_until(fn, timeout: float = 5.0) -> bool:
    end = time.monotonic() + timeout
    while True:
        if fn():
            return True
        if time.monotonic() > end:
            return False
        time.sleep(0.05)


# --- repos -------------------------------------------------------------------------


def slug_folder(repo: str, branch: str) -> str:
    """Folder name for plain ASCII branch names (the Unicode rule has its own check)."""
    return f"{repo}-" + re.sub(r"[^a-z0-9]+", "-", branch.lower()).strip("-")


class Case:
    """<scratch>/<name>/projects/<repo> with a bare origin, main pushed."""

    def __init__(
        self,
        name: str,
        repo: str = "app",
        *,
        files: dict[str, str] | None = None,
        remote: bool = True,
        branch: str = "main",
        parent: str = "projects",
    ):
        self.root = SCRATCH / name
        if self.root.exists():
            raise HarnessError(f"case {name} used twice")
        self.repo = repo
        self.main = self.root / parent / repo
        self.origin = self.root / "origin.git"
        self.wts = self.root / "worktrees"
        self.branch = branch
        self.main.mkdir(parents=True)
        git(self.main, "init", "-q", "-b", branch)
        for rel, content in ({"README.md": "hello\n"} | (files or {})).items():
            write(self.main / rel, content)
        git(self.main, "add", "-A")
        git(self.main, "commit", "-qm", "init")
        if remote:
            git(self.root, "init", "-q", "--bare", "-b", branch, str(self.origin))
            git(self.main, "remote", "add", "origin", str(self.origin))
            git(self.main, "push", "-q", "-u", "origin", branch)
            git(self.main, "remote", "set-head", "origin", "-a")

    def folder(self, branch: str) -> Path:
        return self.wts / slug_folder(self.repo, branch)

    def add_wt(
        self, branch: str, *, base: str | None = None, path: Path | None = None
    ) -> Path:
        """A linked worktree on a new branch, made with plain git."""
        path = path or self.folder(branch)
        git(self.main, "worktree", "add", "-q", "-b", branch, str(path), base or self.branch)
        return path

    def add_detached(self, path: Path, rev: str | None = None) -> Path:
        git(self.main, "worktree", "add", "-q", "--detach", str(path), rev or self.branch)
        return path

    def commit(self, where: Path, rel: str, content: str, msg: str | None = None) -> str:
        write(where / rel, content)
        git(where, "add", "--", rel)
        git(where, "commit", "-qm", msg or f"change {rel}")
        return git(where, "rev-parse", "HEAD")

    def push_main(self) -> None:
        git(self.main, "push", "-q", "origin", f"HEAD:refs/heads/{self.branch}")
        git(self.main, "fetch", "-q", "origin")

    def tip(self, ref: str) -> str:
        return git(self.main, "rev-parse", "--verify", "-q", f"{ref}^{{commit}}", check=False)

    def has_branch(self, name: str) -> bool:
        return git_ok(self.main, "show-ref", "--verify", "--quiet", f"refs/heads/{name}")

    def registered(self) -> list[Path]:
        out = git(self.main, "worktree", "list", "--porcelain")
        return [Path(line[9:]) for line in out.splitlines() if line.startswith("worktree ")]

    def is_registered(self, path: Path) -> bool:
        return path in self.registered()

    def list(self, *args: str, cwd: Path | None = None, **kw) -> Result:
        return wt("list", "--no-fetch", *args, cwd=cwd or self.main, **kw)


def row(out: str, folder: str) -> str | None:
    """The list line naming a worktree folder."""
    pattern = re.compile(rf"(?<![\w.-]){re.escape(folder)}(?![\w.-])")
    for line in strip_ansi(out).splitlines():
        if pattern.search(line):
            return line
    return None


def merged_in_list(case: Case, path: Path, **kw) -> tuple[bool, str]:
    r = case.list(**kw)
    line = row(r.out, path.name)
    return (r.code == 0 and line is not None and "[MERGED]" in line), r.desc()


def not_merged_in_list(case: Case, path: Path, **kw) -> tuple[bool, str]:
    r = case.list(**kw)
    line = row(r.out, path.name)
    return (r.code == 0 and line is not None and "[MERGED]" not in line), r.desc()


def set_prs(prs: list[dict] | None) -> None:
    if prs is None:
        GH_PRS.unlink(missing_ok=True)
    else:
        GH_PRS.write_text(json.dumps(prs))


def paths_under(root: Path) -> set[str]:
    if not root.exists():
        return set()
    return {str(p.relative_to(root)) for p in root.rglob("*")}


def dirs_under(root: Path) -> set[str]:
    return {str(p.relative_to(root)) for p in root.rglob("*") if p.is_dir()}


def user_dirs(root: Path) -> set[str]:
    """Directories a user would see, not git's own bookkeeping."""
    return {
        d for d in dirs_under(root)
        if ".git" not in Path(d).parts and not d.startswith(("origin.git", "clone"))
    }


def shell_calls() -> list[str]:
    return SHELL_LOG.read_text().splitlines() if SHELL_LOG.exists() else []


def recording_shell() -> dict[str, str | None]:
    SHELL_LOG.unlink(missing_ok=True)
    return {"SHELL": str(STUBS / "record-shell")}


# --- tmux ------------------------------------------------------------------------------


def tmux(*args: str, host: bool = False, env=None) -> subprocess.CompletedProcess:
    cmd = ["tmux", *(["-L", "host"] if host else []), "-f", "/dev/null", *args]
    return subprocess.run(
        cmd, capture_output=True, text=True, env=env_with(env), stdin=subprocess.DEVNULL
    )


def sessions() -> set[str]:
    p = tmux("list-sessions", "-F", "#{session_name}")
    return set(p.stdout.split()) if p.returncode == 0 else set()


def client_sessions() -> list[str]:
    p = tmux("list-clients", "-F", "#{session_name}")
    return p.stdout.split() if p.returncode == 0 else []


def session_path(name: str) -> str:
    p = tmux("display-message", "-p", "-t", f"={name}:", "#{pane_current_path}")
    return p.stdout.strip()


def new_session(name: str, cwd: Path) -> None:
    p = tmux("new-session", "-d", "-s", name, "-c", str(cwd))
    if p.returncode != 0:
        raise HarnessError(f"tmux new-session {name}: {p.stderr.strip()}")


def attach_client(session: str) -> None:
    """A client attached to session, from a second server with a real pty."""
    inner = f"env -u TMUX TMUX_TMPDIR={shlex.quote(str(TMUX_DIR))} tmux attach -t ={shlex.quote(session)}"
    p = tmux("new-session", "-d", "-s", "client", "-x", "200", "-y", "50", inner, host=True)
    if p.returncode != 0 or not wait_until(lambda: client_sessions() == [session]):
        raise HarnessError(f"could not attach a client to {session}: {p.stderr.strip()}")


def run_in_host_pane(cmd: list[str], cwd: Path, status_file: Path) -> None:
    """Runs cmd in a pty of the second server, outside any tmux session."""
    line = (
        f"cd {shlex.quote(str(cwd))} && env -u TMUX {shlex.join(cmd)};"
        f" echo $? >{shlex.quote(str(status_file))}; sleep 60"
    )
    p = tmux("new-session", "-d", "-s", "runner", "-x", "200", "-y", "50", line, host=True)
    if p.returncode != 0:
        raise HarnessError(f"host pane: {p.stderr.strip()}")


def inside_tmux_env(session: str) -> dict[str, str | None]:
    """TMUX and TMUX_PANE as a shell in session's pane would see them."""
    p = tmux("display-message", "-p", "-t", f"={session}:", "#{socket_path},#{pid},0 #{pane_id}")
    tmux_var, pane = p.stdout.split()
    return {"TMUX": tmux_var, "TMUX_PANE": pane}


def kill_tmux() -> None:
    tmux("kill-server", host=True)
    tmux("kill-server")
    wait_until(lambda: not sessions(), timeout=2)


# --- sections ---------------------------------------------------------------------------

SECTIONS = []


def section(fn):
    SECTIONS.append(fn)
    return fn


COMMANDS = ("add", "list", "switch", "remove", "prune", "bootstrap", "claude-hook")


def usage_on(text: str) -> bool:
    return re.search(r"usage", text, re.IGNORECASE) is not None


def error_line(text: str) -> bool:
    return re.search(r"^Error:", text, re.MULTILINE) is not None


@section
def conventions():
    c = Case("conventions")
    for cmd in COMMANDS:
        for flag in ("-h", "--help"):
            r = wt(cmd, flag, cwd=c.main)
            check(
                f"{cmd} {flag} prints usage on stdout and exits 0",
                r.code == 0 and usage_on(r.out),
                r.desc(),
            )
        r = wt(cmd, "--no-such-option", cwd=c.main)
        check(
            f"{cmd} with an unknown option exits 2 with usage on stderr",
            r.code == 2 and usage_on(r.err),
            r.desc(),
        )

    usage_errors = {
        "add without a branch": ("add",),
        "add with an extra argument": ("add", "one", "two"),
        "add -b without a value": ("add", "-b"),
        "list with an argument": ("list", "extra"),
        "switch with an extra argument": ("switch", "one", "two"),
        "remove with an extra argument": ("remove", "one", "two"),
        "prune with an argument": ("prune", "extra"),
    }
    for name, (cmd, *args) in usage_errors.items():
        r = wt(cmd, *args, cwd=c.main)
        check(f"{name} exits 2 with usage on stderr", r.code == 2 and usage_on(r.err), r.desc())

    if not VIA_WRAPPERS:
        r = run(["git-wt", "--help"], c.main)
        check("git-wt --help prints usage and exits 0", r.code == 0 and usage_on(r.out), r.desc())
        r = run(["git-wt", "no-such-command"], c.main)
        check(
            "git-wt with an unknown command exits 2 with usage on stderr",
            r.code == 2 and usage_on(r.err),
            r.desc(),
        )

    OUTSIDE.mkdir(exist_ok=True)
    for cmd, args in (
        ("add", ("feat/x",)),
        ("list", ()),
        ("switch", ("feat/x",)),
        ("remove", ("-f", "feat/x")),
        ("prune", ("-f",)),
    ):
        r = wt(cmd, *args, cwd=OUTSIDE, env=recording_shell())
        check(
            f"{cmd} outside a repository fails with exit 1 and an Error: line",
            r.code == 1 and error_line(r.err),
            r.desc(),
        )
    check("nothing was created outside a repository", paths_under(OUTSIDE) == set(),
          str(paths_under(OUTSIDE)))

    r = wt("switch", "no-such-worktree", cwd=c.main, env=recording_shell())
    check("a not-found error goes to stderr starting with Error:",
          r.code == 1 and error_line(r.err), r.desc())


@section
def wrappers():
    c = Case("wrappers", files={"src/code.txt": "x\n"})
    one = c.add_wt("feat/one")

    for name in ("git-wt-add", "git-wt-list", "git-wt-switch", "git-wt-switch.sh",
                 "git-wt-remove", "git-wt-prune", "git-wt-bootstrap"):
        r = run([name, "--help"], c.main)
        check(f"{name} --help exits 0 with usage", r.code == 0 and usage_on(r.out), r.desc())
        r = run([name, "--no-such-option"], c.main)
        check(f"{name} with an unknown option exits 2", r.code == 2, r.desc())

    r = run(["git-wt-add", "feat/added"], c.main)
    check("git-wt-add creates a worktree like add",
          r.code == 0 and c.is_registered(c.folder("feat/added")), r.desc())

    via_list = run(["git-wt-list", "--no-fetch"], c.main)
    direct = run(["git-wt", "list", "--no-fetch"], c.main)
    check("git-wt-list prints what list prints",
          via_list.code == 0 and via_list.out == direct.out and row(via_list.out, one.name),
          via_list.desc() + " vs " + direct.desc())

    for name in ("git-wt-switch", "git-wt-switch.sh"):
        r = run([name, "feat/one"], c.main, env=recording_shell())
        check(f"{name} opens a shell in the worktree like switch",
              r.code == 0 and shell_calls() == [str(one)], r.desc() + f" shell={shell_calls()}")

    r = run(["git-wt-prune", "--dry-run", "--no-fetch"], c.main)
    check("git-wt-prune --dry-run runs like prune", r.code == 0 and one.exists(), r.desc())

    r = run(["git-wt-bootstrap", "--index", str(one)], c.main)
    check("git-wt-bootstrap runs like bootstrap", r.code == 0 and r.out.strip().isdigit(), r.desc())

    r = run(["git-wt-remove", "-f", "--no-fetch", "feat/one"], c.main)
    check("git-wt-remove removes like remove",
          r.code == 0 and not one.exists() and not c.is_registered(one), r.desc())

    payload = json.dumps({"name": "feat/hooked", "cwd": str(c.main)})
    r = run(["claude-worktree-create"], c.main, stdin=payload)
    check("claude-worktree-create answers like claude-hook",
          r.code == 0 and r.out == f"{c.folder('feat/hooked')}\n", r.desc())


@section
def folder_names():
    c = Case("names")
    for branch, folder in (
        ("feat/new-config", "app-feat-new-config"),
        ("Feat/Ünï", "app-feat-uni"),
        ("Fix/Some_Thing.v2", "app-fix-some-thing-v2"),
        ("chore/x__y--z_", "app-chore-x-y-z"),
        ("plain", "app-plain"),
    ):
        r = wt("add", branch, cwd=c.main)
        path = c.wts / folder
        check(
            f"branch {branch} gets folder {folder}",
            r.code == 0
            and c.is_registered(path)
            and git(path, "symbolic-ref", "--short", "HEAD", check=False) == branch,
            r.desc(),
        )

    d = Case("dotted", repo="my.app")
    path = d.add_wt("feat/s")
    kill_tmux()
    new_session("home", d.main)
    env = inside_tmux_env("home")
    attach_client("home")
    r = wt("switch", "feat/s", cwd=d.main, env=env)
    expected = path.name.replace(".", "_").replace(":", "_")
    check(
        f"the tmux session for {path.name} is {expected}",
        r.code == 0 and wait_until(lambda: expected in sessions()),
        r.desc() + f" sessions={sorted(sessions())}",
    )
    kill_tmux()


def ff_merge(c: Case, branch: str) -> None:
    git(c.main, "merge", "-q", "--ff-only", branch)
    c.push_main()


def noff_merge(c: Case, branch: str) -> None:
    git(c.main, "merge", "-q", "--no-ff", "-m", f"Merge {branch}", branch)
    c.push_main()


def squash_merge(c: Case, branch: str) -> None:
    git(c.main, "merge", "-q", "--squash", branch)
    git(c.main, "commit", "-qm", f"{branch} (squashed)")
    c.push_main()


LINES = "".join(f"line {i}\n" for i in range(1, 13))


def edit_lines(where: Path, rel: str, changes: dict[int, str], msg: str, c: Case) -> str:
    lines = (where / rel).read_text().splitlines()
    for number, text in changes.items():
        lines[number - 1] = text
    return c.commit(where, rel, "\n".join(lines) + "\n", msg)


@section
def merged():
    c = Case("merged", files={"shared.txt": LINES})

    ff = c.add_wt("feat/ff")
    c.commit(ff, "ff.txt", "ff\n")
    ok, d = not_merged_in_list(c, ff)
    check("an unmerged branch with a commit is not [MERGED]", ok, d)
    ff_merge(c, "feat/ff")
    ok, d = merged_in_list(c, ff)
    check("a fast-forward merged branch is [MERGED]", ok, d)

    noff = c.add_wt("feat/noff")
    c.commit(noff, "noff.txt", "noff\n")
    noff_merge(c, "feat/noff")
    ok, d = merged_in_list(c, noff)
    check("a branch merged with a merge commit is [MERGED]", ok, d)

    fresh = c.add_wt("feat/fresh")
    write(fresh / "wip.txt", "uncommitted work\n")
    early = c.add_wt("feat/early", base="HEAD~2")
    side = c.add_wt("feat/side")
    c.commit(side, "side.txt", "side\n")
    noff_merge(c, "feat/side")
    ok, d = not_merged_in_list(c, fresh)
    check("a branch that never had a commit is not [MERGED] after main gets merges", ok, d)
    ok, d = not_merged_in_list(c, early)
    check("a never-committed branch created at an older main commit is not [MERGED]", ok, d)

    rebased = c.add_wt("feat/rebased")
    c.commit(rebased, "r1.txt", "r1\n")
    c.commit(rebased, "r2.txt", "r2\n")
    c.commit(c.main, "main-only.txt", "moved on\n")
    git(c.main, "cherry-pick", "feat/rebased~1", "feat/rebased")
    c.push_main()
    ok, d = merged_in_list(c, rebased)
    check("a rebase-merged branch (commits cherry-picked onto main) is [MERGED]", ok, d)

    partial = c.add_wt("feat/partial")
    c.commit(partial, "p1.txt", "p1\n")
    c.commit(partial, "p2.txt", "p2\n")
    git(c.main, "cherry-pick", "feat/partial~1")
    c.push_main()
    ok, d = not_merged_in_list(c, partial)
    check("a branch with only some commits cherry-picked is not [MERGED]", ok, d)

    squashed = c.add_wt("feat/squashed")
    c.commit(squashed, "s1.txt", "s1\n")
    c.commit(squashed, "s2.txt", "s2\n")
    squash_merge(c, "feat/squashed")
    ok, d = merged_in_list(c, squashed)
    check("a squash-merged branch is [MERGED]", ok, d)

    # Two commits, so no single commit on main has the same patch, and later
    # edits right around the squashed lines, so merging it again would conflict.
    reworked = c.add_wt("feat/reworked")
    edit_lines(reworked, "shared.txt", {3: "reworked 3"}, "one", c)
    tip = edit_lines(reworked, "shared.txt", {9: "reworked 9"}, "two", c)
    squash_merge(c, "feat/reworked")
    edit_lines(c.main, "shared.txt", {2: "main 2", 4: "main 4", 8: "main 8", 10: "main 10"},
               "touch the lines around", c)
    c.push_main()
    set_prs(None)
    ok, d = not_merged_in_list(c, reworked)
    check("a squash merge later reworked on main is not [MERGED] without a PR", ok, d)
    pr = {"number": 7, "headRefName": "feat/reworked", "headRefOid": tip, "state": "MERGED"}
    set_prs([pr])
    ok, d = merged_in_list(c, reworked)
    check("a squash merge later reworked on main is [MERGED] through its merged PR", ok,
          d + f" gh-calls={GH_CALLS.read_text() if GH_CALLS.exists() else 'none'}")

    other = c.add_wt("feat/other-pr")
    edit_lines(other, "shared.txt", {6: "other 6"}, "one", c)
    set_prs([pr, {"number": 8, "headRefName": "feat/reworked-not", "headRefOid": tip,
                  "state": "MERGED"},
             {"number": 9, "headRefName": "feat/other-pr",
              "headRefOid": c.tip("feat/other-pr"), "state": "OPEN"}])
    ok, d = not_merged_in_list(c, other)
    check("an open PR does not make a branch [MERGED]", ok, d)

    later = c.add_wt("feat/later")
    edit_lines(later, "shared.txt", {5: "later 5"}, "one", c)
    old_tip = edit_lines(later, "shared.txt", {11: "later 11"}, "two", c)
    squash_merge(c, "feat/later")
    edit_lines(c.main, "shared.txt", {12: "main 12"}, "more", c)
    edit_lines(c.main, "shared.txt", {1: "main 1"}, "more", c)
    c.push_main()
    c.commit(later, "after.txt", "work after the merge\n")
    set_prs([pr, {"number": 10, "headRefName": "feat/later", "headRefOid": old_tip,
                  "state": "MERGED"}])
    ok, d = not_merged_in_list(c, later)
    check("a branch with a commit after its PR merged is not [MERGED]", ok, d)

    set_prs(None)
    GH_PRS.write_text("this is not json")
    ok, d = merged_in_list(c, squashed)
    check("gh answering garbage breaks nothing", ok, d)
    set_prs(None)

    # A branch name is a name, never a pattern.
    dotted = c.add_wt("feat/a.b")
    c.commit(dotted, "ab.txt", "ab\n")
    axb = c.add_wt("feat/axb")
    c.commit(axb, "axb.txt", "axb\n")
    ff_merge(c, "feat/axb")
    ok, d = not_merged_in_list(c, dotted)
    check("feat/a.b is not [MERGED] because feat/axb is", ok, d)

    detached = c.add_detached(c.wts / "app-detached", "HEAD~1")
    ok, d = not_merged_in_list(c, detached)
    check("a detached worktree is never [MERGED]", ok, d)

    git(c.main, "checkout", "-q", "-b", "primary-only")
    on_main = c.wts / "app-on-main"
    git(c.main, "worktree", "add", "-q", str(on_main), "main")
    ok, d = not_merged_in_list(c, on_main)
    check("a worktree on the main branch itself is never [MERGED]", ok, d)
    r = wt("prune", "-f", "--no-fetch", cwd=c.main)
    check("and prune leaves it", on_main.exists() and c.is_registered(on_main), r.desc())
    check("prune never removes a never-committed worktree or its uncommitted work",
          (fresh / "wip.txt").exists() and c.has_branch("feat/fresh"), r.desc())


@section
def merged_without_identity():
    c = Case("noid")
    b = c.add_wt("feat/squash")
    c.commit(b, "s1.txt", "s1\n")
    c.commit(b, "s2.txt", "s2\n")
    squash_merge(c, "feat/squash")
    git_config_home(NOID_HOME, identity=False)
    env = {"HOME": str(NOID_HOME), "XDG_CONFIG_HOME": str(NOID_HOME / ".config")}
    precondition = run(["git", "commit-tree", "-m", "x", "HEAD^{tree}"], c.main, env=env)
    ok, d = merged_in_list(c, b, env=env)
    check("with no git identity configured a squash merge is still [MERGED]",
          precondition.code != 0 and ok, d + f" (commit-tree without identity: exit={precondition.code})")
    r = wt("prune", "-f", "-d", "--no-fetch", cwd=c.main, env=env)
    check("and prune -d removes it and its branch with no identity",
          r.code == 0 and not b.exists() and not c.has_branch("feat/squash"), r.desc())


@section
def main_branch_and_target():
    # worktree.mainBranch wins over origin's HEAD.
    c = Case("mainbranch-config")
    git(c.main, "checkout", "-q", "-b", "develop")
    c.commit(c.main, "dev.txt", "dev\n")
    git(c.main, "push", "-q", "origin", "develop")
    git(c.main, "checkout", "-q", "main")
    git(c.main, "config", "worktree.mainBranch", "develop")
    r = wt("add", "feat/x", cwd=c.main)
    check("worktree.mainBranch picks the base of a new branch",
          r.code == 0 and c.tip("feat/x") == c.tip("develop"), r.desc())

    # origin's HEAD branch, not whatever the main checkout has out.
    c = Case("mainbranch-origin-head")
    git(c.main, "checkout", "-q", "-b", "dev")
    c.commit(c.main, "dev.txt", "dev\n")
    git(c.main, "push", "-q", "origin", "dev")
    git(c.origin, "symbolic-ref", "HEAD", "refs/heads/dev")
    git(c.main, "remote", "set-head", "origin", "-a")
    git(c.main, "checkout", "-q", "-b", "feat/elsewhere", "main")
    c.commit(c.main, "elsewhere.txt", "elsewhere\n")
    r = wt("add", "feat/y", cwd=c.main)
    check("origin's HEAD branch is the main branch when not configured",
          r.code == 0 and c.tip("feat/y") == c.tip("dev"), r.desc())

    c = Case("mainbranch-fallback", branch="master", remote=False)
    git(c.main, "checkout", "-q", "-b", "feat/current")
    c.commit(c.main, "current.txt", "current\n")
    r = wt("add", "feat/z", cwd=c.main)
    check("without origin the first of main/master/trunk is the main branch",
          r.code == 0 and c.tip("feat/z") == c.tip("master"), r.desc())
    merged_branch = c.add_wt("feat/done", base="master")
    c.commit(merged_branch, "done.txt", "done\n")
    git(merged_branch, "checkout", "-q", "--detach")
    git(c.main, "checkout", "-q", "master")
    git(c.main, "merge", "-q", "--ff-only", "feat/done")
    git(c.main, "checkout", "-q", "feat/current")
    git(merged_branch, "checkout", "-q", "feat/done")
    ok, d = merged_in_list(c, merged_branch)
    check("without origin the merge target is the local main branch", ok, d)
    r = wt("list", cwd=c.main)
    check("list with no origin to fetch still succeeds", r.code == 0, r.desc())

    # The main checkout on a feature branch changes nothing.
    c = Case("mainbranch-feature-checkout")
    b = c.add_wt("feat/merged")
    c.commit(b, "m.txt", "m\n")
    ff_merge(c, "feat/merged")
    git(c.main, "checkout", "-q", "-b", "feat/primary", "HEAD~1")
    c.commit(c.main, "primary.txt", "primary\n")
    ok, d = merged_in_list(c, b)
    check("with the main checkout on a feature branch, merged still means merged into main",
          ok, d)
    r = c.list()
    check("list names origin/main as the target, not the checked-out branch",
          "origin/main" in r.out and "feat/primary" not in r.out, r.desc())

    # Target is origin/main when it exists.
    c = Case("target")
    b = c.add_wt("feat/local")
    c.commit(b, "l.txt", "l\n")
    git(c.main, "merge", "-q", "--ff-only", "feat/local")
    ok, d = not_merged_in_list(c, b)
    check("merged into local main only is not [MERGED] while origin/main exists", ok, d)
    c.push_main()
    ok, d = merged_in_list(c, b)
    check("once pushed to origin/main it is [MERGED]", ok, d)

    # list fetches first unless --no-fetch.
    c = Case("fetch")
    b = c.add_wt("feat/remote")
    c.commit(b, "r.txt", "r\n")
    git(b, "push", "-q", "origin", "feat/remote")
    clone = c.root / "clone"
    git(c.root, "clone", "-q", str(c.origin), str(clone))
    git(clone, "merge", "-q", "--no-ff", "-m", "merge elsewhere", "origin/feat/remote")
    git(clone, "push", "-q", "origin", "main")
    ok, d = not_merged_in_list(c, b)
    check("list --no-fetch does not see a merge pushed elsewhere", ok, d)
    r = wt("list", cwd=c.main)
    line = row(r.out, b.name)
    check("list fetches origin first and sees it",
          r.code == 0 and line is not None and "[MERGED]" in line, r.desc())
    git(c.main, "remote", "set-url", "origin", str(c.root / "gone.git"))
    r = wt("list", cwd=c.main)
    check("a failing fetch is only a warning", r.code == 0 and row(r.out, b.name) is not None,
          r.desc())


@section
def list_command():
    c = Case("list-empty")
    r = wt("list", cwd=c.main)
    check("list with no linked worktrees says No worktrees found. and exits 0",
          r.code == 0 and "No worktrees found." in r.out, r.desc())
    check("list does not create the worktrees directory", not c.wts.exists(),
          str(user_dirs(c.root)))
    wt("prune", "-f", cwd=c.main)
    wt("switch", "nothing-here", cwd=c.main, env=recording_shell())
    wt("remove", "-f", "nothing-here", cwd=c.main)
    check("prune, switch and remove do not create it either", not c.wts.exists(),
          str(user_dirs(c.root)))

    c = Case("list", files={".gitignore": "ignored.txt\n", "src/code.txt": "code\n"})
    git(c.main, "checkout", "-q", "-b", "primary-only")
    clean = c.add_wt("feat/clean", base="main")
    dirty = c.add_wt("feat/dirty", base="main")
    write(dirty / "README.md", "changed\n")
    write(dirty / "new.txt", "untracked\n")
    write(dirty / "ignored.txt", "ignored\n")
    unpushed = c.add_wt("feat/unpushed", base="main")
    c.commit(unpushed, "u1.txt", "u1\n")
    git(unpushed, "push", "-q", "-u", "origin", "feat/unpushed")
    c.commit(unpushed, "u2.txt", "u2\n")
    locked = c.add_wt("feat/locked", base="main")
    git(c.main, "worktree", "lock", str(locked))
    missing = c.add_wt("feat/missing", base="main")
    shutil.rmtree(missing)
    detached = c.add_detached(c.wts / "app-loose", "main")
    before = user_dirs(c.root)

    r = c.list()
    out = r.out
    check("list exits 0", r.code == 0, r.desc())
    check("the header names the main repository", str(c.main) in out, r.desc())
    check("the header names the main branch and target", "origin/main" in out, r.desc())
    check("the header names the worktrees root", str(c.wts) in out, r.desc())
    check("the main checkout gets no row", "primary-only" not in out, r.desc())

    def flags(path: Path) -> str:
        return row(out, path.name) or ""

    line = flags(clean)
    check("a clean worktree's row shows its branch and folder",
          "feat/clean" in line and clean.name in line, r.desc())
    check("a clean fresh worktree has no flags", "[" not in line.replace(clean.name, ""),
          line)
    check("uncommitted and untracked (not ignored) files show [DIRTY 2]",
          "[DIRTY 2]" in flags(dirty), flags(dirty) or r.desc())
    check("a commit ahead of its upstream shows [UNPUSHED 1]",
          "[UNPUSHED 1]" in flags(unpushed), flags(unpushed) or r.desc())
    check("a locked worktree shows [LOCKED]", "[LOCKED]" in flags(locked),
          flags(locked) or r.desc())
    check("a worktree whose folder is gone shows [MISSING]", "[MISSING]" in flags(missing),
          flags(missing) or r.desc())
    check("a detached worktree shows [DETACHED] and detached",
          "[DETACHED]" in flags(detached) and "detached" in flags(detached).replace(
              "[DETACHED]", ""), flags(detached) or r.desc())
    check("list created no directory", user_dirs(c.root) == before,
          str(user_dirs(c.root) ^ before))

    r = c.list("-v")
    check("list -v exits 0 with the rows", r.code == 0 and row(r.out, clean.name) is not None,
          r.desc())
    for where, name in ((c.main / "src", "the main checkout's subdirectory"),
                        (clean / "src", "a linked worktree's subdirectory")):
        r = c.list(cwd=where)
        check(f"list works from {name}",
              r.code == 0 and row(r.out, dirty.name) is not None and str(c.main) in r.out,
              r.desc())


@section
def add_command():
    c = Case("add", files={"src/code.txt": "code\n"})
    main_tip = c.tip("main")

    r = wt("add", "feat/new", cwd=c.main)
    path = c.folder("feat/new")
    check("add creates the worktree in worktrees/ on a new branch",
          r.code == 0 and c.is_registered(path) and c.tip("feat/new") == main_tip, r.desc())
    check("add prints a '  Path: <path>' line",
          re.search(rf"^  Path: {re.escape(str(path))}$", r.out, re.MULTILINE) is not None,
          r.desc())

    inside = c.add_wt("feat/inside")
    c.commit(inside, "wip.txt", "wip\n")
    r = wt("add", "feat/from-inside", cwd=inside / "src")
    check("add from inside a linked worktree bases the branch on main, not its HEAD",
          r.code == 0 and c.is_registered(c.folder("feat/from-inside"))
          and c.tip("feat/from-inside") == main_tip, r.desc())

    existing = c.add_wt("feat/existing")
    before, dirs_before = c.registered(), user_dirs(c.root)
    r = wt("add", "feat/existing", cwd=c.main)
    check("add for a branch that already has a worktree prints its path and exits 0",
          r.code == 0 and str(existing) in r.out and c.registered() == before
          and user_dirs(c.root) == dirs_before, r.desc())

    stale = c.add_wt("feat/stale")
    shutil.rmtree(stale)
    r = wt("add", "feat/stale", cwd=c.main)
    check("add for a worktree whose folder was deleted creates it again",
          r.code == 0 and (stale / "README.md").exists()
          and c.registered().count(stale) == 1, r.desc())

    r = wt("add", "bad..name", cwd=c.main)
    check("an invalid branch name exits 1 and creates nothing",
          r.code == 1 and not c.has_branch("bad..name") and not (c.wts / "app-bad-name").exists(),
          r.desc())

    c.add_wt("feat/a-b")
    r = wt("add", "feat/a_b", cwd=c.main)
    check("a folder registered to a different branch exits 1 with no new branch",
          r.code == 1 and not c.has_branch("feat/a_b"), r.desc())
    c.add_detached(c.folder("feat/d"))
    r = wt("add", "feat/d", cwd=c.main)
    check("a folder registered to a detached HEAD exits 1 with no new branch",
          r.code == 1 and not c.has_branch("feat/d"), r.desc())
    write(c.folder("feat/e") / "keep.txt", "mine\n")
    r = wt("add", "feat/e", cwd=c.main)
    check("a folder that exists but is not a worktree exits 1 with no branch",
          r.code == 1 and not c.has_branch("feat/e")
