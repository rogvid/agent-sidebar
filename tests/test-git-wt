          and git(c.main, "rev-parse", "--abbrev-ref", "feat/remote@{upstream}", check=False)
          == "origin/feat/remote", r.desc())

    git(c.main, "branch", "feat/local", "HEAD")
    c.commit(c.main, "main2.txt", "main moves on\n")
    c.push_main()
    local_tip = c.tip("feat/local")
    r = wt("add", "-b", "main", "feat/local", cwd=c.main)
    check("an existing local branch is checked out as it is, -b ignored with a warning",
          r.code == 0 and c.is_registered(c.folder("feat/local"))
          and git(c.folder("feat/local"), "rev-parse", "HEAD") == local_tip
          and re.search(r"ignor", r.all, re.IGNORECASE) is not None, r.desc())

    git(c.main, "tag", "v1", main_tip)
    r = wt("add", "v1", cwd=c.main)
    check("a tag name is not an existing branch: a new branch from main is made",
          r.code == 0 and c.has_branch("v1") and c.tip("refs/heads/v1") == c.tip("main"),
          r.desc())

    git(c.main, "branch", "base-branch", main_tip)
    r = wt("add", "-b", "base-branch", "feat/based", cwd=c.main)
