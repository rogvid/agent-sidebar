    clone = c.root / "clone"
    git(c.root, "clone", "-q", str(c.origin), str(clone))
    git(clone, "checkout", "-q", "-b", "feat/remote")
    remote_tip = c.commit(clone, "remote.txt", "remote\n")
    git(clone, "push", "-q", "origin", "feat/remote")
    git(c.main, "fetch", "-q", "origin")
    r = wt("add", "origin/feat/remote", cwd=c.main)
    check("origin/<x> exits 1 suggesting <x> and creates nothing",
          r.code == 1 and re.search(r"(?<!origin/)feat/remote", r.all) is not None
          and not c.has_branch("origin/feat/remote")
          and not c.folder("origin/feat/remote").exists(), r.desc())
    r = wt("add", "feat/remote", cwd=c.main)
    remote_path = c.folder("feat/remote")
    check("a branch only on origin becomes a local branch tracking origin/<branch>",
