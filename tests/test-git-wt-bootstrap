#!/usr/bin/env bash
# End-to-end checks for git-wt-bootstrap, git-wt-add and the Claude Code
# WorktreeCreate hook, on throwaway repos laid out the way the scripts expect:
# <root>/projects/<repo> with worktrees landing in <root>/worktrees/.
#
# direnv and mise are stand-ins on PATH that log how they were called, so the
# checks can tell "called only when relevant" apart from "not installed".
#
# Run: scripts/tests/test-git-wt-bootstrap     (or `mise run test`)

set -euo pipefail

# As a pre-commit hook this runs with git's GIT_INDEX_FILE and friends set,
# which would point every throwaway repo at this repo's index.
while IFS= read -r name; do
    unset "${name}"
done < <(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p')

repo="$(cd "$(dirname "$0")/../.." && pwd)"
readonly repo
scratch="$(mktemp -d)"
readonly scratch
trap 'rm -rf "${scratch}"' EXIT

export HOME="${scratch}/home"
export GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
mkdir -p "${HOME}"
git config --global init.defaultBranch main

readonly stubs="${scratch}/stubs"
readonly calls="${scratch}/calls"
mkdir -p "${stubs}"
export PATH="${stubs}:${repo}/scripts/.local/bin:${PATH}"

failures=0
total=0

check() {
    local name="$1"
    shift
    total=$((total + 1))
    if "$@" 2>/dev/null; then
        printf 'ok    %s\n' "${name}"
    else
        printf 'FAIL  %s\n' "${name}"
        failures=$((failures + 1))
    fi
}

not() { ! "$@"; }
quiet() { "$@" >/dev/null; }
same() { [[ "$1" == "$2" ]]; }
has_file() { [[ -f "$1" && ! -L "$1" ]]; }
content_is() { [[ -f "$1" && "$(cat "$1")" == "$2" ]]; }

# A fresh main checkout under <root>/projects/<name>, with one commit that
# tracks whatever is passed as "path=content" pairs.
make_repo() {
    local main="${scratch}/$1/projects/$2"
    shift 2
    mkdir -p "${main}"
    git -C "${main}" init -q
    local pair
    for pair in "$@"; do
        mkdir -p "$(dirname "${main}/${pair%%=*}")"
        printf '%s\n' "${pair#*=}" >"${main}/${pair%%=*}"
    done
    git -C "${main}" add -A
    git -C "${main}" commit -qm init --allow-empty
    printf '%s\n' "${main}"
}

# Writes a file under a checkout, creating parent directories.
put() {
    mkdir -p "$(dirname "$1/$2")"
    printf '%s\n' "$3" >"$1/$2"
}

# --- .worktreeinclude ---------------------------------------------------------

main="$(make_repo copy app \
    ".gitignore=$(printf '.env\n.env.*\n.claude/settings.local.json\nnot-included.txt\nlisted-untracked.txt\nvendor/\ncache/\n')" \
    ".worktreeinclude=$(printf '# local files\n  .env  \n.env.*\ntracked.txt\n**/.claude/settings.local.json\nvendor/**/config.json\nuntracked.txt\n**/settings.json\n')" \
    "tracked.txt=from git")"
put "${main}" .env "SECRET=1"
put "${main}" .env.local "LOCAL=1"
put "${main}" tracked.txt "changed in main"
put "${main}" untracked.txt "untracked but not ignored"
put "${main}" not-included.txt "ignored but not listed"
put "${main}" .claude/settings.local.json '{"local": true}'
put "${main}" vendor/lib/config.json '{"vendor": true}'
put "${main}" vendor/lib/other.json '{}'
put "${main}" cache/deep/settings.json '{}'
git -C "${main}" worktree add -q -b one "${scratch}/copy/worktrees/app-one"
wt="${scratch}/copy/worktrees/app-one"
put "${wt}" .env.local "WORKTREE=1"
git-wt-bootstrap "${wt}" >"${scratch}/out" 2>&1 || cat "${scratch}/out"

check "a gitignored file listed in .worktreeinclude is copied" \
    content_is "${wt}/.env" "SECRET=1"
check "a tracked file is left as git checked it out" \
    content_is "${wt}/tracked.txt" "from git"
check "an untracked file that is not gitignored is not copied" \
    not has_file "${wt}/untracked.txt"
check "a gitignored file not listed is not copied" \
    not has_file "${wt}/not-included.txt"
check "nested paths keep their directories" \
    content_is "${wt}/.claude/settings.local.json" '{"local": true}'
check "a pattern naming an ignored directory reaches inside it" \
    content_is "${wt}/vendor/lib/config.json" '{"vendor": true}'
check "and copies only what matches there" \
    not has_file "${wt}/vendor/lib/other.json"
check "a **/ pattern does not reach into an ignored directory it does not name" \
    not has_file "${wt}/cache/deep/settings.json"
check "a file already in the worktree is never overwritten" \
    content_is "${wt}/.env.local" "WORKTREE=1"

put "${wt}" .env "EDITED=1"
check "re-running succeeds" quiet git-wt-bootstrap "${wt}"
check "and keeps edits made in the worktree" content_is "${wt}/.env" "EDITED=1"

# --- .worktreelink ------------------------------------------------------------

main="$(make_repo link app \
    ".gitignore=$(printf 'data/\n.env\nmodels/\n')" \
    ".worktreelink=$(printf 'data/\nmodels/\n')" \
    ".worktreeinclude=$(printf '.env\ndata/\n')")"
put "${main}" data/big.csv "rows"
put "${main}" .env "SECRET=1"
put "${main}" models/weights.bin "weights"
wt="${scratch}/link/worktrees/app-one"
git -C "${main}" worktree add -q -b one "${wt}"
put "${wt}" models/mine.bin "already here"
git-wt-bootstrap "${wt}" >"${scratch}/link-out" 2>&1 || true

is_link_to() { [[ -L "$1" && "$(readlink "$1")" == "$2" ]]; }
check "a gitignored directory in .worktreelink is symlinked to the main checkout" \
    is_link_to "${wt}/data" "${main}/data"
check "writes through the link land in the main checkout" \
    bash -c "echo new >'${wt}/data/new.csv' && [[ -f '${main}/data/new.csv' ]]"
check "a linked path is not also copied" not grep -q 'Copied: data/' "${scratch}/link-out"
check ".worktreeinclude still applies next to it" content_is "${wt}/.env" "SECRET=1"
check "an existing path is never replaced by a link" \
    content_is "${wt}/models/mine.bin" "already here"
check "re-running with links in place succeeds" quiet git-wt-bootstrap "${wt}"
check "and leaves the link as it was" is_link_to "${wt}/data" "${main}/data"

# --- WORKTREE_INDEX -----------------------------------------------------------

main="$(make_repo index app)"
wts="${scratch}/index/worktrees"
for name in a b c; do
    git -C "${main}" worktree add -q -b "${name}" "${wts}/app-${name}"
done
index_of() { git-wt-bootstrap --index "$1"; }

check "the main checkout is index 0" same "$(index_of "${main}")" 0
quiet git-wt-bootstrap "${wts}/app-a"
quiet git-wt-bootstrap "${wts}/app-b"
check "the first worktree gets index 1" same "$(index_of "${wts}/app-a")" 1
check "the next one gets index 2" same "$(index_of "${wts}/app-b")" 2
quiet git-wt-bootstrap "${wts}/app-a"
check "re-running keeps a worktree's index" same "$(index_of "${wts}/app-a")" 1
git -C "${main}" worktree remove "${wts}/app-a"
quiet git-wt-bootstrap "${wts}/app-c"
check "a removed worktree's index is reused" same "$(index_of "${wts}/app-c")" 1
check "without disturbing the others" same "$(index_of "${wts}/app-b")" 2

# --- direnv, mise and the worktree:setup task ---------------------------------

cat >"${stubs}/direnv" <<EOF
#!/usr/bin/env bash
echo "direnv \$*" >>"${calls}"
EOF
# Claims a worktree:setup task only where the checkout's mise.toml defines one.
cat >"${stubs}/mise" <<EOF
#!/usr/bin/env bash
echo "mise \$* | index=\${WORKTREE_INDEX-unset} main=\${WORKTREE_MAIN-unset} pwd=\${PWD}" >>"${calls}"
if [[ "\$1 \$2" == "tasks info" ]]; then
    grep -qF '"worktree:setup"' mise.toml 2>/dev/null
fi
EOF
chmod +x "${stubs}/direnv" "${stubs}/mise"
called() { grep -qxF "$1" "${calls}"; }
called_like() { grep -q "$1" "${calls}"; }

main="$(make_repo tools app \
    ".gitignore=.envrc" \
    ".worktreeinclude=.envrc" \
    "mise.toml=$(printf '[tasks."worktree:setup"]\nrun = "true"\n')")"
put "${main}" .envrc "use mise"
wt="${scratch}/tools/worktrees/app-one"
git -C "${main}" worktree add -q -b one "${wt}"
: >"${calls}"
quiet git-wt-bootstrap "${wt}"

check "direnv allows the worktree's .envrc" called "direnv allow ${wt}"
check "mise trusts the worktree's config" called_like "^mise trust ${wt}/mise.toml "
check "the worktree:setup task runs in the worktree" \
    called "mise run worktree:setup | index=1 main=${main} pwd=${wt}"

main="$(make_repo plain app)"
wt="${scratch}/plain/worktrees/app-one"
git -C "${main}" worktree add -q -b one "${wt}"
: >"${calls}"
quiet git-wt-bootstrap "${wt}"
check "without .envrc direnv is not called" not called_like "^direnv"
check "without a mise config mise is not called" not called_like "^mise"

main="$(make_repo notask app "mise.toml=$(printf '[tools]\n')")"
wt="${scratch}/notask/worktrees/app-one"
git -C "${main}" worktree add -q -b one "${wt}"
: >"${calls}"
quiet git-wt-bootstrap "${wt}"
check "a mise config is still trusted without the task" called_like "^mise trust "
check "and no task is run" not called_like "^mise run"

main="$(make_repo failing app \
    "mise.toml=$(printf '[tasks."worktree:setup"]\nrun = "false"\n')")"
wt="${scratch}/failing/worktrees/app-one"
git -C "${main}" worktree add -q -b one "${wt}"
cat >"${stubs}/mise" <<'EOF'
#!/usr/bin/env bash
[[ "$1" != run ]]
EOF
check "a failing setup task fails the bootstrap" not quiet git-wt-bootstrap "${wt}"

# Only the tools the script really needs, so direnv and mise are missing.
bare="${scratch}/bare-bin"
mkdir -p "${bare}"
for tool in bash git realpath sed sort cp ln mkdir mktemp rm rmdir cat dirname basename sleep; do
    ln -s "$(command -v "${tool}")" "${bare}/${tool}"
done
main="$(make_repo nomise app ".gitignore=.envrc" ".worktreeinclude=.envrc" "mise.toml=")"
put "${main}" .envrc "use mise"
wt="${scratch}/nomise/worktrees/app-one"
git -C "${main}" worktree add -q -b one "${wt}"
check "without direnv or mise installed it still succeeds" \
    quiet env PATH="${bare}" "${repo}/scripts/.local/bin/git-wt-bootstrap" "${wt}"

# --- git-wt-add ---------------------------------------------------------------

main="$(make_repo wtadd app ".gitignore=.env" ".worktreeinclude=.env")"
put "${main}" .env "SECRET=1"
wt="${scratch}/wtadd/worktrees/app-feat-x"
(cd "${main}" && git-wt-add feat/x) >"${scratch}/wtadd-out" 2>&1 || true
check "git-wt-add bootstraps the worktree it creates" content_is "${wt}/.env" "SECRET=1"
rm -f "${wt}/.env"
(cd "${main}" && git-wt-add feat/x) >"${scratch}/wtadd-out" 2>&1 || true
check "git-wt-add does not bootstrap a worktree it only found" not has_file "${wt}/.env"

# --- Claude Code WorktreeCreate hook ------------------------------------------

# The input Claude Code sends: the common fields plus the worktree name.
hook_input() {
    printf '{"session_id":"abc123","transcript_path":"/tmp/t.jsonl","cwd":"%s","hook_event_name":"WorktreeCreate","name":"%s"}' "$1" "$2"
}
# Claude Code reads the last non-empty stdout line as the worktree path.
hook() {
    hook_input "$1" "$2" | claude-worktree-create >"${scratch}/hook-out" 2>"${scratch}/hook-err"
}
hook_path() { grep -v '^[[:space:]]*$' "${scratch}/hook-out" | tail -1; }
only_the_path() { same "$(cat "${scratch}/hook-out")" "$1"; }
branch_of() { git -C "$1" rev-parse --abbrev-ref HEAD; }

main="$(make_repo claude app ".gitignore=.env" ".worktreeinclude=.env" "src/main.txt=code")"
put "${main}" .env "SECRET=1"
wt="${scratch}/claude/worktrees/app-feat-auth"
check "the hook succeeds from a subdirectory of the checkout" hook "${main}/src" feat/auth
check "it prints the git-wt-add worktree path" same "$(hook_path)" "${wt}"
check "and nothing else on stdout" only_the_path "${wt}"
check "the worktree is on a branch named after it" same "$(branch_of "${wt}")" feat/auth
check "and bootstrapped" content_is "${wt}/.env" "SECRET=1"
check "asking for the same name again succeeds" hook "${main}" feat/auth
check "and prints the same path" only_the_path "${wt}"

# Subagent worktrees come through the same hook, from repos anywhere.
main="${scratch}/elsewhere/app"
mkdir -p "$(dirname "${main}")"
make_repo elsewhere-tmp app ".gitignore=$(printf '.env\n.claude/worktrees/\n')" ".worktreeinclude=.env" >/dev/null
mv "${scratch}/elsewhere-tmp/projects/app" "${main}"
put "${main}" .env "SECRET=1"
wt="${main}/.claude/worktrees/bold-oak-a3f2"
check "outside a projects/ folder the hook still succeeds" hook "${main}" bold-oak-a3f2
check "it uses Claude Code's own location" only_the_path "${wt}"
check "and branch name" same "$(branch_of "${wt}")" worktree-bold-oak-a3f2
check "and bootstraps that worktree too" content_is "${wt}/.env" "SECRET=1"

check "input without a name fails the hook" \
    not bash -c "echo '{\"cwd\":\"${main}\"}' | claude-worktree-create >/dev/null 2>&1"
check "a cwd outside any git repo fails the hook" not hook "${scratch}" nope

printf '\n%s/%s passed\n' "$((total - failures))" "${total}"
((failures == 0))
